---
interface Props {
  title: string;
  description: string;
  buttonText: string;
  href?: string;
}
const { title, description, buttonText, href = '#' } = Astro.props;
---

<a
  href={href}
  class="block rounded-xl border border-slate-700 bg-slate-800/50 p-6 text-left transition hover:border-emerald-400/50 hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-emerald-400 focus:ring-offset-2 focus:ring-offset-slate-900"
>
  <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-slate-700/80">
    <slot name="icon" />
  </div>
  <h2 class="font-heading text-lg font-semibold text-white md:text-xl">
    {title}
  </h2>
  <p class="mt-2 text-sm text-slate-400">
    {description}
  </p>
  <span class="mt-4 inline-block text-sm font-medium text-emerald-400">
    {buttonText} →
  </span>
</a>
