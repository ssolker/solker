---
interface Props {
  title: string;
  description: string;
  buttonText: string;
  href?: string;
}
const { title, description, buttonText, href = '#' } = Astro.props;
---

<a
  href={href}
  class="block rounded-xl border border-taupe/30 bg-sage p-6 text-left transition hover:border-taupe-light/50 hover:bg-sage-light focus:outline-none focus:ring-2 focus:ring-orange focus:ring-offset-2 focus:ring-offset-forest"
>
  <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-sage-dark">
    <slot name="icon" />
  </div>
  <h2 class="font-heading text-lg font-semibold text-white md:text-xl">
    {title}
  </h2>
  <p class="mt-2 text-md text-taupe">
    {description}
  </p>
  <span class="mt-4 inline-block text-md font-medium text-orange hover:text-orange-light">
    {buttonText} →
  </span>
</a>
