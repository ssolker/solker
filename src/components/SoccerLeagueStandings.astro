---
import { getSoccerSeasonsForClient } from '../data/leagueCatalog';
import { getFormsApiUrl, getRecaptchaSiteKeyV3, getRecaptchaSiteKeyV2 } from '../env/publicForms';

const seasonsJson = getSoccerSeasonsForClient();
const formsApiUrl = getFormsApiUrl();
const recaptchaSiteKeyV3 = getRecaptchaSiteKeyV3();
const recaptchaSiteKeyV2 = getRecaptchaSiteKeyV2();
const scoreFeaturesEnabled = !!(formsApiUrl && (recaptchaSiteKeyV3 || recaptchaSiteKeyV2));
---

<section id="standings-and-schedule" class="bg-forest-light/40 px-4 py-12 md:py-16" aria-labelledby="standings-heading">
  <div class="mx-auto max-w-5xl">
    <h2 id="standings-heading" class="font-heading text-center text-2xl font-bold text-white md:text-3xl">
      Standings & Schedule
    </h2>
    <!-- <p class="mt-2 text-center text-md text-taupe">
      Select an active or previous league. Schedule and standings use data from the league catalog (local for now). To update scores without redeploying, host JSON and fetch at runtime — see comment in
      <code class="rounded bg-forest-dark px-1 text-xs">src/data/leagueCatalog.ts</code>.
    </p> -->

    <div id="soccer-league-root" class="mt-8 min-h-[12rem] text-left"></div>
    {
      scoreFeaturesEnabled && (
        <div
          id="soccer-score-modal-overlay"
          class="fixed inset-0 z-[70] hidden items-center justify-center bg-black/70 p-4"
          role="dialog"
          aria-modal="true"
          aria-labelledby="soccer-score-modal-title"
        >
          <div
            id="soccer-score-modal-panel"
            class="relative max-h-[90vh] w-full max-w-lg overflow-y-auto rounded-xl border border-taupe/30 bg-forest-dark p-5 text-white shadow-xl"
          >
            <div
              id="soccer-score-modal-submit-mask"
              class="absolute inset-0 z-10 hidden flex flex-col items-center justify-center gap-3 rounded-xl bg-forest-dark/95 p-6 text-center"
              aria-live="polite"
              aria-hidden="true"
            >
              <span
                class="inline-block h-8 w-8 shrink-0 animate-spin rounded-full border-2 border-taupe/40 border-t-orange"
                aria-hidden="true"
              ></span>
              <p class="text-sm text-white">Submitting…</p>
            </div>
            <div class="flex items-start justify-between gap-2">
              <h3 id="soccer-score-modal-title" class="font-heading text-lg font-bold">
                Submit score
              </h3>
              <button
                type="button"
                id="soccer-score-modal-close"
                class="rounded border border-taupe/40 px-2 py-1 text-sm text-taupe hover:bg-forest-light/30"
              >
                Close
              </button>
            </div>
            <p id="soccer-score-modal-status" class="mt-2 text-sm text-taupe"></p>
            <div id="soccer-score-modal-loading" class="mt-4 hidden text-sm text-taupe">
              Loading…
            </div>
            <div id="soccer-score-modal-error" class="mt-2 hidden text-sm text-red-400"></div>
            <form id="soccer-score-modal-form" class="mt-4 hidden space-y-3">
              <input type="hidden" id="soccer-score-modal-game-id" value="" />
              <div>
                <label class="mb-1 block text-sm text-taupe" for="soccer-score-modal-team">Your team</label>
                <select
                  id="soccer-score-modal-team"
                  class="w-full rounded-lg border border-taupe/30 bg-forest-dark px-3 py-2 text-white"
                ></select>
              </div>
              <div>
                <label class="mb-1 block text-sm text-taupe" for="soccer-score-modal-email">Your email</label>
                <input
                  type="email"
                  id="soccer-score-modal-email"
                  maxlength="254"
                  required
                  class="w-full rounded-lg border border-taupe/30 bg-forest-dark px-3 py-2 text-white"
                />
              </div>
              <div class="grid grid-cols-2 gap-2">
                <div>
                  <label class="mb-1 block text-sm text-taupe" for="soccer-score-modal-hs">Home goals</label>
                  <input
                    type="number"
                    id="soccer-score-modal-hs"
                    min="0"
                    max="99"
                    required
                    class="w-full rounded-lg border border-taupe/30 bg-forest-dark px-3 py-2 text-white"
                  />
                </div>
                <div>
                  <label class="mb-1 block text-sm text-taupe" for="soccer-score-modal-as">Away goals</label>
                  <input
                    type="number"
                    id="soccer-score-modal-as"
                    min="0"
                    max="99"
                    required
                    class="w-full rounded-lg border border-taupe/30 bg-forest-dark px-3 py-2 text-white"
                  />
                </div>
              </div>
              <div>
                <label class="mb-1 block text-sm text-taupe" for="soccer-score-modal-spirit">
                  Spirit for opponent (1–5)
                </label>
                <select
                  id="soccer-score-modal-spirit"
                  required
                  class="w-full rounded-lg border border-taupe/30 bg-forest-dark px-3 py-2 text-white"
                >
                  <option value="">—</option>
                  <option value="1">1</option>
                  <option value="2">2</option>
                  <option value="3">3</option>
                  <option value="4">4</option>
                  <option value="5">5</option>
                </select>
              </div>
              <div>
                <label class="mb-1 block text-sm text-taupe" for="soccer-score-modal-notes">Notes (optional)</label>
                <textarea
                  id="soccer-score-modal-notes"
                  maxlength="500"
                  rows="2"
                  class="w-full resize-y rounded-lg border border-taupe/30 bg-forest-dark px-3 py-2 text-white"
                ></textarea>
              </div>
              <div
                id="soccer-score-recaptcha-v2-wrap"
                class="hidden flex justify-center"
                aria-hidden="true"
              ></div>
              <div id="soccer-score-modal-form-msg" class="min-h-[1.25rem] text-sm text-taupe"></div>
              <button
                type="submit"
                id="soccer-score-modal-submit"
                class="w-full rounded-lg bg-orange px-4 py-2 font-semibold text-white hover:bg-orange-dark disabled:opacity-60"
              >
                Submit
              </button>
            </form>
          </div>
        </div>
        <div
          id="soccer-score-success-overlay"
          class="fixed inset-0 z-[80] hidden items-center justify-center bg-black/70 p-4"
          role="dialog"
          aria-modal="true"
          aria-labelledby="soccer-score-success-title"
        >
          <div class="w-full max-w-lg rounded-xl border border-taupe/30 bg-forest-dark p-6 text-white shadow-xl">
            <h3 id="soccer-score-success-title" class="font-heading text-lg font-bold text-green-400">
              Score saved
            </h3>
            <p class="mt-4 text-md leading-relaxed text-taupe">
              Your score was saved and the schedule is refreshing automatically. If it does not update in a few seconds, use <strong class="text-white">Refresh Scores</strong> on <strong class="text-white">Schedule</strong>.
            </p>
            <button
              type="button"
              id="soccer-score-success-dismiss"
              class="mt-6 w-full rounded-lg bg-orange px-4 py-2 font-semibold text-white hover:bg-orange-dark"
            >
              OK
            </button>
          </div>
        </div>
      )}
  </div>
</section>

<script define:vars={{ seasonsJson, formsApiUrl, recaptchaSiteKeyV3, recaptchaSiteKeyV2, scoreFeaturesEnabled }}>
  (function () {
    var seasons = seasonsJson;

    function esc(s) {
      return String(s ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function formatDate(iso) {
      var d = new Date(iso + 'T12:00:00');
      if (Number.isNaN(d.getTime())) return esc(iso);
      return esc(
        d.toLocaleDateString('en-CA', { month: 'long', day: 'numeric', year: 'numeric' })
      );
    }

    var FIELD_SPONSORS = {
      'Field G': 'Rotary Club of Woodstock',
      'Field H': 'Picards Peanuts',
      'Field J': 'The Comfort Guy',
      'Field K': 'Ted & Lucy VanWyk'
    };

    /** Field label including its sponsor name, e.g. "Field J — The Comfort Guy". */
    function fieldDisplay(fieldName) {
      var sponsor = FIELD_SPONSORS[fieldName];
      return esc(fieldName) + (sponsor ? ' — ' + esc(sponsor) : '');
    }

    function getSeason(key) {
      for (var i = 0; i < seasons.length; i++) {
        if (seasons[i].seasonKey === key) return seasons[i];
      }
      return null;
    }

    function getFixtureFromSeasonById(gameId) {
      var season = state.seasonKey ? getSeason(state.seasonKey) : null;
      if (!season || !gameId) return null;
      for (var i = 0; i < season.fixtures.length; i++) {
        if (season.fixtures[i].id === gameId) return season.fixtures[i];
      }
      return null;
    }

    function pad2(n) {
      return (n < 10 ? '0' : '') + n;
    }

    function todayYmdLocal() {
      var d = new Date();
      return d.getFullYear() + '-' + pad2(d.getMonth() + 1) + '-' + pad2(d.getDate());
    }

    function sortedUniqueFixtureDates(season) {
      var set = {};
      if (!season || !season.fixtures) return [];
      season.fixtures.forEach(function (fx) {
        if (fx.date) set[fx.date] = true;
      });
      return Object.keys(set).sort();
    }

    /** Earliest fixture date on or after local today; if none left, last scheduled date. */
    function computeDefaultNextGameDayYmd(season) {
      var sorted = sortedUniqueFixtureDates(season);
      if (!sorted.length) return '';
      var today = todayYmdLocal();
      for (var i = 0; i < sorted.length; i++) {
        if (sorted[i] >= today) return sorted[i];
      }
      return sorted[sorted.length - 1];
    }

    function fixtureVisibleForScheduleFilter(fx, anchorYmd) {
      if (state.scheduleScope === 'all') return true;
      if (!anchorYmd) return true;
      if (state.scheduleScope === 'next') return fx.date === anchorYmd;
      if (state.scheduleScope === 'future') return fx.date >= anchorYmd;
      return true;
    }

    function numOrNaN(v) {
      return typeof v === 'number' && !Number.isNaN(v);
    }

    /** Standings from catalog fixtures only (homeGoals / awayGoals / spirit* on each fixture). */
    function computeStandings(season) {
      var teamNames = season.teams.map(function (t) {
        return t.teamName;
      });
      var stats = {};
      teamNames.forEach(function (t) {
        stats[t] = { w: 0, l: 0, tie: 0, gf: 0, ga: 0, spiritSum: 0, spiritN: 0 };
      });
      season.fixtures.forEach(function (fx) {
        if (fx.countsForStandings === false) return;
        if (!stats[fx.homeTeam] || !stats[fx.awayTeam]) return;
        var hg = fx.homeGoals;
        var ag = fx.awayGoals;
        var hgn = numOrNaN(hg);
        var agn = numOrNaN(ag);
        if (!hgn || !agn) return;
        stats[fx.homeTeam].gf += hg;
        stats[fx.homeTeam].ga += ag;
        stats[fx.awayTeam].gf += ag;
        stats[fx.awayTeam].ga += hg;
        if (hg > ag) {
          stats[fx.homeTeam].w += 1;
          stats[fx.awayTeam].l += 1;
        } else if (ag > hg) {
          stats[fx.awayTeam].w += 1;
          stats[fx.homeTeam].l += 1;
        } else {
          stats[fx.homeTeam].tie += 1;
          stats[fx.awayTeam].tie += 1;
        }
        var sh = fx.spiritHome;
        var sa = fx.spiritAway;
        if (numOrNaN(sh)) {
          stats[fx.homeTeam].spiritSum += sh;
          stats[fx.homeTeam].spiritN += 1;
        }
        if (numOrNaN(sa)) {
          stats[fx.awayTeam].spiritSum += sa;
          stats[fx.awayTeam].spiritN += 1;
        }
      });

      var rows = teamNames.map(function (name) {
        var s = stats[name];
        var pts = s.w * 3 + s.tie * 1;
        var gd = s.gf - s.ga;
        var spiritAvg = s.spiritN === 0 ? 0 : s.spiritSum / s.spiritN;
        return {
          teamName: name,
          wins: s.w,
          losses: s.l,
          ties: s.tie,
          goalsFor: s.gf,
          goalsAgainst: s.ga,
          points: pts,
          gd: gd,
          spiritAvg: spiritAvg
        };
      });

      rows.sort(function (a, b) {
        if (b.points !== a.points) return b.points - a.points;
        if (b.gd !== a.gd) return b.gd - a.gd;
        if (b.goalsFor !== a.goalsFor) return b.goalsFor - a.goalsFor;
        return b.spiritAvg - a.spiritAvg;
      });

      return rows;
    }

    function captainRowHasScoreline(row) {
      return (
        row &&
        row.homeScore != null &&
        row.awayScore != null &&
        !Number.isNaN(Number(row.homeScore)) &&
        !Number.isNaN(Number(row.awayScore))
      );
    }

    /** Provisional scoreline from sheet when game is still pending (one or both captain rows). */
    function pendingScorelineFromCache(c) {
      if (!c || c.gameStatus !== 'pending') return null;
      var h = c.homeCaptainRow;
      var a = c.awayCaptainRow;
      var hok = captainRowHasScoreline(h);
      var aok = captainRowHasScoreline(a);
      if (hok && aok) {
        if (Number(h.homeScore) === Number(a.homeScore) && Number(h.awayScore) === Number(a.awayScore)) {
          return { home: h.homeScore, away: h.awayScore, kind: 'pending' };
        }
        return { mismatch: true };
      }
      if (hok) return { home: h.homeScore, away: h.awayScore, kind: 'partial' };
      if (aok) return { home: a.homeScore, away: a.awayScore, kind: 'partial' };
      return null;
    }

    /** Result column: optional `result` string, else scoreline from goals, else — */
    function resultLine(fx) {
      if (scoreFeaturesEnabled && state.scheduleScoresLoaded) {
        var c = state.gameScoreCache[fx.id];
        if (c && (c.gameStatus === 'reviewing' || c.gameStatus === 'verified')) {
          if (c.scoresAgree && c.agreedHomeScore != null && c.agreedAwayScore != null) {
            return esc(c.agreedHomeScore) + ' – ' + esc(c.agreedAwayScore);
          }
          if (c.gameStatus === 'reviewing' && c.scoresAgree === false) {
            return esc('Under review (mismatch)');
          }
        }
        if (c && c.gameStatus === 'pending') {
          var pen = pendingScorelineFromCache(c);
          if (pen && pen.mismatch) {
            return esc('Mismatched scores (pending)');
          }
          if (pen && pen.home != null && pen.away != null) {
            var line = esc(String(pen.home)) + ' – ' + esc(String(pen.away));
            if (pen.kind === 'partial') {
              return line + ' <span class="text-xs text-taupe">(partial)</span>';
            }
            return line + ' <span class="text-xs text-taupe">(pending)</span>';
          }
        }
      }
      if (fx.result != null && String(fx.result).trim() !== '') return esc(String(fx.result).trim());
      var hg = fx.homeGoals;
      var ag = fx.awayGoals;
      if (numOrNaN(hg) && numOrNaN(ag)) return esc(hg) + ' – ' + esc(ag);
      return '—';
    }

    function gameStatusBadge(fx) {
      var c = state.gameScoreCache[fx.id];
      var gs = c && c.gameStatus ? c.gameStatus : 'pending';
      var cls =
        gs === 'verified'
          ? 'bg-emerald-700/80 text-white'
          : gs === 'reviewing'
            ? 'bg-amber-700/80 text-white'
            : 'bg-forest-light/50 text-taupe';
      return '<span class="inline-block rounded px-2 py-0.5 text-xs font-medium ' + cls + '">' + esc(gs) + '</span>';
    }

    function getScoreV2WidgetId() {
      var wrap = document.getElementById('soccer-score-recaptcha-v2-wrap');
      if (!wrap) return null;
      var raw = wrap.getAttribute('data-rc-widget-id');
      return raw != null && raw !== '' ? parseInt(raw, 10) : null;
    }

    function ensureScoreV2WidgetVisible() {
      var wrap = document.getElementById('soccer-score-recaptcha-v2-wrap');
      if (!wrap || !recaptchaSiteKeyV2 || typeof grecaptcha === 'undefined') return null;
      wrap.classList.remove('hidden');
      wrap.setAttribute('aria-hidden', 'false');
      var existing = getScoreV2WidgetId();
      if (existing !== null && !isNaN(existing)) return existing;
      try {
        var wid = grecaptcha.render(wrap, { sitekey: recaptchaSiteKeyV2, theme: 'dark' });
        wrap.setAttribute('data-rc-widget-id', String(wid));
        return wid;
      } catch (e) {
        return null;
      }
    }

    function resetScoreV2Widget() {
      var wrap = document.getElementById('soccer-score-recaptcha-v2-wrap');
      if (!wrap) return;
      var wid = getScoreV2WidgetId();
      if (wid !== null && !isNaN(wid) && typeof grecaptcha !== 'undefined') {
        try {
          grecaptcha.reset(wid);
        } catch (e) {}
      }
    }

    function fetchScoreApi(action, data, onOk, onErr) {
      if (!formsApiUrl) {
        onErr('Forms API URL is not configured.');
        return;
      }
      function postWithToken(token) {
        fetch(formsApiUrl, {
          method: 'POST',
          body: JSON.stringify({ action: action, data: data, recaptchaToken: token || '' }),
          headers: { 'Content-Type': 'text/plain;charset=utf-8' },
          redirect: 'follow'
        })
          .then(function (res) {
            return res.json();
          })
          .then(function (json) {
            if (json.success) {
              state.scoreV2Mode = false;
              onOk(json);
              return;
            }
            if (json.recaptchaV2Required && recaptchaSiteKeyV2) {
              var w = ensureScoreV2WidgetVisible();
              if (w !== null && !isNaN(w)) {
                state.scoreV2Mode = true;
                onErr(json.error || 'Complete the checkbox below, then try again.');
                return;
              }
            }
            onErr(json.error || 'Request failed.');
          })
          .catch(function (err) {
            onErr(err.message || 'Network error.');
          });
      }

      var useV2Only = !recaptchaSiteKeyV3 && !!recaptchaSiteKeyV2;
      var useV2Path = useV2Only || state.scoreV2Mode;
      if (useV2Path) {
        var v2id = ensureScoreV2WidgetVisible();
        if (v2id === null || isNaN(v2id)) {
          onErr('Spam protection could not load.');
          return;
        }
        var v2token = grecaptcha.getResponse(v2id);
        if (!v2token) {
          onErr('Please complete the verification checkbox, then try again.');
          return;
        }
        postWithToken(v2token);
        return;
      }

      if (!recaptchaSiteKeyV3) {
        onErr('reCAPTCHA is not configured.');
        return;
      }
      if (typeof grecaptcha === 'undefined') {
        onErr('Spam protection could not load. Refresh and try again.');
        return;
      }
      grecaptcha.ready(function () {
        grecaptcha
          .execute(recaptchaSiteKeyV3, { action: action })
          .then(function (token) {
            if (!token) {
              onErr('Spam protection check failed.');
              return;
            }
            postWithToken(token);
          })
          .catch(function () {
            onErr('Spam protection check failed.');
          });
      });
    }

    function setSubmitMaskVisible(show) {
      var m = document.getElementById('soccer-score-modal-submit-mask');
      if (!m) return;
      if (show) {
        m.classList.remove('hidden');
        m.setAttribute('aria-hidden', 'false');
      } else {
        m.classList.add('hidden');
        m.setAttribute('aria-hidden', 'true');
      }
    }

    function setSuccessScoreModalVisible(show) {
      var el = document.getElementById('soccer-score-success-overlay');
      if (!el) return;
      if (show) {
        el.classList.remove('hidden');
        el.classList.add('flex');
      } else {
        el.classList.add('hidden');
        el.classList.remove('flex');
      }
    }

    function setModalVisible(show) {
      var el = document.getElementById('soccer-score-modal-overlay');
      if (!el) return;
      if (show) {
        el.classList.remove('hidden');
        el.classList.add('flex');
      } else {
        state.scoreV2Mode = false;
        setSubmitMaskVisible(false);
        el.classList.add('hidden');
        el.classList.remove('flex');
      }
    }

    function applyScorePayloadToCache(payload) {
      if (!payload || !payload.gameId) return;
      state.gameScoreCache[payload.gameId] = payload;
    }

    function mergeSeasonScoresFromResponse(season, gamesById) {
      state.gameScoreCache = {};
      var raw = gamesById;
      if (typeof raw === 'string') {
        try {
          raw = JSON.parse(raw);
        } catch (e) {
          raw = {};
        }
      }
      var byId = {};
      if (raw && typeof raw === 'object' && !Array.isArray(raw)) {
        for (var key in raw) {
          if (!Object.prototype.hasOwnProperty.call(raw, key)) continue;
          var entry = raw[key];
          if (!entry || typeof entry !== 'object') continue;
          var gid = entry.gameId != null && String(entry.gameId) !== '' ? String(entry.gameId) : String(key);
          byId[gid] = entry;
        }
      }
      if (!season || !season.fixtures) return;
      for (var i = 0; i < season.fixtures.length; i++) {
        var fx = season.fixtures[i];
        var g = byId[fx.id];
        if (g) {
          state.gameScoreCache[fx.id] = g;
        } else {
          state.gameScoreCache[fx.id] = {
            seasonKey: state.seasonKey,
            gameId: fx.id,
            fixture: null,
            homeCaptainRow: null,
            awayCaptainRow: null,
            homeSubmitted: false,
            awaySubmitted: false,
            gameStatus: 'pending',
            scoresAgree: false,
            bothRowsVerified: false,
            agreedHomeScore: null,
            agreedAwayScore: null,
            message: ''
          };
        }
      }
    }

    function loadScoresFromSheet() {
      if (!state.seasonKey || state.scheduleScoresLoading || !scoreFeaturesEnabled) return;
      state.scheduleScoresLoading = true;
      state.scheduleScoresLoadError = '';
      render();
      fetchScoreApi(
        'gamescoreseason',
        { seasonKey: state.seasonKey },
        function (json) {
          state.scheduleScoresLoading = false;
          var season = getSeason(state.seasonKey);
          mergeSeasonScoresFromResponse(season, json.gamesById || {});
          state.scheduleScoresLoaded = true;
          render();
        },
        function (msg) {
          state.scheduleScoresLoading = false;
          state.scheduleScoresLoadError = msg || 'Could not load scores.';
          render();
        }
      );
    }

    function viewOfficialStandings() {
      if (!state.seasonKey || state.officialStandingsPhase === 'loading') return;
      state.officialStandingsPhase = 'loading';
      state.officialStandingsError = '';
      state.officialStandings = null;
      render();
      fetchScoreApi(
        'gamestandings',
        { seasonKey: state.seasonKey },
        function (json) {
          state.officialStandings = { standings: json.standings || [], footnote: json.footnote || '' };
          state.officialStandingsPhase = 'loaded';
          render();
        },
        function (msg) {
          state.officialStandingsPhase = 'idle';
          state.officialStandingsError = msg || 'Could not load standings.';
          render();
        }
      );
    }

    function hideOfficialStandings() {
      state.officialStandingsPhase = 'idle';
      state.officialStandings = null;
      state.officialStandingsError = '';
      render();
    }

    function openScoreModal(gameId) {
      var season = state.seasonKey ? getSeason(state.seasonKey) : null;
      if (!season || !scoreFeaturesEnabled) return;
      var fx = null;
      for (var i = 0; i < season.fixtures.length; i++) {
        if (season.fixtures[i].id === gameId) {
          fx = season.fixtures[i];
          break;
        }
      }
      if (!fx) return;

      setSubmitMaskVisible(false);
      var loading = document.getElementById('soccer-score-modal-loading');
      var form = document.getElementById('soccer-score-modal-form');
      var errEl = document.getElementById('soccer-score-modal-error');
      var statusEl = document.getElementById('soccer-score-modal-status');
      if (loading) loading.classList.remove('hidden');
      if (form) form.classList.add('hidden');
      if (errEl) {
        errEl.classList.add('hidden');
        errEl.textContent = '';
      }
      if (statusEl) statusEl.textContent = '';

      setModalVisible(true);
      if (loading) loading.classList.add('hidden');
      if (errEl) errEl.classList.add('hidden');
      var cached = state.gameScoreCache[gameId] || {};
      if (form) form.classList.remove('hidden');
      fillScoreModalForm(fx, cached);
    }

    function fillScoreModalForm(fx, payload) {
      var gid = document.getElementById('soccer-score-modal-game-id');
      var teamSel = document.getElementById('soccer-score-modal-team');
      var statusEl = document.getElementById('soccer-score-modal-status');
      if (gid) gid.value = fx.id;
      if (statusEl) statusEl.textContent = payload.message || '';

      if (teamSel) {
        teamSel.innerHTML = '';
        var o1 = document.createElement('option');
        o1.value = fx.homeTeam;
        o1.textContent = 'Home: ' + fx.homeTeam;
        teamSel.appendChild(o1);
        var o2 = document.createElement('option');
        o2.value = fx.awayTeam;
        o2.textContent = 'Away: ' + fx.awayTeam;
        teamSel.appendChild(o2);
      }

      syncModalFieldsFromTeam(fx, payload);
      updateScoreModalSubmitDisabled(fx, payload);
    }

    function getCaptainRowForTeam(payload, teamName, fxLocal) {
      var home =
        (payload && payload.fixture && payload.fixture.homeTeam) || (fxLocal && fxLocal.homeTeam);
      var away =
        (payload && payload.fixture && payload.fixture.awayTeam) || (fxLocal && fxLocal.awayTeam);
      if (!payload || !home || !away) return null;
      if (teamName === home) return payload.homeCaptainRow;
      if (teamName === away) return payload.awayCaptainRow;
      return null;
    }

    function syncModalFieldsFromTeam(fx, payload) {
      var teamSel = document.getElementById('soccer-score-modal-team');
      if (!teamSel) return;
      var team = teamSel.value || fx.homeTeam;
      var row = getCaptainRowForTeam(payload, team, fx);
      var email = document.getElementById('soccer-score-modal-email');
      var hs = document.getElementById('soccer-score-modal-hs');
      var as = document.getElementById('soccer-score-modal-as');
      var sp = document.getElementById('soccer-score-modal-spirit');
      var notes = document.getElementById('soccer-score-modal-notes');
      if (email) email.value = row && row.submitterEmail ? row.submitterEmail : '';
      if (hs) hs.value = row && row.homeScore != null ? String(row.homeScore) : '';
      if (as) as.value = row && row.awayScore != null ? String(row.awayScore) : '';
      if (sp) sp.value = '';
      if (notes) notes.value = '';
      updateScoreModalSubmitDisabled(fx, payload);
    }

    function updateScoreModalSubmitDisabled(fx, payload) {
      var btn = document.getElementById('soccer-score-modal-submit');
      if (!btn) return;
      if (!payload) {
        btn.disabled = true;
        return;
      }
      if (payload.gameStatus === 'verified') {
        btn.disabled = true;
        return;
      }
      var teamSel = document.getElementById('soccer-score-modal-team');
      var team = teamSel ? teamSel.value : fx.homeTeam;
      var row = getCaptainRowForTeam(payload, team, fx);
      if (row && row.verified) {
        btn.disabled = true;
        return;
      }
      btn.disabled = false;
    }

    function submitScoreModal(ev) {
      ev.preventDefault();
      var gidEl = document.getElementById('soccer-score-modal-game-id');
      var msgEl = document.getElementById('soccer-score-modal-form-msg');
      if (!gidEl || !state.seasonKey) return;
      var gameId = gidEl.value;
      var teamSel = document.getElementById('soccer-score-modal-team');
      var team = teamSel ? teamSel.value : '';
      var email = document.getElementById('soccer-score-modal-email');
      var hs = document.getElementById('soccer-score-modal-hs');
      var as = document.getElementById('soccer-score-modal-as');
      var sp = document.getElementById('soccer-score-modal-spirit');
      var notes = document.getElementById('soccer-score-modal-notes');
      if (msgEl) {
        msgEl.textContent = '';
        msgEl.classList.remove('text-red-400', 'text-green-500');
      }

      var fxSubmit = getFixtureFromSeasonById(gameId);
      if (!fxSubmit) {
        if (msgEl) {
          msgEl.textContent = 'Could not find this game in the schedule.';
          msgEl.classList.add('text-red-400');
        }
        return;
      }

      var payload = {
        seasonKey: state.seasonKey,
        gameId: gameId,
        submitterTeam: team,
        homeTeam: fxSubmit.homeTeam,
        awayTeam: fxSubmit.awayTeam,
        date: fxSubmit.date,
        startTime: fxSubmit.startTime || '',
        fieldName: fxSubmit.fieldName || '',
        homeScore: hs ? Number(hs.value) : NaN,
        awayScore: as ? Number(as.value) : NaN,
        opponentSpiritScore: sp ? Number(sp.value) : NaN,
        submitterEmail: email ? email.value.trim() : '',
        notes: notes ? notes.value.trim() : ''
      };

      var sub = document.getElementById('soccer-score-modal-submit');
      if (sub) sub.disabled = true;
      setSubmitMaskVisible(true);

      fetchScoreApi(
        'gamescoresubmit',
        payload,
        function () {
          setSubmitMaskVisible(false);
          if (sub) sub.disabled = false;
          resetScoreV2Widget();
          setModalVisible(false);
          setSuccessScoreModalVisible(true);
          loadScoresFromSheet();
        },
        function (err) {
          setSubmitMaskVisible(false);
          if (msgEl) {
            msgEl.textContent = err;
            msgEl.classList.add('text-red-400');
          }
          if (sub) sub.disabled = false;
        }
      );
    }

