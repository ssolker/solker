            parts.push(
              '<button type="button" id="soccer-view-official-standings" class="rounded-lg border border-orange/60 bg-orange/20 px-3 py-1.5 text-sm font-semibold text-white hover:bg-orange/30 disabled:opacity-60"' +
                (state.officialStandingsPhase === 'loading' ? ' disabled' : '') +
                '>Refresh Standings</button>'
            );
            if (state.officialStandingsPhase === 'loading') {
              parts.push(
                '<span class="inline-block h-5 w-5 shrink-0 animate-spin rounded-full border-2 border-taupe/40 border-t-orange" aria-hidden="true"></span>'
              );
            }
          }
        }
        parts.push('</div></div>');

        if (useOfficialStandingsPanel) {
          if (state.officialStandingsError) {
            parts.push('<p class="mb-2 text-sm text-red-400">' + esc(state.officialStandingsError) + '</p>');
          }
          if (state.officialStandingsPhase === 'idle') {
            parts.push(
              '<p class="text-sm text-taupe">Use Refresh Standings to load the official table.</p>'
            );
          } else if (state.officialStandingsPhase === 'loading') {
            parts.push('<p class="text-sm text-taupe">Refreshing standings…</p>');
          } else if (state.officialStandingsPhase === 'loaded' && state.officialStandings) {
            parts.push(
              '<p class="mb-2 text-xs text-taupe">' + esc(state.officialStandings.footnote || '') + '</p>'
            );
            var officialRows = state.officialStandings.standings || [];
            if (!officialRows.length) {
              parts.push('<p class="text-taupe">No verified games yet.</p>');
            } else {
              parts.push(
                '<table class="w-full min-w-[36rem] border-collapse text-left text-md"><thead><tr class="border-b border-taupe/30 text-taupe">'
              );
              parts.push(
                '<th class="py-2 pr-2 font-semibold">#</th><th class="py-2 pr-2 font-semibold">Team</th><th class="py-2 pr-2 font-semibold">PTS</th><th class="py-2 pr-2 font-semibold">W</th><th class="py-2 pr-2 font-semibold">L</th><th class="py-2 pr-2 font-semibold">T</th><th class="py-2 pr-2 font-semibold">GF</th><th class="py-2 font-semibold">GA</th>'
              );
              parts.push('</tr></thead><tbody id="soccer-standings-tbody">');
              officialRows.forEach(function (r, idx) {
                parts.push('<tr class="border-b border-taupe/20 text-white">');
                parts.push('<td class="py-2 pr-2">' + (idx + 1) + '</td>');
                parts.push('<td class="py-2 pr-2 font-semibold">' + esc(r.teamName) + '</td>');
                parts.push('<td class="py-2 pr-2">' + r.points + '</td>');
                parts.push('<td class="py-2 pr-2">' + r.wins + '</td>');
                parts.push('<td class="py-2 pr-2">' + r.losses + '</td>');
                parts.push('<td class="py-2 pr-2">' + r.ties + '</td>');
                parts.push('<td class="py-2 pr-2">' + r.goalsFor + '</td>');
                parts.push('<td class="py-2">' + r.goalsAgainst + '</td>');
                parts.push('</tr>');
              });
              parts.push('</tbody></table>');
            }
          }
        } else {
          parts.push(
            '<p class="mb-2 text-xs text-taupe">Preview from the published schedule. Points: Win = 3, Tie = 1, Loss = 0. Spirit average is a tie-breaker.</p>'
          );
          parts.push(
            '<table class="w-full min-w-[36rem] border-collapse text-left text-md"><thead><tr class="border-b border-taupe/30 text-taupe">'
          );
          parts.push(
            '<th class="py-2 pr-2 font-semibold">#</th><th class="py-2 pr-2 font-semibold">Team</th><th class="py-2 pr-2 font-semibold">PTS</th><th class="py-2 pr-2 font-semibold">W</th><th class="py-2 pr-2 font-semibold">L</th><th class="py-2 pr-2 font-semibold">T</th><th class="py-2 pr-2 font-semibold">GF</th><th class="py-2 font-semibold">GA</th>'
          );
          parts.push('</tr></thead><tbody id="soccer-standings-tbody">');
          catalogStandingsRows.forEach(function (r, idx) {
            parts.push('<tr class="border-b border-taupe/20 text-white">');
            parts.push('<td class="py-2 pr-2">' + (idx + 1) + '</td>');
            parts.push('<td class="py-2 pr-2 font-semibold">' + esc(r.teamName) + '</td>');
            parts.push('<td class="py-2 pr-2">' + r.points + '</td>');
            parts.push('<td class="py-2 pr-2">' + r.wins + '</td>');
            parts.push('<td class="py-2 pr-2">' + r.losses + '</td>');
            parts.push('<td class="py-2 pr-2">' + r.ties + '</td>');
            parts.push('<td class="py-2 pr-2">' + r.goalsFor + '</td>');
            parts.push('<td class="py-2">' + r.goalsAgainst + '</td>');
            parts.push('</tr>');
          });
          parts.push('</tbody></table>');
        }
        parts.push('</div></div>');
      }

      parts.push('</div>');
      root.innerHTML = parts.join('');

      var selA = document.getElementById('soccer-select-active');
      var selP = document.getElementById('soccer-select-previous');
      if (selA)
        selA.addEventListener('change', function () {
          if (selA.value) {
            state.seasonKey = selA.value;
            state.teamFilter = '';
            state.gameScoreCache = {};
            state.scheduleScoresLoaded = false;
            state.scheduleScoresLoading = false;
            state.scheduleScoresLoadError = '';
            state.officialStandings = null;
            state.officialStandingsPhase = 'idle';
            state.officialStandingsError = '';
            state.scheduleScope = 'next';
            if (selP) selP.value = '';
            render();
          }
        });
      if (selP)
        selP.addEventListener('change', function () {
          if (selP.value) {
            state.seasonKey = selP.value;
            state.teamFilter = '';
            state.gameScoreCache = {};
            state.scheduleScoresLoaded = false;
            state.scheduleScoresLoading = false;
            state.scheduleScoresLoadError = '';
            state.officialStandings = null;
            state.officialStandingsPhase = 'idle';
            state.officialStandingsError = '';
            state.scheduleScope = 'next';
            if (selA) selA.value = '';
            render();
          }
        });

      root.querySelectorAll('[data-schedule-mode]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          state.scheduleMode = btn.getAttribute('data-schedule-mode') || 'basic';
          render();
        });
      });

      var tf = document.getElementById('soccer-team-filter');
      if (tf)
        tf.addEventListener('change', function () {
          state.teamFilter = tf.value || '';
          render();
        });

      var schedScope = document.getElementById('soccer-schedule-scope');
      if (schedScope)
        schedScope.addEventListener('change', function () {
          state.scheduleScope = schedScope.value || 'next';
          render();
        });

      root.querySelectorAll('[data-print]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var m = btn.getAttribute('data-print');
          if (m === 'print-soccer-basic') printBlock('print-soccer-basic');
          else if (m === 'print-soccer-full') printBlock('print-soccer-full');
          else if (m === 'print-soccer-map') printBlock('print-soccer-map');
          else if (m === 'print-soccer-standings') printBlock('print-soccer-standings');
        });
      });

      root.querySelectorAll('[data-score-edit]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          if (btn.disabled) return;
          var gid = btn.getAttribute('data-score-edit');
          if (gid) openScoreModal(gid);
        });
      });

      var refreshSheetScores = document.getElementById('soccer-refresh-sheet-scores');
      if (refreshSheetScores) {
        refreshSheetScores.addEventListener('click', function () {
          loadScoresFromSheet();
        });
      }

      var viewOfficialBtn = document.getElementById('soccer-view-official-standings');
      if (viewOfficialBtn) {
        viewOfficialBtn.addEventListener('click', function () {
          viewOfficialStandings();
        });
      }
      var hideOfficialBtn = document.getElementById('soccer-hide-official-standings');
      if (hideOfficialBtn) {
        hideOfficialBtn.addEventListener('click', function () {
          hideOfficialStandings();
        });
      }
    }

    function initScoreFeaturesUi() {
      if (!scoreFeaturesEnabled) return;
      var overlay = document.getElementById('soccer-score-modal-overlay');
      var closeBtn = document.getElementById('soccer-score-modal-close');
      var form = document.getElementById('soccer-score-modal-form');
      if (overlay) {
        overlay.addEventListener('click', function (ev) {
          if (ev.target === overlay) {
            setModalVisible(false);
            resetScoreV2Widget();
          }
        });
        overlay.addEventListener('change', function (ev) {
          var t = ev.target;
          if (!t || t.id !== 'soccer-score-modal-team') return;
          var gidEl = document.getElementById('soccer-score-modal-game-id');
          if (!gidEl || !state.seasonKey) return;
          var fx = getFixtureFromSeasonById(gidEl.value);
          if (!fx) return;
          var payload = state.gameScoreCache[gidEl.value];
          syncModalFieldsFromTeam(fx, payload);
        });
      }
      if (closeBtn) {
        closeBtn.addEventListener('click', function () {
          setModalVisible(false);
          resetScoreV2Widget();
        });
      }
      if (form) form.addEventListener('submit', submitScoreModal);

      var successDismiss = document.getElementById('soccer-score-success-dismiss');
      if (successDismiss) {
        successDismiss.addEventListener('click', function () {
          setSuccessScoreModalVisible(false);
        });
      }
      var successOverlay = document.getElementById('soccer-score-success-overlay');
      if (successOverlay) {
        successOverlay.addEventListener('click', function (ev) {
          if (ev.target === successOverlay) setSuccessScoreModalVisible(false);
        });
      }
    }

    document.addEventListener('DOMContentLoaded', function () {
      initScoreFeaturesUi();
      render();
    });
  })();
</script>

{scoreFeaturesEnabled && recaptchaSiteKeyV3 && (
  <script async defer src={`https://www.google.com/recaptcha/api.js?render=${recaptchaSiteKeyV3}`}></script>
)}
{scoreFeaturesEnabled && recaptchaSiteKeyV2 && !recaptchaSiteKeyV3 && (
  <script is:inline>
    window.solkerScoreFormsV2Onload = function () {};
  </script>
)}
{scoreFeaturesEnabled && recaptchaSiteKeyV2 && !recaptchaSiteKeyV3 && (
  <script async defer src="https://www.google.com/recaptcha/api.js?onload=solkerScoreFormsV2Onload&render=explicit"></script>
)}

<style is:global>
  /**
   * Print only the chosen block: hide everything else with display:none (not visibility),
   * so layout height matches the table and extra blank pages are avoided.
   */
  @media print {
    @page {
      margin: 12mm;
    }

    body.print-soccer-basic,
    body.print-soccer-basic html,
    body.print-soccer-full,
    body.print-soccer-full html,
    body.print-soccer-map,
    body.print-soccer-map html,
    body.print-soccer-standings,
    body.print-soccer-standings html {
      min-height: 0 !important;
      height: auto !important;
      overflow: visible !important;
      background: #fff !important;
      color: #000 !important;
    }

    body.print-soccer-basic > div,
    body.print-soccer-full > div,
    body.print-soccer-map > div,
    body.print-soccer-standings > div {
      min-height: 0 !important;
      height: auto !important;
      padding-top: 0 !important;
    }

    body.print-soccer-basic main,
    body.print-soccer-full main,
    body.print-soccer-map main,
    body.print-soccer-standings main {
      min-height: 0 !important;
      height: auto !important;
    }

    body.print-soccer-basic header,
    body.print-soccer-basic footer,
    body.print-soccer-full header,
    body.print-soccer-full footer,
    body.print-soccer-map header,
    body.print-soccer-map footer,
    body.print-soccer-standings header,
    body.print-soccer-standings footer {
      display: none !important;
    }

    /* Everything in the page shell except the standings & schedule section */
    body.print-soccer-basic > div > main > *:not(#standings-and-schedule),
    body.print-soccer-full > div > main > *:not(#standings-and-schedule),
    body.print-soccer-map > div > main > *:not(#standings-and-schedule),
    body.print-soccer-standings > div > main > *:not(#standings-and-schedule) {
      display: none !important;
    }

    body.print-soccer-basic > div > footer,
    body.print-soccer-full > div > footer,
    body.print-soccer-map > div > footer,
    body.print-soccer-standings > div > footer {
      display: none !important;
    }

    /* Section chrome: hide heading; show only the printable block inside the root */
    body.print-soccer-basic #standings-and-schedule > div > h2,
    body.print-soccer-full #standings-and-schedule > div > h2,
    body.print-soccer-map #standings-and-schedule > div > h2,
    body.print-soccer-standings #standings-and-schedule > div > h2 {
      display: none !important;
    }

    body.print-soccer-basic #standings-and-schedule,
    body.print-soccer-full #standings-and-schedule,
    body.print-soccer-map #standings-and-schedule,
    body.print-soccer-standings #standings-and-schedule {
      padding: 0 !important;
      margin: 0 !important;
      background: transparent !important;
    }

    body.print-soccer-basic #soccer-league-root > div > *:not(#print-soccer-basic),
    body.print-soccer-full #soccer-league-root > div > *:not(#print-soccer-full),
    body.print-soccer-map #soccer-league-root > div > *:not(#print-soccer-map),
    body.print-soccer-standings #soccer-league-root > div > *:not(#print-soccer-standings) {
      display: none !important;
    }

    body.print-soccer-basic #print-soccer-basic,
    body.print-soccer-full #print-soccer-full,
    body.print-soccer-map #print-soccer-map,
    body.print-soccer-standings #print-soccer-standings {
      position: static !important;
      width: 100% !important;
      max-width: none !important;
    }
  }
</style>
