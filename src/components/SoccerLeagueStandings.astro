---
import { getSoccerSeasonsForClient } from '../data/leagueCatalog';

const seasonsJson = getSoccerSeasonsForClient();
---

<section id="standings-and-schedule" class="bg-forest-light/40 px-4 py-12 md:py-16" aria-labelledby="standings-heading">
  <div class="mx-auto max-w-5xl">
    <h2 id="standings-heading" class="font-heading text-center text-2xl font-bold text-white md:text-3xl">
      Standings & Schedule
    </h2>
    <!-- <p class="mt-2 text-center text-md text-taupe">
      Select an active or previous league. Schedule and standings use data from the league catalog (local for now). To update scores without redeploying, host JSON and fetch at runtime — see comment in
      <code class="rounded bg-forest-dark px-1 text-xs">src/data/leagueCatalog.ts</code>.
    </p> -->

    <div id="soccer-league-root" class="mt-8 min-h-[12rem] text-left"></div>
  </div>
</section>

<script define:vars={{ seasonsJson }}>
  (function () {
    var seasons = seasonsJson;

    function esc(s) {
      return String(s ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function formatDate(iso) {
      var d = new Date(iso + 'T12:00:00');
      if (Number.isNaN(d.getTime())) return esc(iso);
      return esc(
        d.toLocaleDateString('en-CA', { month: 'long', day: 'numeric', year: 'numeric' })
      );
    }

    function getSeason(key) {
      for (var i = 0; i < seasons.length; i++) {
        if (seasons[i].seasonKey === key) return seasons[i];
      }
      return null;
    }

    function numOrNaN(v) {
      return typeof v === 'number' && !Number.isNaN(v);
    }

    /** Standings from catalog fixtures only (homeGoals / awayGoals / spirit* on each fixture). */
    function computeStandings(season) {
      var teamNames = season.teams.map(function (t) {
        return t.teamName;
      });
      var stats = {};
      teamNames.forEach(function (t) {
        stats[t] = { w: 0, l: 0, tie: 0, gf: 0, ga: 0, spiritSum: 0, spiritN: 0 };
      });
      season.fixtures.forEach(function (fx) {
        if (fx.countsForStandings === false) return;
        if (!stats[fx.homeTeam] || !stats[fx.awayTeam]) return;
        var hg = fx.homeGoals;
        var ag = fx.awayGoals;
        var hgn = numOrNaN(hg);
        var agn = numOrNaN(ag);
        if (!hgn || !agn) return;
        stats[fx.homeTeam].gf += hg;
        stats[fx.homeTeam].ga += ag;
        stats[fx.awayTeam].gf += ag;
        stats[fx.awayTeam].ga += hg;
        if (hg > ag) {
          stats[fx.homeTeam].w += 1;
          stats[fx.awayTeam].l += 1;
        } else if (ag > hg) {
          stats[fx.awayTeam].w += 1;
          stats[fx.homeTeam].l += 1;
        } else {
          stats[fx.homeTeam].tie += 1;
          stats[fx.awayTeam].tie += 1;
        }
        var sh = fx.spiritHome;
        var sa = fx.spiritAway;
        if (numOrNaN(sh)) {
          stats[fx.homeTeam].spiritSum += sh;
          stats[fx.homeTeam].spiritN += 1;
        }
        if (numOrNaN(sa)) {
          stats[fx.awayTeam].spiritSum += sa;
          stats[fx.awayTeam].spiritN += 1;
        }
      });

      var rows = teamNames.map(function (name) {
        var s = stats[name];
        var pts = s.w * 3 + s.tie * 1;
        var gd = s.gf - s.ga;
        var spiritAvg = s.spiritN === 0 ? 0 : s.spiritSum / s.spiritN;
        return {
          teamName: name,
          wins: s.w,
          losses: s.l,
          ties: s.tie,
          goalsFor: s.gf,
          goalsAgainst: s.ga,
          points: pts,
          gd: gd,
          spiritAvg: spiritAvg
        };
      });

      rows.sort(function (a, b) {
        if (b.points !== a.points) return b.points - a.points;
        if (b.gd !== a.gd) return b.gd - a.gd;
        if (b.goalsFor !== a.goalsFor) return b.goalsFor - a.goalsFor;
        return b.spiritAvg - a.spiritAvg;
      });

      return rows;
    }

    /** Result column: optional `result` string, else scoreline from goals, else — */
    function resultLine(fx) {
      if (fx.result != null && String(fx.result).trim() !== '') return esc(String(fx.result).trim());
      var hg = fx.homeGoals;
      var ag = fx.awayGoals;
      if (numOrNaN(hg) && numOrNaN(ag)) return esc(hg) + ' – ' + esc(ag);
      return '—';
    }

    var state = {
      seasonKey: null,
      scheduleMode: 'basic',
      teamFilter: ''
    };

    function printBlock(mode) {
      document.body.classList.remove(
        'print-soccer-basic',
        'print-soccer-full',
        'print-soccer-standings'
      );
      document.body.classList.add(mode);
      window.addEventListener(
        'afterprint',
        function onAfter() {
          document.body.classList.remove(mode);
          window.removeEventListener('afterprint', onAfter);
        },
        { once: true }
      );
      window.print();
    }

    function render() {
      var root = document.getElementById('soccer-league-root');
      if (!root) return;

      var active = seasons.filter(function (s) {
        return s.isActive;
      });
      var prev = seasons.filter(function (s) {
        return !s.isActive;
      });

      if (!state.seasonKey) {
        state.seasonKey = active.length ? active[0].seasonKey : prev.length ? prev[0].seasonKey : null;
      }

      var season = state.seasonKey ? getSeason(state.seasonKey) : null;
      if (!season) {
        root.innerHTML = '<p class="text-center text-taupe">No league data available.</p>';
        return;
      }

      var standingsRows = computeStandings(season);

      var parts = [];
      parts.push('<div class="space-y-8">');

      parts.push('<div class="no-print flex flex-col gap-4 sm:flex-row sm:flex-wrap sm:items-end">');
      parts.push('<div class="flex flex-col gap-1">');
      parts.push('<label for="soccer-select-active" class="text-lg font-medium text-taupe">Active league</label>');
      parts.push(
        '<select id="soccer-select-active" class="rounded-lg border border-taupe/30 bg-forest-dark px-3 py-2 text-white">'
      );
      parts.push('<option value="">—</option>');
      active.forEach(function (s) {
        parts.push(
          '<option value="' +
            esc(s.seasonKey) +
            '"' +
            (state.seasonKey === s.seasonKey ? ' selected' : '') +
            '>' +
            esc(s.leagueLabel) +
            '</option>'
        );
      });
      parts.push('</select></div>');

      parts.push('<div class="flex flex-col gap-1">');
      // parts.push('<label for="soccer-select-previous" class="text-md font-medium text-taupe">Previous league</label>');
      // parts.push(
      //   '<select id="soccer-select-previous" class="rounded-lg border border-taupe/30 bg-forest-dark px-3 py-2 text-white">'
      // );
      // parts.push('<option value="">—</option>');
      // prev.forEach(function (s) {
      //   parts.push(
      //     '<option value="' +
      //       esc(s.seasonKey) +
      //       '"' +
      //       (state.seasonKey === s.seasonKey ? ' selected' : '') +
      //       '>' +
      //       esc(s.displayLabel) +
      //       '</option>'
      //   );
      // });
      parts.push('</select></div></div>');

      parts.push('<div class="rounded-lg border border-taupe/20 bg-forest-dark/50 p-4 text-md text-taupe">');
      parts.push('<p><strong class="text-white">Location:</strong> ' + esc(season.address) + '</p>');
      parts.push(
        '<p class="mt-1"><strong class="text-white">Game window:</strong> ' +
          esc(season.gameTimeDetail) +
          '</p>'
      );
      parts.push('</div>');

      parts.push('<div class="no-print flex flex-wrap gap-2">');
      parts.push(
        '<button type="button" class="rounded-lg px-3 py-1.5 text-md font-semibold ' +
          (state.scheduleMode === 'basic'
            ? 'bg-orange text-white'
            : 'border border-taupe/30 bg-forest-dark text-white') +
          '" data-schedule-mode="basic">Game Days</button>'
      );
      parts.push(
        '<button type="button" class="rounded-lg px-3 py-1.5 text-md font-semibold ' +
          (state.scheduleMode === 'full'
            ? 'bg-orange text-white'
            : 'border border-taupe/30 bg-forest-dark text-white') +
          '" data-schedule-mode="full">Full schedule</button>'
      );
      parts.push('</div>');

      if (state.scheduleMode === 'basic') {
        parts.push('<div id="print-soccer-basic" class="print-soccer-block">');
        parts.push('<div class="flex justify-end no-print"><button type="button" class="rounded-lg border border-taupe/30 bg-forest-dark px-3 py-1.5 text-md font-semibold text-white" data-print="print-soccer-basic">Print</button></div>');
        parts.push('<div class="mt-2 overflow-x-auto rounded-lg border border-taupe/30 bg-forest-dark/80 p-4">');
        parts.push('<h3 class="font-heading mb-3 text-lg font-bold text-white">The 8-Week Calendar</h3>');
        parts.push('<table class="w-full min-w-[28rem] border-collapse text-left text-md"><thead><tr class="border-b border-taupe/30 text-taupe">');
        parts.push('<th class="py-2 pr-2 font-semibold">Week</th><th class="py-2 pr-2 font-semibold">Date</th><th class="py-2 font-semibold">Status</th>');
        parts.push('</tr></thead><tbody>');
        season.weeklySchedule.forEach(function (row) {
          parts.push('<tr class="border-b border-taupe/20 text-white">');
          parts.push('<td class="py-2 pr-2">' + esc(row.weekLabel) + '</td>');
          parts.push('<td class="py-2 pr-2">' + esc(row.dateLabel) + '</td>');
          parts.push('<td class="py-2">' + esc(row.status) + '</td>');
          parts.push('</tr>');
        });
        parts.push('</tbody></table>');
        parts.push('<p class="mt-3 text-xs text-taupe">Times: ' + esc(season.gameTimeDetail) + '</p>');
        parts.push('</div></div>');
      }

      if (state.scheduleMode === 'full') {
        var teamNames = season.teams.map(function (t) {
          return t.teamName;
        });
        parts.push('<div id="print-soccer-full" class="print-soccer-block">');
        parts.push('<div class="no-print mb-3 flex flex-wrap items-center gap-3">');
        parts.push('<label class="text-md text-taupe" for="soccer-team-filter">Team filter</label>');
        parts.push(
          '<select id="soccer-team-filter" class="rounded-lg border border-taupe/30 bg-forest-dark px-3 py-2 text-md text-white">'
        );
        parts.push('<option value="">All teams</option>');
        teamNames.forEach(function (n) {
          parts.push(
            '<option value="' +
              esc(n) +
              '"' +
              (state.teamFilter === n ? ' selected' : '') +
              '>' +
              esc(n) +
              '</option>'
          );
        });
        parts.push('</select>');
        parts.push(
          '<button type="button" class="rounded-lg border border-taupe/30 bg-forest-dark px-3 py-1.5 text-md font-semibold text-white" data-print="print-soccer-full">Print schedule</button>'
        );
        parts.push('</div>');

        parts.push('<div class="overflow-x-auto rounded-lg border border-taupe/30 bg-forest-dark/80 p-4">');
        parts.push('<h3 class="font-heading mb-3 text-lg font-bold text-white">Full schedule</h3>');
        if (!season.fixtures || !season.fixtures.length) {
          parts.push('<p class="text-taupe">Full schedule not published yet.</p>');
        } else {
          parts.push(
            '<table class="w-full min-w-[48rem] border-collapse text-left text-md"><thead><tr class="border-b border-taupe/30 text-taupe">'
          );
          parts.push(
            '<th class="py-2 pr-2 font-semibold">Date</th><th class="py-2 pr-2 font-semibold">Start</th><th class="py-2 pr-2 font-semibold">Field</th><th class="py-2 pr-2 font-semibold">Matchup</th><th class="py-2 pr-2 font-semibold">Result</th>'
          );
          parts.push('</tr></thead><tbody>');

          season.fixtures.forEach(function (fx) {
            if (
              state.teamFilter &&
              fx.homeTeam !== state.teamFilter &&
              fx.awayTeam !== state.teamFilter
            ) {
              return;
            }
            parts.push('<tr class="border-b border-taupe/20 align-top text-white">');
            parts.push('<td class="py-2 pr-2 whitespace-nowrap">' + formatDate(fx.date) + '</td>');
            parts.push('<td class="py-2 pr-2 whitespace-nowrap">' + esc(fx.startTime || '') + '</td>');
            parts.push('<td class="py-2 pr-2">' + esc(fx.fieldName) + '</td>');
            parts.push(
              '<td class="py-2 pr-2">' +
                esc(fx.homeTeam) +
                ' vs ' +
                esc(fx.awayTeam) +
                '</td>'
            );
            parts.push('<td class="py-2 pr-2">' + resultLine(fx) + '</td>');
            parts.push('</tr>');
          });

          parts.push('</tbody></table>');
        }
        parts.push('</div></div>');
      }

      if (season.standingsMode === 'comingSoon') {
        parts.push('<div id="print-soccer-standings" class="print-soccer-block">');
        parts.push('<div class="flex justify-end no-print"><button type="button" class="rounded-lg border border-taupe/30 bg-forest-dark px-3 py-1.5 text-md font-semibold text-white" data-print="print-soccer-standings">Print</button></div>');
        parts.push(
          '<div class="rounded-lg border border-taupe/30 bg-forest-dark/80 p-6 text-center text-taupe">Standings coming soon.</div></div>'
        );
      } else {
        parts.push('<div id="print-soccer-standings" class="print-soccer-block">');
        parts.push('<div class="flex justify-end no-print"><button type="button" class="rounded-lg border border-taupe/30 bg-forest-dark px-3 py-1.5 text-md font-semibold text-white" data-print="print-soccer-standings">Print standings</button></div>');
        parts.push('<div class="overflow-x-auto rounded-lg border border-taupe/30 bg-forest-dark/80 p-4">');
        parts.push('<h3 class="font-heading mb-3 text-lg font-bold text-white">Standings</h3>');
        parts.push('<p class="mb-3 text-xs text-taupe">Points: Win = 3, Tie = 1, Loss = 0. Spirit average is used as a hidden tie-breaker.</p>');
        parts.push(
          '<table class="w-full min-w-[36rem] border-collapse text-left text-md"><thead><tr class="border-b border-taupe/30 text-taupe">'
        );
        parts.push(
          '<th class="py-2 pr-2 font-semibold">#</th><th class="py-2 pr-2 font-semibold">Team</th><th class="py-2 pr-2 font-semibold">PTS</th><th class="py-2 pr-2 font-semibold">W</th><th class="py-2 pr-2 font-semibold">L</th><th class="py-2 pr-2 font-semibold">T</th><th class="py-2 pr-2 font-semibold">GF</th><th class="py-2 font-semibold">GA</th>'
        );
        parts.push('</tr></thead><tbody id="soccer-standings-tbody">');
        standingsRows.forEach(function (r, idx) {
          parts.push('<tr class="border-b border-taupe/20 text-white">');
          parts.push('<td class="py-2 pr-2">' + (idx + 1) + '</td>');
          parts.push('<td class="py-2 pr-2 font-semibold">' + esc(r.teamName) + '</td>');
          parts.push('<td class="py-2 pr-2">' + r.points + '</td>');
          parts.push('<td class="py-2 pr-2">' + r.wins + '</td>');
          parts.push('<td class="py-2 pr-2">' + r.losses + '</td>');
          parts.push('<td class="py-2 pr-2">' + r.ties + '</td>');
          parts.push('<td class="py-2 pr-2">' + r.goalsFor + '</td>');
          parts.push('<td class="py-2">' + r.goalsAgainst + '</td>');
          parts.push('</tr>');
        });
        parts.push('</tbody></table>');
        parts.push('</div></div>');
      }

      parts.push('</div>');
      root.innerHTML = parts.join('');

      var selA = document.getElementById('soccer-select-active');
      var selP = document.getElementById('soccer-select-previous');
      if (selA)
        selA.addEventListener('change', function () {
          if (selA.value) {
            state.seasonKey = selA.value;
            state.teamFilter = '';
            if (selP) selP.value = '';
            render();
          }
        });
      if (selP)
        selP.addEventListener('change', function () {
          if (selP.value) {
            state.seasonKey = selP.value;
            state.teamFilter = '';
            if (selA) selA.value = '';
            render();
          }
        });

      root.querySelectorAll('[data-schedule-mode]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          state.scheduleMode = btn.getAttribute('data-schedule-mode') || 'basic';
          render();
        });
      });

      var tf = document.getElementById('soccer-team-filter');
      if (tf)
        tf.addEventListener('change', function () {
          state.teamFilter = tf.value || '';
          render();
        });

      root.querySelectorAll('[data-print]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var m = btn.getAttribute('data-print');
          if (m === 'print-soccer-basic') printBlock('print-soccer-basic');
          else if (m === 'print-soccer-full') printBlock('print-soccer-full');
          else if (m === 'print-soccer-standings') printBlock('print-soccer-standings');
        });
      });
    }

    document.addEventListener('DOMContentLoaded', render);
  })();
</script>

<style is:global>
  /**
   * Print only the chosen block: hide everything else with display:none (not visibility),
   * so layout height matches the table and extra blank pages are avoided.
   */
  @media print {
    @page {
      margin: 12mm;
    }

    body.print-soccer-basic,
    body.print-soccer-basic html,
    body.print-soccer-full,
    body.print-soccer-full html,
    body.print-soccer-standings,
    body.print-soccer-standings html {
      min-height: 0 !important;
      height: auto !important;
      overflow: visible !important;
      background: #fff !important;
      color: #000 !important;
    }

    body.print-soccer-basic > div,
    body.print-soccer-full > div,
    body.print-soccer-standings > div {
      min-height: 0 !important;
      height: auto !important;
      padding-top: 0 !important;
    }

    body.print-soccer-basic main,
    body.print-soccer-full main,
    body.print-soccer-standings main {
      min-height: 0 !important;
      height: auto !important;
    }

    body.print-soccer-basic header,
    body.print-soccer-basic footer,
    body.print-soccer-full header,
    body.print-soccer-full footer,
    body.print-soccer-standings header,
    body.print-soccer-standings footer {
      display: none !important;
    }

    /* Everything in the page shell except the standings & schedule section */
    body.print-soccer-basic > div > main > *:not(#standings-and-schedule),
    body.print-soccer-full > div > main > *:not(#standings-and-schedule),
    body.print-soccer-standings > div > main > *:not(#standings-and-schedule) {
      display: none !important;
    }

    body.print-soccer-basic > div > footer,
    body.print-soccer-full > div > footer,
    body.print-soccer-standings > div > footer {
      display: none !important;
    }

    /* Section chrome: hide heading; show only the printable block inside the root */
    body.print-soccer-basic #standings-and-schedule > div > h2,
    body.print-soccer-full #standings-and-schedule > div > h2,
    body.print-soccer-standings #standings-and-schedule > div > h2 {
      display: none !important;
    }

    body.print-soccer-basic #standings-and-schedule,
    body.print-soccer-full #standings-and-schedule,
    body.print-soccer-standings #standings-and-schedule {
      padding: 0 !important;
      margin: 0 !important;
      background: transparent !important;
    }

    body.print-soccer-basic #soccer-league-root > div > *:not(#print-soccer-basic),
    body.print-soccer-full #soccer-league-root > div > *:not(#print-soccer-full),
    body.print-soccer-standings #soccer-league-root > div > *:not(#print-soccer-standings) {
      display: none !important;
    }

    body.print-soccer-basic #print-soccer-basic,
    body.print-soccer-full #print-soccer-full,
    body.print-soccer-standings #print-soccer-standings {
      position: static !important;
      width: 100% !important;
      max-width: none !important;
    }
  }
</style>
