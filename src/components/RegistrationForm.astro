---
import { getRegistrationSeasons } from '../data/leagueCatalog';

const {
  apiUrl,
  /** reCAPTCHA v3 site key (`grecaptcha.execute`). */
  recaptchaSiteKey = '',
  /** Optional v2 site key: checkbox after v3 fails (`recaptchaV2Required`) or v2-only mode. */
  recaptchaSiteKeyV2 = '',
  context = 'standalone',
  registrationId = '',
  /** When false, parent page loads `api.js?render=` once (e.g. registration flow). */
  includeRecaptchaScript = true
} = Astro.props;
const isFlow = context === 'flow';
const showV2Initially = !recaptchaSiteKey && !!recaptchaSiteKeyV2;
// Only expose seasons that are still open for registration. Closed seasons are
// excluded from the selection UI entirely. The client-side `isSeasonOpen`
// checks remain as a safety net for cases where a season's close time passes
// while a user already has the form loaded.
const registrationSeasons = getRegistrationSeasons()
  .filter((season) => season.isOpen)
  .map((season) => ({
    submissionValue: season.submissionValue,
    displayLabel: season.displayLabel,
    price: season.price,
    registrationClosesAt: season.registrationClosesAt,
    teams: season.teams
  }));
const hasOpenSeasons = registrationSeasons.length > 0;
---

<form id="registration-form" class="mt-6 space-y-4" novalidate>
  <p class="text-sm text-taupe">Fields marked with <span class="text-red-500 font-medium">*</span> are required (except notes and emergency contact).</p>
  <div>
    <label for="fullName" class="mb-1 block font-medium text-white"><span class="text-red-500">*</span> Full Name</label>
    <input type="text" id="fullName" name="fullName" required maxlength="150" placeholder="Your full name" class="w-full rounded-lg border border-taupe/30 bg-forest-dark px-4 py-2 text-white placeholder:text-taupe/60 focus:border-orange focus:outline-none focus:ring-1 focus:ring-orange" />
  </div>
  <div>
    <label for="email" class="mb-1 block font-medium text-white"><span class="text-red-500">*</span> Email</label>
    <input type="email" id="email" name="email" required maxlength="254" placeholder="you@example.com" class="w-full rounded-lg border border-taupe/30 bg-forest-dark px-4 py-2 text-white placeholder:text-taupe/60 focus:border-orange focus:outline-none focus:ring-1 focus:ring-orange" />
  </div>
  <div>
    <label for="phone" class="mb-1 block font-medium text-white"><span class="text-red-500">*</span> Phone</label>
    <input type="tel" id="phone" name="phone" required maxlength="25" placeholder="(555) 000-0000" class="w-full rounded-lg border border-taupe/30 bg-forest-dark px-4 py-2 text-white placeholder:text-taupe/60 focus:border-orange focus:outline-none focus:ring-1 focus:ring-orange" />
  </div>
  <div>
    <div class="flex items-start justify-between gap-3">
      <label for="postalCode" class="block font-medium text-white"><span class="text-red-500">*</span> Postal Code</label>
      <button
        type="button"
        id="postalCodeHelpBtn"
        class="flex h-6 w-6 select-none items-center justify-center rounded-full border border-taupe/30 bg-forest-dark text-xs font-bold text-taupe hover:border-orange focus:outline-none focus:ring-2 focus:ring-orange"
        aria-haspopup="true"
        aria-controls="postalCodeHelpTooltip"
        aria-expanded="false"
        title="Required for affiliation status."
      >
        ?
      </button>
    </div>
    <input type="text" id="postalCode" name="postalCode" required maxlength="7" placeholder="(XXX-XXX)" inputmode="text" autocomplete="postal-code" class="w-full rounded-lg border border-taupe/30 bg-forest-dark px-4 py-2 text-white placeholder:text-taupe/60 focus:border-orange focus:outline-none focus:ring-1 focus:ring-orange" />
    <div id="postalCodeHelpTooltip" class="hidden mt-1 text-xs text-taupe" role="note">
      Required for affiliation status.
    </div>
  </div>
  <div>
    <span id="leagueSeasonsLabel" class="mb-2 block font-medium text-white"><span class="text-red-500">*</span> League / Season</span>
    {hasOpenSeasons ? (
      <Fragment>
        <div
          id="leagueSeasons"
          class="league-seasons-list space-y-1 rounded-lg border border-taupe/30 bg-forest-dark p-2"
          role="group"
          aria-labelledby="leagueSeasonsLabel"
          aria-describedby="leagueSeasonsHelp"
        >
          {registrationSeasons.map((season, i) => (
            <label
              class="league-season-row flex cursor-pointer items-start gap-3 rounded-md px-2 py-2 transition-colors hover:bg-white/5 has-[:checked]:bg-orange/10 has-[:checked]:ring-1 has-[:checked]:ring-orange/50"
            >
              <input
                type="checkbox"
                name="leagueSeason"
                id={`league-season-${i}`}
                value={season.submissionValue}
                class="league-season-cb mt-1 h-4 w-4 shrink-0 accent-orange"
                data-display-label={season.displayLabel}
              />
              <span class="min-w-0 flex-1 text-sm text-white">
                <span class="font-medium">{season.displayLabel}</span>
                <span class="ml-2 text-taupe">${season.price}</span>
              </span>
            </label>
          ))}
        </div>
        <div
          id="leagueSeasonsSelectedSummary"
          class="league-seasons-selected mt-3 hidden rounded-lg border border-orange/40 bg-orange/10 px-3 py-2"
          role="status"
          aria-live="polite"
        >
          <p class="text-xs font-semibold uppercase tracking-wide text-orange-200">Selected</p>
          <ul id="leagueSeasonsSelectedList" class="mt-1 list-none space-y-1 text-sm text-white"></ul>
        </div>
        <p id="leagueSeasonsHelp" class="mt-2 text-xs text-taupe">Select every season you are registering for. Your choices appear under Selected below.</p>
        <p id="registrationClosedHelp" class="mt-1 hidden text-xs text-red-500">Registration is closed for one or more selected seasons.</p>
      </Fragment>
    ) : (
      <div class="rounded-lg border border-amber-600/80 bg-amber-900/40 px-4 py-3 text-amber-100" role="alert">
        <p class="font-semibold">Registration is currently closed</p>
        <p class="mt-1 text-sm">There are no seasons open for registration right now. Please check back later for upcoming seasons.</p>
      </div>
    )}
  </div>
  <div>
    <span class="mb-2 block font-medium text-white"><span class="text-red-500">*</span> Registration Choices</span>
    <div class="flex flex-col gap-3">
      <label class="flex cursor-pointer items-start gap-2">
        <input type="radio" id="regTypeExistingTeam" name="regType" value="existingTeam" class="mt-1 h-4 w-4 accent-orange" checked />
        <span class="text-white">I am joining an existing team</span>
      </label>
      <div id="existingTeamWrap" class="ml-6 mt-1" style="display: none;">
        <label for="existingTeamName" class="mb-1 block font-medium text-white"><span class="text-red-500">*</span> Team / Captain</label>
        <select id="existingTeamName" name="existingTeamName" class="w-full rounded-lg border border-taupe/30 bg-forest-dark px-4 py-2 text-white focus:border-orange focus:outline-none focus:ring-1 focus:ring-orange">
          <option value="">Select a team...</option>
        </select>
      </div>
      <label class="flex cursor-pointer items-start gap-2">
        <input type="radio" id="regTypeFreeAgent" name="regType" value="freeAgent" class="mt-1 h-4 w-4 accent-orange" />
        <span class="text-white">I am signing up as an individual</span>
      </label>
      <div id="freeAgentWrap" class="ml-6 mt-1" style="display: none;">
        <div class="rounded-lg border border-amber-600/80 bg-amber-900/40 px-4 py-3 text-amber-100" role="alert">
          <p class="font-semibold">WAITLIST NOTICE</p>
          <p class="mt-1 text-sm">Individual signups are placed on a waitlist. You will be contacted with team placement details.</p>
        </div>
      </div>
      <!-- <label class="flex cursor-pointer items-start gap-2">
        <input type="radio" id="regTypeNewTeam" name="regType" value="newTeam" class="mt-1 h-4 w-4 accent-orange" />
        <span class="text-white">I am starting a NEW team (Captain)</span>
      </label> -->
      <div id="newTeamWrap" class="ml-6 mt-1 space-y-3" style="display: none;">
        <div>
          <label for="newTeamName" class="mb-1 block font-medium text-white"><span class="text-red-500">*</span> Team name</label>
          <input type="text" id="newTeamName" name="newTeamName" maxlength="100" placeholder="Your new team name" class="w-full rounded-lg border border-taupe/30 bg-forest-dark px-4 py-2 text-white placeholder:text-taupe/60 focus:border-orange focus:outline-none focus:ring-1 focus:ring-orange" />
        </div>
        <div class="rounded-lg border border-amber-600/80 bg-amber-900/40 px-4 py-3 text-amber-100" role="alert">
          <p class="font-semibold">WAITLIST NOTICE</p>
          <p class="mt-1 text-sm">New team registrations are placed on a waitlist. After review new teams will be added. You will be contacted to discuss your submission and be provided more details.</p>
        </div>
        <label class="flex cursor-pointer items-start gap-2">
          <input type="checkbox" id="newTeamCaptainAgreement" name="newTeamCaptainAgreement" class="mt-0.5 h-4 w-4 accent-orange" />
          <span class="text-white"><span class="text-red-500">*</span> I am registering a new team as a team captain</span>
        </label>
      </div>
    </div>
  </div>
  <div>
    <label for="emergencyName" class="mb-1 block font-medium text-white">Emergency Contact Name</label>
    <input type="text" id="emergencyName" name="emergencyName" maxlength="100" placeholder="Full name" class="w-full rounded-lg border border-taupe/30 bg-forest-dark px-4 py-2 text-white placeholder:text-taupe/60 focus:border-orange focus:outline-none focus:ring-1 focus:ring-orange" />
  </div>
  <div>
    <label for="emergencyPhone" class="mb-1 block font-medium text-white">Emergency Contact Phone</label>
    <input type="tel" id="emergencyPhone" name="emergencyPhone" maxlength="25" placeholder="(555) 000-0000" class="w-full rounded-lg border border-taupe/30 bg-forest-dark px-4 py-2 text-white placeholder:text-taupe/60 focus:border-orange focus:outline-none focus:ring-1 focus:ring-orange" />
  </div>
  <div>
    <label for="notes" class="mb-1 block font-medium text-white">Notes</label>
    <textarea id="notes" name="notes" maxlength="1000" placeholder="Any additional information... (max 1000 characters)" rows="3" class="w-full resize-y rounded-lg border border-taupe/30 bg-forest-dark px-4 py-2 text-white placeholder:text-taupe/60 focus:border-orange focus:outline-none focus:ring-1 focus:ring-orange"></textarea>
  </div>

  <div id="registration-recaptcha-wrap" class="min-h-0" aria-hidden="true"></div>
  {recaptchaSiteKeyV2 && (
    <div
      id="registration-recaptcha-v2-wrap"
      class:list={['mt-2 flex justify-center', showV2Initially ? '' : 'hidden']}
      aria-hidden={showV2Initially ? 'false' : 'true'}
    />
  )}

  <button
    type="submit"
    id="registrationSubmitBtn"
    class="w-full rounded-lg bg-orange px-4 py-3 font-semibold text-white hover:bg-orange-dark focus:outline-none focus:ring-2 focus:ring-orange disabled:cursor-not-allowed disabled:opacity-70"
    disabled={!hasOpenSeasons}
    title={hasOpenSeasons ? '' : 'Registration is currently closed for all seasons.'}
  >
    Submit Registration
  </button>
  <!-- <button
    type="button"
    id="registrationMockSubmitBtn"
    class="mt-2 w-full rounded-lg border border-taupe/30 bg-forest-dark px-4 py-3 font-semibold text-white hover:bg-sage-dark focus:outline-none focus:ring-2 focus:ring-orange disabled:cursor-not-allowed disabled:opacity-70"
    disabled={!hasOpenSeasons}
    title={hasOpenSeasons ? '' : 'Registration is currently closed for all seasons.'}
  >
    Mocky Submit Registration
  </button> -->
</form>

<div id="registrationStatusMessage" class="mt-4 min-h-[1.5em] flex flex-col items-center justify-center gap-2 text-center font-medium" aria-live="polite">
  <span id="registrationStatusSpinner" class="submit-spinner h-10 w-10 rounded-full border-2 border-sage-dark border-t-orange" aria-hidden="true" style="display: none;"></span>
  <span id="registrationStatusText"></span>
  <div id="registrationSuccessActions" class="mt-2 flex flex-col gap-3" style="display: none;">
    <p class="rounded-lg bg-amber-900/80 px-4 py-3 text-center font-semibold text-amber-100" role="alert">
      Waiver must be signed before playing.
    </p>
    <div class="flex flex-wrap items-center justify-between gap-2">
      <button type="button" id="resetRegistrationBtn" class="rounded-lg border border-taupe/30 bg-forest-dark px-4 py-2 font-semibold text-white hover:bg-sage-dark focus:outline-none focus:ring-2 focus:ring-orange">Reset form</button>
      {!isFlow && <a href="/league/waiver" class="rounded-lg bg-orange px-4 py-2 font-semibold text-white hover:bg-orange-dark focus:outline-none focus:ring-2 focus:ring-orange">Continue to Waiver</a>}
    </div>
  </div>
  <div id="registrationFreeAgentSuccess" class="mt-2 flex flex-col gap-3" style="display: none;" role="status" aria-live="polite">
    <div class="rounded-lg border border-amber-600/80 bg-amber-900/80 px-4 py-3 text-amber-100" role="alert">
      <p class="text-base font-bold">Free Agent registration was successful!</p>
      <p class="mt-1 text-sm">You have been added to our waitlist. We will contact you if there is availability on a team.</p>
    </div>
    <div class="flex flex-wrap items-center justify-center gap-2">
      <button type="button" id="resetRegistrationFreeAgentBtn" class="rounded-lg border border-taupe/30 bg-forest-dark px-4 py-2 font-semibold text-white hover:bg-sage-dark focus:outline-none focus:ring-2 focus:ring-orange">Register another</button>
    </div>
  </div>
</div>

<!-- Modal popped on free agent registration success so the waitlist message
     cannot be accidentally missed. Mirrors the registrationCompleteModal
     pattern used by the parent flow page. -->
<div
  id="freeAgentSuccessModal"
  class="free-agent-success-modal fixed inset-0 z-[100] hidden items-center justify-center bg-black/70 p-4"
  role="dialog"
  aria-modal="true"
  aria-labelledby="freeAgentSuccessModalTitle"
  aria-describedby="freeAgentSuccessModalBody"
  aria-hidden="true"
>
  <div class="max-h-[90vh] w-full max-w-md overflow-y-auto rounded-xl border border-amber-600/80 bg-forest-dark p-6 shadow-xl">
    <h2 id="freeAgentSuccessModalTitle" class="font-heading text-xl font-bold text-amber-100">
      Free Agent registration successful
    </h2>
    <div id="freeAgentSuccessModalBody" class="mt-3 space-y-2 text-sm text-white">
      <p>You have been added to our <span class="font-semibold text-amber-100">free agent waitlist</span>.</p>
      <p>We will contact you if there is availability on a team. No payment is required at this time.</p>
    </div>
    <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:justify-end">
      <button
        type="button"
        id="freeAgentSuccessModalCloseBtn"
        class="rounded-lg border border-taupe/30 bg-forest-dark px-4 py-3 font-semibold text-white hover:bg-sage-dark focus:outline-none focus:ring-2 focus:ring-orange"
      >
        Got it
      </button>
      <button
        type="button"
        id="freeAgentSuccessModalRestartBtn"
        class="rounded-lg bg-orange px-4 py-3 font-semibold text-white hover:bg-orange-dark focus:outline-none focus:ring-2 focus:ring-orange"
      >
        Register another
      </button>
    </div>
  </div>
</div>

<style>
  .submit-spinner {
    border-top-color: var(--theme-orange);
    animation: submit-spin 0.8s linear infinite;
  }
  @keyframes submit-spin {
    to { transform: rotate(360deg); }
  }
  .league-seasons-list:focus-within {
    outline: 1px solid var(--theme-orange, #ea580c);
    outline-offset: 2px;
  }
  .free-agent-success-modal:not(.hidden) {
    display: flex;
  }
</style>

{includeRecaptchaScript && recaptchaSiteKeyV2 && !recaptchaSiteKey && (
  <script define:vars={{ recaptchaSiteKeyV2 }}>
    window.solkerRegistrationFormV2Onload = function() {
      var wrap = document.getElementById('registration-recaptcha-v2-wrap');
      if (!wrap || !recaptchaSiteKeyV2 || typeof grecaptcha === 'undefined') return;
      if (wrap.getAttribute('data-rc-widget-id')) return;
      var wid = grecaptcha.render(wrap, { sitekey: recaptchaSiteKeyV2, theme: 'dark' });
      wrap.setAttribute('data-rc-widget-id', String(wid));
    };
  </script>
)}
{includeRecaptchaScript && recaptchaSiteKeyV2 && !recaptchaSiteKey && (
  <script src="https://www.google.com/recaptcha/api.js?onload=solkerRegistrationFormV2Onload&render=explicit" async defer />
)}
{includeRecaptchaScript && recaptchaSiteKey && (
  <script src={`https://www.google.com/recaptcha/api.js?render=${recaptchaSiteKey}`} async defer />
)}
<script define:vars={{ apiUrl, recaptchaSiteKey, recaptchaSiteKeyV2, isFlow, registrationId, registrationSeasons }}>
  (function() {
    var regV2Mode = false;

    function getRegV2WidgetId() {
      var wrap = document.getElementById('registration-recaptcha-v2-wrap');
      if (!wrap) return null;
      var raw = wrap.getAttribute('data-rc-widget-id');
      return raw != null && raw !== '' ? parseInt(raw, 10) : null;
    }

    function ensureRegV2WidgetVisible() {
      var wrap = document.getElementById('registration-recaptcha-v2-wrap');
      if (!wrap || !recaptchaSiteKeyV2 || typeof grecaptcha === 'undefined') return null;
      wrap.classList.remove('hidden');
      wrap.setAttribute('aria-hidden', 'false');
      var existing = getRegV2WidgetId();
      if (existing !== null && !isNaN(existing)) return existing;
      try {
        var wid = grecaptcha.render(wrap, { sitekey: recaptchaSiteKeyV2, theme: 'dark' });
        wrap.setAttribute('data-rc-widget-id', String(wid));
        return wid;
      } catch (e) {
        return null;
      }
    }
    function findSeasonMetaByValue(submissionValue) {
      for (var i = 0; i < registrationSeasons.length; i++) {
        if (registrationSeasons[i].submissionValue === submissionValue) return registrationSeasons[i];
      }
      return null;
    }

    function isSeasonOpen(submissionValue) {
      var season = findSeasonMetaByValue(submissionValue);
      if (!season || !season.registrationClosesAt) return true;
      var closeAt = new Date(season.registrationClosesAt);
      if (Number.isNaN(closeAt.getTime())) return true;
      return Date.now() <= closeAt.getTime();
    }

    function getSelectedLeagueSeasonValues() {
      var wrap = document.getElementById('leagueSeasons');
      if (!wrap) return [];
      var boxes = wrap.querySelectorAll('input.league-season-cb:checked');
      return Array.prototype.map.call(boxes, function(b) { return b.value; });
    }

    function updateLeagueSeasonsSelectedSummary() {
      var summary = document.getElementById('leagueSeasonsSelectedSummary');
      var listEl = document.getElementById('leagueSeasonsSelectedList');
      if (!summary || !listEl) return;
      var selected = getSelectedLeagueSeasonValues();
      listEl.innerHTML = '';
      if (!selected.length) {
        summary.classList.add('hidden');
        return;
      }
      summary.classList.remove('hidden');
      selected.forEach(function(val) {
        var meta = findSeasonMetaByValue(val);
        var text = meta && meta.displayLabel ? meta.displayLabel : val;
        var li = document.createElement('li');
        li.className = 'pl-0';
        li.textContent = '✓ ' + text;
        listEl.appendChild(li);
      });
    }

    function updateTeamOptionsForSeasons() {
      var existingTeamEl = document.getElementById('existingTeamName');
      if (!existingTeamEl) return;
      while (existingTeamEl.options.length > 1) existingTeamEl.remove(1);
      var selected = getSelectedLeagueSeasonValues();
      var seen = {};
      selected.forEach(function(sv) {
        var season = findSeasonMetaByValue(sv);
        if (!season || !season.teams) return;
        season.teams.forEach(function(team) {
          var val = (team.teamName || '') + ' - ' + (team.captainName || '');
          if (seen[val]) return;
          seen[val] = true;
          var option = document.createElement('option');
          option.value = val;
          option.textContent = (team.teamName || 'Unnamed Team') + ' (Captain: ' + (team.captainName || 'TBD') + ')';
          existingTeamEl.appendChild(option);
        });
      });
    }

    function areAllSelectedSeasonsOpen() {
      var selected = getSelectedLeagueSeasonValues();
      if (!selected.length) return true;
      for (var i = 0; i < selected.length; i++) {
        if (!isSeasonOpen(selected[i])) return false;
      }
      return true;
    }

    function updateRegistrationClosedState() {
      var closedHelpEl = document.getElementById('registrationClosedHelp');
      var submitBtn = document.getElementById('registrationSubmitBtn');
      var mockBtn = document.getElementById('registrationMockSubmitBtn');
      if (!submitBtn) return;
      // If there are no open seasons at all, the league selection UI is not
      // rendered. Keep both submit buttons disabled and bail out early so we
      // don't accidentally re-enable the server-disabled buttons.
      if (!registrationSeasons || registrationSeasons.length === 0) {
        submitBtn.disabled = true;
        submitBtn.title = 'Registration is currently closed for all seasons.';
        if (mockBtn) {
          mockBtn.disabled = true;
          mockBtn.title = 'Registration is currently closed for all seasons.';
        }
        if (closedHelpEl) closedHelpEl.classList.add('hidden');
        return;
      }
      var selected = getSelectedLeagueSeasonValues();
      var allOpen = areAllSelectedSeasonsOpen();
      var shouldDisable = selected.length > 0 && !allOpen;
      submitBtn.disabled = shouldDisable;
      submitBtn.title = shouldDisable ? 'Registration is closed for one or more selected seasons.' : '';
      if (closedHelpEl) closedHelpEl.classList.toggle('hidden', !shouldDisable);
    }

    function updateRegistrationChoiceVisibility() {
      var existingWrap = document.getElementById('existingTeamWrap');
      var newWrap = document.getElementById('newTeamWrap');
      var freeAgentWrap = document.getElementById('freeAgentWrap');
      var existingTeam = document.getElementById('regTypeExistingTeam');
      var newTeam = document.getElementById('regTypeNewTeam');
      var freeAgent = document.getElementById('regTypeFreeAgent');
      var existingNameEl = document.getElementById('existingTeamName');
      var newNameEl = document.getElementById('newTeamName');
      var agreementEl = document.getElementById('newTeamCaptainAgreement');
      var isExisting = existingTeam && existingTeam.checked;
      var isNew = newTeam && newTeam.checked;
      var isFreeAgent = freeAgent && freeAgent.checked;
      if (existingWrap) existingWrap.style.display = isExisting ? 'block' : 'none';
      if (newWrap) newWrap.style.display = isNew ? 'block' : 'none';
      if (freeAgentWrap) freeAgentWrap.style.display = isFreeAgent ? 'block' : 'none';
      if (existingNameEl) existingNameEl.required = isExisting;
      if (newNameEl) newNameEl.required = isNew;
      if (agreementEl) agreementEl.required = isNew;
      if (!isNew && agreementEl) agreementEl.checked = false;
      if (!isExisting && existingNameEl) existingNameEl.value = '';
      if (!isNew && newNameEl) newNameEl.value = '';
    }
    document.querySelectorAll('#registration-form input[name="regType"]').forEach(function(radio) {
      radio.addEventListener('change', updateRegistrationChoiceVisibility);
    });
    updateRegistrationChoiceVisibility();

    var leagueSeasonsEl = document.getElementById('leagueSeasons');
    if (leagueSeasonsEl) {
      leagueSeasonsEl.addEventListener('change', function() {
        updateTeamOptionsForSeasons();
        updateRegistrationClosedState();
        updateLeagueSeasonsSelectedSummary();
      });
      updateTeamOptionsForSeasons();
      updateLeagueSeasonsSelectedSummary();
    }
    updateRegistrationClosedState();

    function restrictPhoneInput(el) {
      if (!el) return;
      el.addEventListener('input', function() {
        var v = this.value;
        var allowed = v.replace(/[^\d\s\-()+]/g, '');
        if (v !== allowed) this.value = allowed;
      });
    }
    restrictPhoneInput(document.getElementById('phone'));
    restrictPhoneInput(document.getElementById('emergencyPhone'));

    function formatPostalCodeInput(value) {
      var v = (value || '').toString().toUpperCase();
      v = v.replace(/[^A-Z0-9]/g, '');
      v = v.slice(0, 6);
      if (v.length <= 3) return v;
      return v.slice(0, 3) + '-' + v.slice(3);
    }

    function restrictPostalInput(el) {
      if (!el) return;
      el.addEventListener('input', function() {
        var formatted = formatPostalCodeInput(this.value);
        if (this.value !== formatted) this.value = formatted;
      });
    }
    restrictPostalInput(document.getElementById('postalCode'));

    (function setupPostalCodeHelp() {
      var btn = document.getElementById('postalCodeHelpBtn');
      var tooltip = document.getElementById('postalCodeHelpTooltip');
      if (!btn || !tooltip) return;

      function show() {
        tooltip.classList.remove('hidden');
        btn.setAttribute('aria-expanded', 'true');
      }
      function hide() {
        tooltip.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
      }

      btn.addEventListener('click', function(ev) {
        ev.preventDefault();
        ev.stopPropagation();
        if (tooltip.classList.contains('hidden')) show();
        else hide();
      });

      btn.addEventListener('mouseenter', show);
      btn.addEventListener('mouseleave', hide);
      tooltip.addEventListener('mouseenter', show);
      tooltip.addEventListener('mouseleave', hide);

      document.addEventListener('click', function() {
        hide();
      });
    })();

    var form = document.getElementById('registration-form');
    if (form) {
      form.addEventListener('submit', function(e) {
        e.preventDefault();
        var fullName = (form.querySelector('#fullName') && form.querySelector('#fullName').value) ? form.querySelector('#fullName').value.trim() : '';
        var email = (form.querySelector('#email') && form.querySelector('#email').value) ? form.querySelector('#email').value.trim() : '';
        var statusSpinner = document.getElementById('registrationStatusSpinner');
        var statusText = document.getElementById('registrationStatusText');
        var successActions = document.getElementById('registrationSuccessActions');
        var submitBtn = document.getElementById('registrationSubmitBtn');

        var phone = (form.querySelector('#phone') && form.querySelector('#phone').value) ? form.querySelector('#phone').value.trim() : '';
        var postalCode = (form.querySelector('#postalCode') && form.querySelector('#postalCode').value) ? form.querySelector('#postalCode').value.trim().toUpperCase() : '';
        var leagueSeasons = getSelectedLeagueSeasonValues();
        if (!fullName || !email) {
          if (statusSpinner) statusSpinner.style.display = 'none';
          if (statusText) statusText.textContent = 'Please fill in your name and email.';
          return;
        }
        var emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailRegex.test(email)) {
          if (statusSpinner) statusSpinner.style.display = 'none';
          if (statusText) statusText.textContent = 'Please enter a valid email address.';
          return;
        }
        if (!phone) {
          if (statusSpinner) statusSpinner.style.display = 'none';
          if (statusText) statusText.textContent = 'Please fill in your phone number.';
          return;
        }
        if (!postalCode) {
          if (statusSpinner) statusSpinner.style.display = 'none';
          if (statusText) statusText.textContent = 'Please fill in your postal code.';
          return;
        }
        var postalRegex = /^[A-Z0-9]{3}-[A-Z0-9]{3}$/;
        if (!postalRegex.test(postalCode)) {
          if (statusSpinner) statusSpinner.style.display = 'none';
          if (statusText) statusText.textContent = 'Please enter your postal code in the format XXX-XXX.';
          return;
        }
        if (!leagueSeasons.length) {
          if (statusSpinner) statusSpinner.style.display = 'none';
          if (statusText) statusText.textContent = 'Please select at least one league / season.';
          return;
        }
        for (var si = 0; si < leagueSeasons.length; si++) {
          if (!isSeasonOpen(leagueSeasons[si])) {
            if (statusSpinner) statusSpinner.style.display = 'none';
            if (statusText) statusText.textContent = 'Registration is closed for one or more selected seasons.';
            updateRegistrationClosedState();
            return;
          }
        }
        if (!recaptchaSiteKey && !recaptchaSiteKeyV2) {
          if (statusSpinner) statusSpinner.style.display = 'none';
          if (statusText) statusText.textContent = 'Form is not configured. Set PUBLIC_RECAPTCHA_SITE_KEY_V3 or PUBLIC_RECAPTCHA_SITE_KEY (v2).';
          return;
        }
        if (!apiUrl) {
          if (statusSpinner) statusSpinner.style.display = 'none';
          if (statusText) statusText.textContent = 'Form is not configured. Set PUBLIC_FORMS_API_URL (or PUBLIC_FORMS_API_URL_DEV for local dev).';
          return;
        }

        var regTypeExistingTeam = form.querySelector('#regTypeExistingTeam');
        var regTypeNewTeam = form.querySelector('#regTypeNewTeam');
        var existingTeamNameEl = form.querySelector('#existingTeamName');
        var newTeamNameEl = form.querySelector('#newTeamName');
        var newTeamCaptainAgreementEl = form.querySelector('#newTeamCaptainAgreement');
        var registrationChoice = regTypeExistingTeam && regTypeExistingTeam.checked ? 'existingTeam' : (regTypeNewTeam && regTypeNewTeam.checked ? 'newTeam' : 'freeAgent');
        var teamOrFreeAgentValue = 'Free Agent';
        if (registrationChoice === 'existingTeam') {
          if (!existingTeamNameEl || !existingTeamNameEl.value.trim()) {
            if (statusSpinner) statusSpinner.style.display = 'none';
            if (statusText) statusText.textContent = 'Please select an existing team.';
            return;
          }
          teamOrFreeAgentValue = existingTeamNameEl.value.trim();
        } else if (registrationChoice === 'newTeam') {
          if (!newTeamNameEl || !newTeamNameEl.value.trim()) {
            if (statusSpinner) statusSpinner.style.display = 'none';
            if (statusText) statusText.textContent = 'Please enter your new team name.';
            return;
          }
          if (!newTeamCaptainAgreementEl || !newTeamCaptainAgreementEl.checked) {
            if (statusSpinner) statusSpinner.style.display = 'none';
            if (statusText) statusText.textContent = 'Please confirm that you are registering a new team as team captain.';
            return;
          }
          teamOrFreeAgentValue = newTeamNameEl.value.trim();
        }

        submitBtn.disabled = true;
        if (statusSpinner) statusSpinner.style.display = 'block';
        if (statusText) { statusText.textContent = 'Submitting…'; statusText.classList.remove('text-red-500', 'text-green-600'); }
        if (successActions) successActions.style.display = 'none';

        function failReg(msg) {
          if (statusSpinner) statusSpinner.style.display = 'none';
          if (statusText) { statusText.textContent = msg; statusText.classList.add('text-red-500'); }
          submitBtn.disabled = false;
        }

        if (typeof grecaptcha === 'undefined') {
          failReg('Spam protection could not load. Please refresh and try again.');
          return;
        }

        function handleRegistrationJson(json) {
          if (statusSpinner) statusSpinner.style.display = 'none';
          if (json.success) {
            regV2Mode = false;
            var isFreeAgentChoice = registrationChoice === 'freeAgent';
            var shouldAdvanceFlow = isFlow && registrationChoice === 'existingTeam';
            if (statusText) {
              if (isFreeAgentChoice) {
                // Message is rendered inside the free-agent success block below for prominence.
                statusText.textContent = '';
              } else {
                statusText.textContent = shouldAdvanceFlow
                  ? (json.message || 'Submitted.')
                  : 'Registration received. You will be contacted about your submission.';
              }
              statusText.classList.remove('text-red-500', 'text-taupe');
              statusText.classList.add('text-green-600');
            }
            submitBtn.style.display = 'none';
            var mockBtnEl = document.getElementById('registrationMockSubmitBtn');
            if (mockBtnEl) mockBtnEl.style.display = 'none';
            var recWrap = document.getElementById('registration-recaptcha-wrap');
            if (recWrap) recWrap.innerHTML = '';
            var v2w = document.getElementById('registration-recaptcha-v2-wrap');
            if (v2w) {
              v2w.classList.add('hidden');
              v2w.setAttribute('aria-hidden', 'true');
            }
            var freeAgentSuccess = document.getElementById('registrationFreeAgentSuccess');
            if (freeAgentSuccess) freeAgentSuccess.style.display = isFreeAgentChoice ? 'flex' : 'none';
            if (successActions) successActions.style.display = !isFreeAgentChoice && shouldAdvanceFlow ? 'flex' : 'none';
            if (isFreeAgentChoice) {
              openFreeAgentSuccessModal();
              if (typeof window.__onRegistrationFreeAgentSuccess === 'function') {
                window.__onRegistrationFreeAgentSuccess();
              }
            } else if (shouldAdvanceFlow && typeof window.__onRegistrationSuccess === 'function') {
              window.__onRegistrationSuccess();
            }
          } else {
            if (json.recaptchaV2Required && recaptchaSiteKeyV2) {
              var wid = ensureRegV2WidgetVisible();
              if (wid !== null && !isNaN(wid)) {
                regV2Mode = true;
                if (statusText) {
                  statusText.textContent = json.error || 'Complete the checkbox below, then submit again.';
                  statusText.classList.remove('text-red-500', 'text-green-600');
                  statusText.classList.add('text-taupe');
                }
                submitBtn.disabled = false;
                return;
              }
            }
            if (statusText) { statusText.textContent = json.error || 'Something went wrong.'; statusText.classList.add('text-red-500'); }
            submitBtn.disabled = false;
          }
        }

        function postRegistration(token) {
          var data = {
            fullName: fullName,
            email: email,
            phone: phone,
            postalCode: postalCode,
            leagueSeasons: leagueSeasons,
            registrationChoice: registrationChoice,
            teamOrFreeAgent: teamOrFreeAgentValue,
            newTeamCaptainAgreement: registrationChoice === 'newTeam' && newTeamCaptainAgreementEl && newTeamCaptainAgreementEl.checked,
            emergencyName: (form.querySelector('#emergencyName') && form.querySelector('#emergencyName').value) ? form.querySelector('#emergencyName').value.trim() : '',
            emergencyPhone: (form.querySelector('#emergencyPhone') && form.querySelector('#emergencyPhone').value) ? form.querySelector('#emergencyPhone').value.trim() : '',
            notes: (form.querySelector('#notes') && form.querySelector('#notes').value) ? form.querySelector('#notes').value.trim() : ''
          };
          if (isFlow && (typeof window.__registrationFlowId !== 'undefined' && window.__registrationFlowId)) data.registrationId = window.__registrationFlowId;

          var payload = { action: 'registration', data: data, recaptchaToken: token };

          fetch(apiUrl, {
            method: 'POST',
            body: JSON.stringify(payload),
            headers: { 'Content-Type': 'text/plain;charset=utf-8' },
            redirect: 'follow'
          })
            .then(function(res) { return res.json(); })
            .then(handleRegistrationJson)
            .catch(function(err) {
              if (statusSpinner) statusSpinner.style.display = 'none';
              if (statusText) { statusText.textContent = err.message || 'Network error. Please try again.'; statusText.classList.add('text-red-500'); }
              submitBtn.disabled = false;
            });
        }

        var useV2Token = !!recaptchaSiteKeyV2 && (!recaptchaSiteKey || regV2Mode);
        if (useV2Token) {
          var v2id = getRegV2WidgetId();
          if (v2id === null || isNaN(v2id)) {
            failReg('Spam protection could not load. Please refresh and try again.');
            return;
          }
          var v2token = grecaptcha.getResponse(v2id);
          if (!v2token) {
            failReg(!recaptchaSiteKey || regV2Mode ? 'Please complete the checkbox below, then submit again.' : 'Please complete the verification below.');
            return;
          }
          postRegistration(v2token);
          return;
        }

        grecaptcha.ready(function() {
          grecaptcha.execute(recaptchaSiteKey, { action: 'registration' }).then(function(token) {
            if (!token) {
              failReg('Spam protection check failed. Please try again.');
              return;
            }
            postRegistration(token);
          }).catch(function() {
            failReg('Spam protection check failed. Please try again.');
          });
        });
      });
    }

    var resetRegistrationBtn = document.getElementById('resetRegistrationBtn');
    if (resetRegistrationBtn) resetRegistrationBtn.addEventListener('click', function() { location.reload(); });

    var resetRegistrationFreeAgentBtn = document.getElementById('resetRegistrationFreeAgentBtn');
    if (resetRegistrationFreeAgentBtn) resetRegistrationFreeAgentBtn.addEventListener('click', function() { location.reload(); });

    var freeAgentModalPreviousFocus = null;
    function openFreeAgentSuccessModal() {
      var modal = document.getElementById('freeAgentSuccessModal');
      if (!modal) return;
      freeAgentModalPreviousFocus = document.activeElement;
      modal.classList.remove('hidden');
      modal.setAttribute('aria-hidden', 'false');
      var closeBtn = document.getElementById('freeAgentSuccessModalCloseBtn');
      if (closeBtn) closeBtn.focus();
      else modal.focus();
    }
    function closeFreeAgentSuccessModal() {
      var modal = document.getElementById('freeAgentSuccessModal');
      if (!modal) return;
      modal.classList.add('hidden');
      modal.setAttribute('aria-hidden', 'true');
      if (freeAgentModalPreviousFocus && typeof freeAgentModalPreviousFocus.focus === 'function') {
        freeAgentModalPreviousFocus.focus();
      }
      freeAgentModalPreviousFocus = null;
    }

    var freeAgentModalCloseBtn = document.getElementById('freeAgentSuccessModalCloseBtn');
    if (freeAgentModalCloseBtn) freeAgentModalCloseBtn.addEventListener('click', closeFreeAgentSuccessModal);

    var freeAgentModalRestartBtn = document.getElementById('freeAgentSuccessModalRestartBtn');
    if (freeAgentModalRestartBtn) freeAgentModalRestartBtn.addEventListener('click', function() { location.reload(); });

    document.addEventListener('keydown', function(ev) {
      var modal = document.getElementById('freeAgentSuccessModal');
      if (!modal || modal.classList.contains('hidden')) return;
      if (ev.key === 'Escape') {
        ev.preventDefault();
        closeFreeAgentSuccessModal();
        return;
      }
      if (ev.key !== 'Tab') return;
      var closeBtn = document.getElementById('freeAgentSuccessModalCloseBtn');
      var restartBtn = document.getElementById('freeAgentSuccessModalRestartBtn');
      if (!closeBtn || !restartBtn) return;
      var focusables = [closeBtn, restartBtn];
      var active = document.activeElement;
      var ix = focusables.indexOf(active);
      if (ev.shiftKey) {
        if (ix <= 0) {
          ev.preventDefault();
          restartBtn.focus();
        }
      } else {
        if (ix < 0 || ix === focusables.length - 1) {
          ev.preventDefault();
          closeBtn.focus();
        }
      }
    });

    var mockBtn = document.getElementById('registrationMockSubmitBtn');
    if (mockBtn) {
      mockBtn.addEventListener('click', function() {
        var statusSpinner = document.getElementById('registrationStatusSpinner');
        var statusText = document.getElementById('registrationStatusText');
        var successActions = document.getElementById('registrationSuccessActions');
        var freeAgentSuccess = document.getElementById('registrationFreeAgentSuccess');
        var submitBtn = document.getElementById('registrationSubmitBtn');
        var freeAgentRadio = document.getElementById('regTypeFreeAgent');
        var isFreeAgentChoice = !!(freeAgentRadio && freeAgentRadio.checked);
        if (!statusText) return;
        mockBtn.disabled = true;
        if (submitBtn) submitBtn.style.display = 'none';
        if (statusSpinner) statusSpinner.style.display = 'block';
        statusText.textContent = 'Submitting…';
        statusText.classList.remove('text-red-500', 'text-green-600');
        if (successActions) successActions.style.display = 'none';
        if (freeAgentSuccess) freeAgentSuccess.style.display = 'none';
        window.setTimeout(function() {
          if (statusSpinner) statusSpinner.style.display = 'none';
          var recWrap = document.getElementById('registration-recaptcha-wrap');
          if (recWrap) recWrap.innerHTML = '';
          if (isFreeAgentChoice) {
            statusText.textContent = '';
            if (freeAgentSuccess) freeAgentSuccess.style.display = 'flex';
            mockBtn.style.display = 'none';
            openFreeAgentSuccessModal();
            if (typeof window.__onRegistrationFreeAgentSuccess === 'function') window.__onRegistrationFreeAgentSuccess();
          } else {
            statusText.textContent = 'Registration submitted successfully.';
            statusText.classList.add('text-green-600');
            if (successActions) successActions.style.display = 'flex';
            mockBtn.disabled = false;
            if (isFlow && typeof window.__onRegistrationSuccess === 'function') window.__onRegistrationSuccess();
          }
        }, 1500);
      });
    }
  })();
</script>
