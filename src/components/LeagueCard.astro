---
interface Props {
  title: string;
  subtitle?: string;
  badge: string;
  imageSrc: { src: string } | string;
  imageAlt?: string;
  imageCredit?: string;
  primaryButtonText?: string;
  primaryButtonHref?: string;
  secondaryButtonText?: string;
  secondaryButtonHref?: string;
}
const { title, subtitle, badge, imageSrc, imageAlt = '', imageCredit, primaryButtonText, primaryButtonHref = '#', secondaryButtonText, secondaryButtonHref = '#' } = Astro.props;
const imgSrc = typeof imageSrc === 'string' ? imageSrc : imageSrc.src;
---

<article class="relative overflow-hidden rounded-xl border border-taupe/30 bg-sage-dark transition hover:border-taupe-light/50 hover:bg-sage">
  <div class="relative aspect-[4/3] w-full">
    <img
      src={imgSrc}
      alt={imageAlt}
      class="absolute inset-0 h-full w-full object-cover"
      width="400"
      height="300"
    />
    <div class="absolute inset-0 flex flex-col justify-end">
      <div class="backdrop-blur-md bg-forest/50 p-5">
        <p class="text-xs font-semibold uppercase tracking-wide text-orange">{badge}</p>
        <h2 class="font-heading mt-1 text-xl font-semibold text-white">{title}</h2>
        {subtitle && <p class="mt-1 text-md text-white/90">{subtitle}</p>}
        <div class="mt-4 flex flex-wrap gap-2">
          {primaryButtonText && (
            <a href={primaryButtonHref} class="rounded bg-orange px-3 py-2 text-sm font-medium text-white hover:bg-orange-dark focus:outline-none focus:ring-2 focus:ring-orange focus:ring-offset-2 focus:ring-offset-forest">
              {primaryButtonText}
            </a>
          )}
          {secondaryButtonText && (
            <a href={secondaryButtonHref} class="rounded border border-terracotta/70 bg-terracotta/20 px-3 py-2 text-sm font-medium text-white/95 hover:bg-terracotta/40 focus:outline-none focus:ring-2 focus:ring-orange focus:ring-offset-2 focus:ring-offset-forest">
              {secondaryButtonText}
            </a>
          )}
        </div>
        {imageCredit && (
          <p class="mt-3 text-[10px] text-white/70 [&_a]:underline [&_a]:hover:text-orange" set:html={imageCredit} />
        )}
      </div>
    </div>
  </div>
</article>
