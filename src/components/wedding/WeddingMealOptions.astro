---
import { mealOptions } from '../../data/wedding';
---

<details class="wedding-meal-options mb-8 rounded-lg border border-taupe/20 bg-sage-light/20 p-4 md:p-5">
  <summary
    class="flex cursor-pointer list-none items-center justify-between gap-3 focus:outline-none focus-visible:ring-2 focus-visible:ring-orange focus-visible:ring-offset-2 focus-visible:ring-offset-forest"
  >
    <span class="font-heading text-lg font-semibold text-white">Meal Options</span>
    <svg
      class="wedding-meal-chevron h-5 w-5 shrink-0 text-taupe-dark transition-transform duration-200"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </summary>

  <p class="mt-3 text-sm text-taupe-dark">
    All food served is <strong class="font-semibold text-orange">halal</strong>. Please note any allergies or dietary restrictions for each guest.
  </p>
  <ul class="mt-4 space-y-4">
    {
      mealOptions.map((meal) => (
        <li class="rounded-lg border border-taupe/15 bg-forest-dark/40 p-3">
          <h3 class="font-medium text-white">{meal.label}</h3>
          {meal.description && <p class="mt-0.5 text-xs font-medium uppercase tracking-wide text-orange">{meal.description}</p>}
          {meal.details && <p class="mt-2 text-sm text-taupe-dark">{meal.details}</p>}
        </li>
      ))
    }
  </ul>
</details>

<style>
  .wedding-meal-options > summary::-webkit-details-marker {
    display: none;
  }
  .wedding-meal-options[open] .wedding-meal-chevron {
    transform: rotate(180deg);
  }
</style>
