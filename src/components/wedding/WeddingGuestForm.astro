---
import { mealOptions, guestFormLimits, accommodations } from '../../data/wedding';
import WeddingMealOptions from './WeddingMealOptions.astro';

const hotel = accommodations.hotels[0];

const {
  apiUrl,
  recaptchaSiteKey = '',
  recaptchaSiteKeyV2 = '',
  includeRecaptchaScript = true,
} = Astro.props;

const showV2Initially = !recaptchaSiteKey && !!recaptchaSiteKeyV2;
const mealOptionsJson = JSON.stringify(mealOptions);
---

<form id="guest-details-form" class="space-y-6" novalidate>
  <!-- Honeypot: checkbox (not text) so browser autofill does not fill it when entering email -->
  <input
    type="checkbox"
    name="_gotcha"
    id="guest-gotcha"
    tabindex="-1"
    autocomplete="off"
    aria-hidden="true"
    class="absolute left-[-9999px] h-0 w-0 opacity-0"
  />

  <p class="text-sm text-taupe-dark">
    Fields marked with <span class="text-red-500 font-medium">*</span> are required. One submission per household — include everyone attending with you.
  </p>

  <section
    class="space-y-4 rounded-lg border border-taupe/20 bg-sage-light/20 p-4 sm:p-5"
    aria-labelledby="invite-code-heading"
  >
    <div>
      <h3 id="invite-code-heading" class="font-heading text-lg font-semibold text-white">
        Invite code
      </h3>
      <p class="mt-0.5 text-xs text-taupe-dark">
        Enter the 6-digit code from your invitation to unlock the form. If you opened a personal
        link, your code may already be filled in. If you've submitted before, your previous answers
        will be loaded so you can update them.
      </p>
    </div>

    <div>
      <label for="invite-code" class="mb-1 block font-medium text-white">
        <span class="text-red-500">*</span> Your 6-digit invite code
      </label>
      <div class="flex gap-2">
        <input
          type="text"
          id="invite-code"
          inputmode="numeric"
          autocomplete="one-time-code"
          maxlength="6"
          pattern="[0-9]{6}"
          placeholder="000000"
          class="w-full max-w-[12rem] rounded-lg border border-taupe/30 bg-forest-dark px-4 py-2 text-center text-xl tracking-[0.35em] text-white placeholder:text-taupe/60 focus:border-orange focus:outline-none focus:ring-1 focus:ring-orange"
        />
        <button
          type="button"
          id="invite-code-verify-btn"
          class="rounded-lg bg-orange px-4 py-2 font-semibold text-white hover:bg-orange-dark focus:outline-none focus:ring-2 focus:ring-orange disabled:cursor-not-allowed disabled:opacity-70"
        >
          Verify
        </button>
      </div>
      <p id="invite-code-status" class="mt-2 min-h-[1.25em] text-sm text-taupe-dark" aria-live="polite"></p>
    </div>
  </section>

  <section
    id="household-section"
    class="hidden space-y-6 rounded-lg border border-taupe/20 bg-sage-light/20 p-4 sm:p-5"
    aria-labelledby="household-info-heading"
  >
    <div>
      <h3 id="household-info-heading" class="font-heading text-lg font-semibold text-white">
        Household info
      </h3>
      <p class="mt-0.5 text-xs text-taupe-dark">One per submission — applies to your whole party.</p>
    </div>

  <div>
    <label for="guest-email" class="mb-1 block font-medium text-white">
      <span class="text-red-500">*</span> Your email
    </label>
    <input
      type="email"
      id="guest-email"
      name="email"
      required
      maxlength={guestFormLimits.maxEmailLength}
      placeholder="you@example.com"
      class="w-full rounded-lg border border-taupe/30 bg-forest-dark px-4 py-2 text-white placeholder:text-taupe/60 focus:border-orange focus:outline-none focus:ring-1 focus:ring-orange"
    />
    <p class="mt-1 text-xs text-taupe-dark">We'll send a copy of your submission to this address.</p>
  </div>

  <div>
    <label for="party-size" class="mb-1 block font-medium text-white">
      <span class="text-red-500">*</span> How many people are attending (including you)?
    </label>
    <select
      id="party-size"
      name="partySize"
      required
      class="w-full rounded-lg border border-taupe/30 bg-forest-dark px-4 py-2 text-white focus:border-orange focus:outline-none focus:ring-1 focus:ring-orange"
    >
      {
        Array.from({ length: guestFormLimits.maxPartySize }, (_, i) => i + 1).map((n) => (
          <option value={n}>{n}</option>
        ))
      }
    </select>
    <p class="mt-1 text-xs text-taupe-dark">
      Your invitation covers up to <span id="party-size-max" class="font-semibold text-white">-</span>
      guest(s). If this looks wrong, please contact Hanna or Shuaib.
    </p>
  </div>

  <fieldset class="space-y-3">
    <legend class="mb-1 font-medium text-white">
      <span class="text-red-500">*</span> Will you need a hotel room?
    </legend>
    <div class="flex flex-wrap gap-4">
      <label class="flex cursor-pointer items-center gap-2">
        <input type="radio" name="needsHotel" value="no" class="h-4 w-4 accent-orange" checked />
        <span class="text-taupe-dark">No</span>
      </label>
      <label class="flex cursor-pointer items-center gap-2">
        <input type="radio" name="needsHotel" value="yes" class="h-4 w-4 accent-orange" />
        <span class="text-taupe-dark">Yes</span>
      </label>
    </div>
  </fieldset>

  <div id="hotel-booking-info" class="hidden rounded-lg border border-taupe/30 bg-forest-dark/60 p-3 text-sm text-taupe-dark">
    <p>
      Rooms are blocked for <span class="font-medium text-white">Saturday night only</span>. To book at the
      {
        hotel?.url ? (
          <a
            href={hotel.url}
            target="_blank"
            rel="noopener noreferrer"
            class="font-medium text-orange underline hover:text-orange-light focus:outline-none focus:ring-2 focus:ring-orange"
          >
            Lamplighter Inn
          </a>
        ) : (
          'Lamplighter Inn'
        )
      }
      , call{' '}
      <a
        href="tel:519-681-7151"
        class="font-medium text-orange underline hover:text-orange-light focus:outline-none focus:ring-2 focus:ring-orange"
      >
        519-681-7151
      </a>{' '}
      and tell them you are booking a room in the reserved room block for <span class="font-medium text-white">"The Solker Wedding"</span>.
    </p>
  </div>
  </section>

  <div id="meal-options-section" class="hidden">
    <WeddingMealOptions />
  </div>

  <section
    id="guest-details-section"
    class="hidden space-y-4 rounded-lg border border-taupe/20 bg-sage-light/20 p-4 sm:p-5"
    aria-labelledby="guest-details-heading"
  >
    <div>
      <h3 id="guest-details-heading" class="font-heading text-lg font-semibold text-white">
        Guest details
      </h3>
      <p class="mt-0.5 text-xs text-taupe-dark">One per guest — name, meal, and dietary needs for each person attending.</p>
    </div>
    <div id="guest-rows" class="space-y-4" role="group" aria-label="Guest list"></div>
  </section>

  <div id="recaptcha-wrap" class="min-h-0" aria-hidden="true"></div>
  {
    recaptchaSiteKeyV2 && (
      <div
        id="guest-recaptcha-v2-wrap"
        class:list={['flex justify-center', showV2Initially ? '' : 'hidden']}
        aria-hidden={showV2Initially ? 'false' : 'true'}
      />
    )
  }

  <button
    type="submit"
    id="guest-submit-btn"
    class="hidden w-full rounded-lg bg-orange px-4 py-3 font-semibold text-white hover:bg-orange-dark focus:outline-none focus:ring-2 focus:ring-orange disabled:cursor-not-allowed disabled:opacity-70"
  >
    <span id="guest-submit-btn-text">Submit guest details</span>
  </button>
</form>

<div id="guest-status" class="mt-4 min-h-[1.5em] flex flex-col items-center justify-center gap-2 text-center font-medium" aria-live="polite">
  <span id="guest-status-spinner" class="guest-submit-spinner h-10 w-10 rounded-full border-2 border-sage-dark border-t-orange" aria-hidden="true" style="display: none;"></span>
  <span id="guest-status-text"></span>
</div>

<p class="mt-6 text-sm text-taupe-dark">
  This site is protected by reCAPTCHA and the Google
  <a href="https://policies.google.com/privacy" class="text-orange hover:text-orange-light" rel="noopener noreferrer">Privacy Policy</a>
  and
  <a href="https://policies.google.com/terms" class="text-orange hover:text-orange-light" rel="noopener noreferrer">Terms of Service</a>
  apply.
</p>

<style>
  .guest-submit-spinner {
    border-top-color: var(--theme-orange);
    animation: guest-spin 0.8s linear infinite;
  }
  @keyframes guest-spin {
    to {
      transform: rotate(360deg);
    }
  }
  .guest-row {
    border: 1px solid color-mix(in srgb, var(--theme-taupe) 30%, transparent);
    border-radius: 0.5rem;
    padding: 1rem;
    background: color-mix(in srgb, var(--theme-forest-dark) 50%, transparent);
  }
</style>

{
  includeRecaptchaScript && (recaptchaSiteKey || recaptchaSiteKeyV2) && (
    <script
      src={
        recaptchaSiteKey
          ? `https://www.google.com/recaptcha/api.js?render=${recaptchaSiteKey}`
          : 'https://www.google.com/recaptcha/api.js'
      }
      async
      defer
    />
  )
}

<script
  define:vars={{
    apiUrl,
    recaptchaSiteKey,
    recaptchaSiteKeyV2,
    mealOptionsJson,
    maxPartySize: guestFormLimits.maxPartySize,
    maxNameLength: guestFormLimits.maxNameLength,
    maxDietaryLength: guestFormLimits.maxDietaryLength,
  }}
>
  (function () {
    var mealOptions = JSON.parse(mealOptionsJson);
    var form = document.getElementById('guest-details-form');
    var partySizeEl = document.getElementById('party-size');
    var partySizeMaxEl = document.getElementById('party-size-max');
    var guestRowsEl = document.getElementById('guest-rows');
    var hotelWrap = document.getElementById('hotel-booking-info');
    var submitBtn = document.getElementById('guest-submit-btn');
    var submitBtnText = document.getElementById('guest-submit-btn-text');
    var statusSpinner = document.getElementById('guest-status-spinner');
    var statusText = document.getElementById('guest-status-text');
    var codeInput = document.getElementById('invite-code');
    var codeVerifyBtn = document.getElementById('invite-code-verify-btn');
    var codeStatus = document.getElementById('invite-code-status');
    var householdSection = document.getElementById('household-section');
    var mealOptionsSection = document.getElementById('meal-options-section');
    var guestDetailsSection = document.getElementById('guest-details-section');
    var guestV2Mode = false;
    var guestV2WidgetId = null;

    var inviteVerified = false;
    var verifiedCode = '';
    var allowedPartySize = 0;
    var isVerifying = false;

    if (!form || !partySizeEl || !guestRowsEl || !codeInput) return;

    function escapeHtml(s) {
      return String(s)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function mealDetailsFor(value) {
      var match = mealOptions.find(function (m) {
        return m.value === value;
      });
      return match && match.details ? match.details : '';
    }

    function mealSelectHtml(index) {
      var opts = mealOptions
        .map(function (m) {
          var label = m.label + (m.description ? ' — ' + m.description : '');
          return (
            '<option value="' +
            escapeHtml(m.value) +
            '">' +
            escapeHtml(label) +
            '</option>'
          );
        })
        .join('');
      return (
        '<select id="guest-meal-' +
        index +
        '" name="guestMeal-' +
        index +
        '" required class="w-full rounded-lg border border-taupe/30 bg-forest-dark px-4 py-2 text-white focus:border-orange focus:outline-none focus:ring-1 focus:ring-orange">' +
        opts +
        '</select>' +
        '<p id="guest-meal-hint-' +
        index +
        '" class="mt-1 text-xs text-taupe-dark" aria-live="polite"></p>'
      );
    }

    function bindMealHints() {
      guestRowsEl.querySelectorAll('select[id^="guest-meal-"]').forEach(function (sel) {
        var idx = sel.id.replace('guest-meal-', '');
        var hint = document.getElementById('guest-meal-hint-' + idx);
        function update() {
          if (hint) hint.textContent = mealDetailsFor(sel.value);
        }
        sel.addEventListener('change', update);
        update();
      });
    }

    function renderGuestRow(index) {
      return (
        '<div class="guest-row" data-guest-index="' +
        index +
        '">' +
        '<p class="mb-3 text-sm font-semibold text-orange">Guest ' +
        (index + 1) +
        '</p>' +
        '<div class="space-y-3">' +
        '<div>' +
        '<label for="guest-name-' +
        index +
        '" class="mb-1 block text-sm font-medium text-white"><span class="text-red-500">*</span> Full name</label>' +
        '<input type="text" id="guest-name-' +
        index +
        '" name="guestName-' +
        index +
        '" required maxlength="' +
        maxNameLength +
        '" placeholder="Full name" class="w-full rounded-lg border border-taupe/30 bg-forest-dark px-4 py-2 text-white placeholder:text-taupe/60 focus:border-orange focus:outline-none focus:ring-1 focus:ring-orange" />' +
        '</div>' +
        '<div>' +
        '<label for="guest-meal-' +
        index +
        '" class="mb-1 block text-sm font-medium text-white"><span class="text-red-500">*</span> Meal choice</label>' +
        mealSelectHtml(index) +
        '</div>' +
        '<div>' +
        '<label for="guest-dietary-' +
        index +
        '" class="mb-1 block text-sm font-medium text-white">Dietary restrictions / allergies</label>' +
        '<textarea id="guest-dietary-' +
        index +
        '" name="guestDietary-' +
        index +
        '" maxlength="' +
        maxDietaryLength +
        '" rows="2" placeholder="Optional" class="w-full resize-y rounded-lg border border-taupe/30 bg-forest-dark px-4 py-2 text-white placeholder:text-taupe/60 focus:border-orange focus:outline-none focus:ring-1 focus:ring-orange"></textarea>' +
        '</div>' +
        '</div>' +
        '</div>'
      );
    }

    function syncGuestRows() {
      var count = parseInt(partySizeEl.value, 10) || 1;
      if (count < 1) count = 1;
      if (count > maxPartySize) count = maxPartySize;
      guestRowsEl.innerHTML = '';
      for (var i = 0; i < count; i++) {
        guestRowsEl.insertAdjacentHTML('beforeend', renderGuestRow(i));
      }
      bindMealHints();
    }

    partySizeEl.addEventListener('change', syncGuestRows);
    syncGuestRows();

    function updateHotelVisibility() {
      var needsYes = form.querySelector('input[name="needsHotel"]:checked');
      var show = needsYes && needsYes.value === 'yes';
      if (hotelWrap) {
        hotelWrap.classList.toggle('hidden', !show);
      }
    }

    form.querySelectorAll('input[name="needsHotel"]').forEach(function (el) {
      el.addEventListener('change', updateHotelVisibility);
    });
    updateHotelVisibility();

    function setCodeStatus(message, tone) {
      if (!codeStatus) return;
      codeStatus.textContent = message;
      codeStatus.classList.remove('text-red-500', 'text-green-600', 'text-taupe-dark');
      codeStatus.classList.add(
        tone === 'error' ? 'text-red-500' : tone === 'success' ? 'text-green-600' : 'text-taupe-dark'
      );
    }

    function limitPartySizeOptions(maxAllowed) {
      var options = partySizeEl.querySelectorAll('option');
      options.forEach(function (opt) {
        var n = parseInt(opt.value, 10);
        opt.disabled = n > maxAllowed;
        opt.hidden = n > maxAllowed;
      });
      partySizeEl.value = String(maxAllowed);
      if (partySizeMaxEl) partySizeMaxEl.textContent = String(maxAllowed);
    }

    function prefillExisting(data) {
      var existing = data.existingSubmission;
      if (!existing) return;

      var emailEl = document.getElementById('guest-email');
      if (emailEl && existing.email) emailEl.value = existing.email;

      if (existing.partySize >= 1 && existing.partySize <= allowedPartySize) {
        partySizeEl.value = String(existing.partySize);
      }

      var hotelValue = existing.needsHotel ? 'yes' : 'no';
      var hotelRadio = form.querySelector('input[name="needsHotel"][value="' + hotelValue + '"]');
      if (hotelRadio) hotelRadio.checked = true;
      updateHotelVisibility();

      syncGuestRows();
      var guests = data.guests || [];
      for (var i = 0; i < guests.length; i++) {
        var nameEl = document.getElementById('guest-name-' + i);
        var mealEl = document.getElementById('guest-meal-' + i);
        var dietaryEl = document.getElementById('guest-dietary-' + i);
        if (nameEl) nameEl.value = guests[i].name || '';
        if (mealEl) {
          mealEl.value = guests[i].mealChoice || '';
          mealEl.dispatchEvent(new Event('change'));
        }
        if (dietaryEl) dietaryEl.value = guests[i].dietary || '';
      }

      if (submitBtnText) submitBtnText.textContent = 'Update guest details';
      setCodeStatus(
        'Code verified — we found your earlier submission and loaded it below. Update anything and resubmit.',
        'success'
      );
    }

    function applyInviteData(data, code) {
      inviteVerified = true;
      verifiedCode = code;
      allowedPartySize = data.allowedPartySize;

      codeInput.disabled = true;
      if (codeVerifyBtn) codeVerifyBtn.classList.add('hidden');

      limitPartySizeOptions(allowedPartySize);
      syncGuestRows();

      if (data.existingSubmission) {
        prefillExisting(data);
      } else {
        setCodeStatus('Code verified! Fill in your details below.', 'success');
      }

      if (householdSection) householdSection.classList.remove('hidden');
      if (mealOptionsSection) mealOptionsSection.classList.remove('hidden');
      if (guestDetailsSection) guestDetailsSection.classList.remove('hidden');
      if (submitBtn) submitBtn.classList.remove('hidden');

      var emailEl = document.getElementById('guest-email');
      if (emailEl && !emailEl.value) emailEl.focus();
    }

    function postCheckCode(code, token) {
      fetch(apiUrl, {
        method: 'POST',
        body: JSON.stringify({
          action: 'checkcode',
          data: { code: code },
          recaptchaToken: token,
        }),
        headers: { 'Content-Type': 'text/plain;charset=utf-8' },
        redirect: 'follow',
      })
        .then(function (res) {
          return res.json();
        })
        .then(function (json) {
          isVerifying = false;
          codeInput.disabled = false;
          if (codeVerifyBtn) codeVerifyBtn.disabled = false;
          // v2 tokens are single-use — reset the widget so the guest can
          // complete it again for the actual submission (or a retry)
          if (guestV2WidgetId !== null && typeof grecaptcha !== 'undefined') {
            try {
              grecaptcha.reset(guestV2WidgetId);
            } catch (resetErr) {
              /* widget may not be rendered yet */
            }
          }
          if (json.success && json.data) {
            applyInviteData(json.data, code);
          } else if (json.recaptchaV2Required && recaptchaSiteKeyV2) {
            var wid = ensureGuestV2WidgetVisible();
            if (wid !== null && !isNaN(wid)) {
              guestV2Mode = true;
              setCodeStatus('Please complete the checkbox below, then press Verify.', 'info');
              return;
            }
            setCodeStatus(json.error || 'Verification failed. Please try again.', 'error');
          } else {
            setCodeStatus(
              json.error ||
                'We could not find that invite code. Please double-check it, or contact Hanna or Shuaib.',
              'error'
            );
          }
        })
        .catch(function () {
          isVerifying = false;
          codeInput.disabled = false;
          if (codeVerifyBtn) codeVerifyBtn.disabled = false;
          setCodeStatus('Network error while checking your code. Please try again.', 'error');
        });
    }

    function requestCodeVerify() {
      if (inviteVerified || isVerifying) return;

      var code = codeInput.value.replace(/\D/g, '');
      if (code.length !== 6) {
        setCodeStatus('Please enter all 6 digits of your invite code.', 'error');
        return;
      }
      if (!apiUrl) {
        setCodeStatus('Form is not configured. Set PUBLIC_WEDDING_FORMS_API_URL.', 'error');
        return;
      }
      if (typeof grecaptcha === 'undefined' || (!recaptchaSiteKey && !recaptchaSiteKeyV2)) {
        setCodeStatus('Spam protection could not load. Please refresh and try again.', 'error');
        return;
      }

      isVerifying = true;
      codeInput.disabled = true;
      if (codeVerifyBtn) codeVerifyBtn.disabled = true;
      setCodeStatus('Checking your code…', 'info');

      var useV2Token = !!recaptchaSiteKeyV2 && (!recaptchaSiteKey || guestV2Mode);
      if (useV2Token) {
        var v2id = getGuestV2WidgetId();
        var v2token = v2id !== null && !isNaN(v2id) ? grecaptcha.getResponse(v2id) : '';
        if (!v2token) {
          isVerifying = false;
          codeInput.disabled = false;
          if (codeVerifyBtn) codeVerifyBtn.disabled = false;
          ensureGuestV2WidgetVisible();
          setCodeStatus('Please complete the checkbox below, then press Verify.', 'error');
          return;
        }
        postCheckCode(code, v2token);
        return;
      }

      grecaptcha.ready(function () {
        grecaptcha
          .execute(recaptchaSiteKey, { action: 'wedding_check_code' })
          .then(function (token) {
            if (!token) {
              isVerifying = false;
              codeInput.disabled = false;
              if (codeVerifyBtn) codeVerifyBtn.disabled = false;
              setCodeStatus('Spam protection check failed. Please try again.', 'error');
              return;
            }
            postCheckCode(code, token);
          })
          .catch(function () {
            isVerifying = false;
            codeInput.disabled = false;
            if (codeVerifyBtn) codeVerifyBtn.disabled = false;
            setCodeStatus('Spam protection check failed. Please try again.', 'error');
          });
      });
    }

    // Digits only; auto-verify as soon as the 6th digit is typed or pasted
    codeInput.addEventListener('input', function () {
      var digits = codeInput.value.replace(/\D/g, '').slice(0, 6);
      if (codeInput.value !== digits) codeInput.value = digits;
      if (digits.length < 6) {
        setCodeStatus('', 'info');
        return;
      }
      requestCodeVerify();
    });

    codeInput.addEventListener('keydown', function (e) {
      if (e.key === 'Enter') {
        e.preventDefault();
        requestCodeVerify();
      }
    });

    if (codeVerifyBtn) {
      codeVerifyBtn.addEventListener('click', requestCodeVerify);
    }

    // Prefill + auto-verify from ?code=123211 (invite deep links)
    (function tryAutofillFromUrl() {
      var params;
      try {
        params = new URLSearchParams(window.location.search);
      } catch (err) {
        return;
      }
      var codeParam = String(params.get('code') || '')
        .replace(/\D/g, '')
        .slice(0, 6);
      if (codeParam.length !== 6) return;

      codeInput.value = codeParam;
      setCodeStatus('Checking your invite code…', 'info');

      function startVerify() {
        requestCodeVerify();
      }

      if (typeof grecaptcha !== 'undefined') {
        startVerify();
        return;
      }

      // Wait briefly for the reCAPTCHA script to load
      var tries = 0;
      var timer = setInterval(function () {
        tries += 1;
        if (typeof grecaptcha !== 'undefined') {
          clearInterval(timer);
          startVerify();
        } else if (tries >= 40) {
          clearInterval(timer);
          setCodeStatus('Spam protection could not load. Please refresh and try again.', 'error');
        }
      }, 250);
    })();

    function getGuestV2WidgetId() {
      if (guestV2WidgetId !== null) return guestV2WidgetId;
      var wrap = document.getElementById('guest-recaptcha-v2-wrap');
      if (!wrap || !recaptchaSiteKeyV2 || typeof grecaptcha === 'undefined') return null;
      guestV2WidgetId = grecaptcha.render(wrap, { sitekey: recaptchaSiteKeyV2 });
      return guestV2WidgetId;
    }

    function ensureGuestV2WidgetVisible() {
      var wrap = document.getElementById('guest-recaptcha-v2-wrap');
      if (wrap) {
        wrap.classList.remove('hidden');
        wrap.setAttribute('aria-hidden', 'false');
      }
      return getGuestV2WidgetId();
    }

    function collectGuests(count) {
      var guests = [];
      for (var i = 0; i < count; i++) {
        var nameEl = document.getElementById('guest-name-' + i);
        var mealEl = document.getElementById('guest-meal-' + i);
        var dietaryEl = document.getElementById('guest-dietary-' + i);
        var name = nameEl ? nameEl.value.trim() : '';
        var mealChoice = mealEl ? mealEl.value : '';
        var dietary = dietaryEl ? dietaryEl.value.trim() : '';
        if (!name || !mealChoice) return null;
        guests.push({ name: name, mealChoice: mealChoice, dietary: dietary });
      }
      return guests;
    }

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var gotcha = document.getElementById('guest-gotcha');
      // Checkbox honeypot — only bots typically check it; ignore autofill on text fields
      if (gotcha && gotcha.checked) return;

      // Always reset button/spinner so a prior failed attempt cannot leave the form stuck
      if (submitBtn) submitBtn.disabled = false;
      if (statusSpinner) statusSpinner.style.display = 'none';

      function failValidation(msg, focusEl) {
        if (statusSpinner) statusSpinner.style.display = 'none';
        if (statusText) {
          statusText.textContent = msg;
          statusText.classList.remove('text-green-600', 'text-taupe-dark');
          statusText.classList.add('text-red-500');
        }
        if (submitBtn) submitBtn.disabled = false;
        if (focusEl && typeof focusEl.focus === 'function') {
          try {
            focusEl.focus();
          } catch (focusErr) {
            /* ignore */
          }
        }
      }

      if (!inviteVerified || !verifiedCode) {
        failValidation('Please enter your 6-digit invite code first.', codeInput);
        return;
      }

      var emailEl = document.getElementById('guest-email');
      var email = emailEl ? emailEl.value.trim() : '';
      var partySize = parseInt(partySizeEl.value, 10) || 0;
      var needsHotelEl = form.querySelector('input[name="needsHotel"]:checked');
      var needsHotel = needsHotelEl && needsHotelEl.value === 'yes';

      if (!email) {
        failValidation('Please enter your email.', emailEl);
        return;
      }

      var guests = collectGuests(partySize);
      if (!guests || guests.length !== partySize) {
        failValidation('Please complete a name and meal choice for each guest.', document.getElementById('guest-name-0'));
        return;
      }

      if (!recaptchaSiteKey && !recaptchaSiteKeyV2) {
        failValidation('Form is not configured. Set reCAPTCHA keys.');
        return;
      }
      if (!apiUrl) {
        failValidation('Form is not configured. Set PUBLIC_WEDDING_FORMS_API_URL.');
        return;
      }

      if (submitBtn) submitBtn.disabled = true;
      if (statusSpinner) statusSpinner.style.display = 'block';
      if (statusText) {
        statusText.textContent = 'Submitting…';
        statusText.classList.remove('text-red-500', 'text-green-600');
      }

      function failGuest(msg) {
        failValidation(msg);
      }

      if (typeof grecaptcha === 'undefined') {
        failGuest('Spam protection could not load. Please refresh and try again.');
        return;
      }

      function handleGuestJson(json) {
        if (statusSpinner) statusSpinner.style.display = 'none';
        if (json.success) {
          guestV2Mode = false;
          if (statusText) {
            statusText.textContent = json.message || 'Thank you! A confirmation email has been sent.';
            statusText.classList.remove('text-red-500', 'text-taupe-dark');
            statusText.classList.add('text-green-600');
          }
          form.style.display = 'none';
          var v2w = document.getElementById('guest-recaptcha-v2-wrap');
          if (v2w) {
            v2w.classList.add('hidden');
            v2w.setAttribute('aria-hidden', 'true');
          }
        } else {
          if (json.recaptchaV2Required && recaptchaSiteKeyV2) {
            var wid = ensureGuestV2WidgetVisible();
            if (wid !== null && !isNaN(wid)) {
              guestV2Mode = true;
              if (statusText) {
                statusText.textContent = json.error || 'Complete the checkbox below, then submit again.';
                statusText.classList.remove('text-red-500', 'text-green-600');
                statusText.classList.add('text-taupe-dark');
              }
              if (submitBtn) submitBtn.disabled = false;
              return;
            }
          }
          if (statusText) {
            statusText.textContent = json.error || 'Something went wrong.';
            statusText.classList.add('text-red-500');
          }
          if (submitBtn) submitBtn.disabled = false;
        }
      }

      function postGuest(token) {
        // Re-read email at send time so a late edit is never lost
        var latestEmail = emailEl ? emailEl.value.trim() : email;
        var payload = {
          action: 'guestdetails',
          data: {
            email: latestEmail,
            inviteCode: verifiedCode,
            partySize: partySize,
            needsHotel: needsHotel,
            guests: guests,
          },
          recaptchaToken: token,
        };

        fetch(apiUrl, {
          method: 'POST',
          body: JSON.stringify(payload),
          headers: { 'Content-Type': 'text/plain;charset=utf-8' },
          redirect: 'follow',
        })
          .then(function (res) {
            return res.json();
          })
          .then(handleGuestJson)
          .catch(function (err) {
            failGuest(err.message || 'Network error. Please try again.');
          });
      }

      var useV2Token = !!recaptchaSiteKeyV2 && (!recaptchaSiteKey || guestV2Mode);
      if (useV2Token) {
        var v2id = getGuestV2WidgetId();
        if (v2id === null || isNaN(v2id)) {
          failGuest('Spam protection could not load. Please refresh and try again.');
          return;
        }
        var v2token = grecaptcha.getResponse(v2id);
        if (!v2token) {
          failGuest('Please complete the checkbox below, then submit again.');
          return;
        }
        postGuest(v2token);
        return;
      }

      grecaptcha.ready(function () {
        grecaptcha
          .execute(recaptchaSiteKey, { action: 'wedding_guest_details' })
          .then(function (token) {
            if (!token) {
              failGuest('Spam protection check failed. Please try again.');
              return;
            }
            postGuest(token);
          })
          .catch(function () {
            failGuest('Spam protection check failed. Please try again.');
          });
      });
    });
  })();
</script>
