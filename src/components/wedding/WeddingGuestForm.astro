---
import { mealOptions, guestFormLimits } from '../../data/wedding';

const {
  apiUrl,
  recaptchaSiteKey = '',
  recaptchaSiteKeyV2 = '',
  includeRecaptchaScript = true,
} = Astro.props;

const showV2Initially = !recaptchaSiteKey && !!recaptchaSiteKeyV2;
const mealOptionsJson = JSON.stringify(mealOptions);
---

<form id="guest-details-form" class="space-y-6" novalidate>
  <input type="text" name="_gotcha" id="guest-gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" class="absolute left-[-9999px]" />

  <p class="text-sm text-taupe">
    Fields marked with <span class="text-red-500 font-medium">*</span> are required. One submission per household — include everyone attending with you.
  </p>

  <div>
    <label for="guest-email" class="mb-1 block font-medium text-white">
      <span class="text-red-500">*</span> Your email
    </label>
    <input
      type="email"
      id="guest-email"
      name="email"
      required
      maxlength={guestFormLimits.maxEmailLength}
      placeholder="you@example.com"
      class="w-full rounded-lg border border-taupe/30 bg-forest-dark px-4 py-2 text-white placeholder:text-taupe/60 focus:border-orange focus:outline-none focus:ring-1 focus:ring-orange"
    />
    <p class="mt-1 text-xs text-taupe">We'll send a copy of your submission to this address.</p>
  </div>

  <div>
    <label for="party-size" class="mb-1 block font-medium text-white">
      <span class="text-red-500">*</span> How many people are attending (including you)?
    </label>
    <select
      id="party-size"
      name="partySize"
      required
      class="w-full rounded-lg border border-taupe/30 bg-forest-dark px-4 py-2 text-white focus:border-orange focus:outline-none focus:ring-1 focus:ring-orange"
    >
      {
        Array.from({ length: guestFormLimits.maxPartySize }, (_, i) => i + 1).map((n) => (
          <option value={n}>{n}</option>
        ))
      }
    </select>
  </div>

  <fieldset class="space-y-3">
    <legend class="mb-1 font-medium text-white">
      <span class="text-red-500">*</span> Will you need a hotel room?
    </legend>
    <div class="flex flex-wrap gap-4">
      <label class="flex cursor-pointer items-center gap-2">
        <input type="radio" name="needsHotel" value="no" class="h-4 w-4 accent-orange" checked />
        <span class="text-taupe-light">No</span>
      </label>
      <label class="flex cursor-pointer items-center gap-2">
        <input type="radio" name="needsHotel" value="yes" class="h-4 w-4 accent-orange" />
        <span class="text-taupe-light">Yes</span>
      </label>
    </div>
  </fieldset>

  <div id="hotel-rooms-wrap" class="hidden">
    <label for="hotel-rooms" class="mb-1 block font-medium text-white">
      <span class="text-red-500">*</span> How many rooms do you need?
    </label>
    <p class="mb-2 text-sm text-taupe">
      Hanna &amp; Shuaib will forward you information about hotel booking once Hanna figures it out.
    </p>
    <select
      id="hotel-rooms"
      name="hotelRooms"
      class="w-full rounded-lg border border-taupe/30 bg-forest-dark px-4 py-2 text-white focus:border-orange focus:outline-none focus:ring-1 focus:ring-orange"
    >
      {
        Array.from({ length: guestFormLimits.maxHotelRooms }, (_, i) => i + 1).map((n) => (
          <option value={n}>{n}</option>
        ))
      }
    </select>
  </div>

  <div>
    <h3 class="font-heading mb-3 text-lg font-semibold text-white">Guest details</h3>
    <div id="guest-rows" class="space-y-4" role="group" aria-label="Guest list"></div>
  </div>

  <div id="recaptcha-wrap" class="min-h-0" aria-hidden="true"></div>
  {
    recaptchaSiteKeyV2 && (
      <div
        id="guest-recaptcha-v2-wrap"
        class:list={['flex justify-center', showV2Initially ? '' : 'hidden']}
        aria-hidden={showV2Initially ? 'false' : 'true'}
      />
    )
  }

  <button
    type="submit"
    id="guest-submit-btn"
    class="w-full rounded-lg bg-orange px-4 py-3 font-semibold text-white hover:bg-orange-dark focus:outline-none focus:ring-2 focus:ring-orange disabled:cursor-not-allowed disabled:opacity-70"
  >
    Submit guest details
  </button>
</form>

<div id="guest-status" class="mt-4 min-h-[1.5em] flex flex-col items-center justify-center gap-2 text-center font-medium" aria-live="polite">
  <span id="guest-status-spinner" class="guest-submit-spinner h-10 w-10 rounded-full border-2 border-sage-dark border-t-orange" aria-hidden="true" style="display: none;"></span>
  <span id="guest-status-text"></span>
</div>

<p class="mt-6 text-sm text-taupe">
  This site is protected by reCAPTCHA and the Google
  <a href="https://policies.google.com/privacy" class="text-orange hover:text-orange-light" rel="noopener noreferrer">Privacy Policy</a>
  and
  <a href="https://policies.google.com/terms" class="text-orange hover:text-orange-light" rel="noopener noreferrer">Terms of Service</a>
  apply.
</p>

<style>
  .guest-submit-spinner {
    border-top-color: var(--theme-orange);
    animation: guest-spin 0.8s linear infinite;
  }
  @keyframes guest-spin {
    to {
      transform: rotate(360deg);
    }
  }
  .guest-row {
    border: 1px solid color-mix(in srgb, var(--theme-taupe) 30%, transparent);
    border-radius: 0.5rem;
    padding: 1rem;
    background: color-mix(in srgb, var(--theme-forest-dark) 50%, transparent);
  }
</style>

{
  includeRecaptchaScript && (recaptchaSiteKey || recaptchaSiteKeyV2) && (
    <script
      src={
        recaptchaSiteKey
          ? `https://www.google.com/recaptcha/api.js?render=${recaptchaSiteKey}`
          : 'https://www.google.com/recaptcha/api.js'
      }
      async
      defer
    />
  )
}

<script
  define:vars={{
    apiUrl,
    recaptchaSiteKey,
    recaptchaSiteKeyV2,
    mealOptionsJson,
    maxPartySize: guestFormLimits.maxPartySize,
    maxNameLength: guestFormLimits.maxNameLength,
    maxDietaryLength: guestFormLimits.maxDietaryLength,
  }}
>
  (function () {
    var mealOptions = JSON.parse(mealOptionsJson);
    var form = document.getElementById('guest-details-form');
    var partySizeEl = document.getElementById('party-size');
    var guestRowsEl = document.getElementById('guest-rows');
    var hotelWrap = document.getElementById('hotel-rooms-wrap');
    var submitBtn = document.getElementById('guest-submit-btn');
    var statusSpinner = document.getElementById('guest-status-spinner');
    var statusText = document.getElementById('guest-status-text');
    var guestV2Mode = false;
    var guestV2WidgetId = null;

    if (!form || !partySizeEl || !guestRowsEl) return;

    function escapeHtml(s) {
      return String(s)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function mealDetailsFor(value) {
      var match = mealOptions.find(function (m) {
        return m.value === value;
      });
      return match && match.details ? match.details : '';
    }

    function mealSelectHtml(index) {
      var opts = mealOptions
        .map(function (m) {
          var label = m.label + (m.description ? ' — ' + m.description : '');
          return (
            '<option value="' +
            escapeHtml(m.value) +
            '">' +
            escapeHtml(label) +
            '</option>'
          );
        })
        .join('');
      return (
        '<select id="guest-meal-' +
        index +
        '" name="guestMeal-' +
        index +
        '" required class="w-full rounded-lg border border-taupe/30 bg-forest-dark px-4 py-2 text-white focus:border-orange focus:outline-none focus:ring-1 focus:ring-orange">' +
        opts +
        '</select>' +
        '<p id="guest-meal-hint-' +
        index +
        '" class="mt-1 text-xs text-taupe-light" aria-live="polite"></p>'
      );
    }

    function bindMealHints() {
      guestRowsEl.querySelectorAll('select[id^="guest-meal-"]').forEach(function (sel) {
        var idx = sel.id.replace('guest-meal-', '');
        var hint = document.getElementById('guest-meal-hint-' + idx);
        function update() {
          if (hint) hint.textContent = mealDetailsFor(sel.value);
        }
        sel.addEventListener('change', update);
        update();
      });
    }

    function renderGuestRow(index) {
      return (
        '<div class="guest-row" data-guest-index="' +
        index +
        '">' +
        '<p class="mb-3 text-sm font-semibold text-orange">Guest ' +
        (index + 1) +
        '</p>' +
        '<div class="space-y-3">' +
        '<div>' +
        '<label for="guest-name-' +
        index +
        '" class="mb-1 block text-sm font-medium text-white"><span class="text-red-500">*</span> Full name</label>' +
        '<input type="text" id="guest-name-' +
        index +
        '" name="guestName-' +
        index +
        '" required maxlength="' +
        maxNameLength +
        '" placeholder="Full name" class="w-full rounded-lg border border-taupe/30 bg-forest-dark px-4 py-2 text-white placeholder:text-taupe/60 focus:border-orange focus:outline-none focus:ring-1 focus:ring-orange" />' +
        '</div>' +
        '<div>' +
        '<label for="guest-meal-' +
        index +
        '" class="mb-1 block text-sm font-medium text-white"><span class="text-red-500">*</span> Meal choice</label>' +
        mealSelectHtml(index) +
        '</div>' +
        '<div>' +
        '<label for="guest-dietary-' +
        index +
        '" class="mb-1 block text-sm font-medium text-white">Dietary restrictions / allergies</label>' +
        '<textarea id="guest-dietary-' +
        index +
        '" name="guestDietary-' +
        index +
        '" maxlength="' +
        maxDietaryLength +
        '" rows="2" placeholder="Optional" class="w-full resize-y rounded-lg border border-taupe/30 bg-forest-dark px-4 py-2 text-white placeholder:text-taupe/60 focus:border-orange focus:outline-none focus:ring-1 focus:ring-orange"></textarea>' +
        '</div>' +
        '</div>' +
        '</div>'
      );
    }

    function syncGuestRows() {
      var count = parseInt(partySizeEl.value, 10) || 1;
      if (count < 1) count = 1;
      if (count > maxPartySize) count = maxPartySize;
      guestRowsEl.innerHTML = '';
      for (var i = 0; i < count; i++) {
        guestRowsEl.insertAdjacentHTML('beforeend', renderGuestRow(i));
      }
      bindMealHints();
    }

    partySizeEl.addEventListener('change', syncGuestRows);
    syncGuestRows();

    function updateHotelVisibility() {
      var needsYes = form.querySelector('input[name="needsHotel"]:checked');
      var show = needsYes && needsYes.value === 'yes';
      if (hotelWrap) {
        hotelWrap.classList.toggle('hidden', !show);
      }
      var hotelRooms = document.getElementById('hotel-rooms');
      if (hotelRooms) hotelRooms.required = !!show;
    }

    form.querySelectorAll('input[name="needsHotel"]').forEach(function (el) {
      el.addEventListener('change', updateHotelVisibility);
    });
    updateHotelVisibility();

    function getGuestV2WidgetId() {
      if (guestV2WidgetId !== null) return guestV2WidgetId;
      var wrap = document.getElementById('guest-recaptcha-v2-wrap');
      if (!wrap || !recaptchaSiteKeyV2 || typeof grecaptcha === 'undefined') return null;
      guestV2WidgetId = grecaptcha.render(wrap, { sitekey: recaptchaSiteKeyV2 });
      return guestV2WidgetId;
    }

    function ensureGuestV2WidgetVisible() {
      var wrap = document.getElementById('guest-recaptcha-v2-wrap');
      if (wrap) {
        wrap.classList.remove('hidden');
        wrap.setAttribute('aria-hidden', 'false');
      }
      return getGuestV2WidgetId();
    }

    function collectGuests(count) {
      var guests = [];
      for (var i = 0; i < count; i++) {
        var nameEl = document.getElementById('guest-name-' + i);
        var mealEl = document.getElementById('guest-meal-' + i);
        var dietaryEl = document.getElementById('guest-dietary-' + i);
        var name = nameEl ? nameEl.value.trim() : '';
        var mealChoice = mealEl ? mealEl.value : '';
        var dietary = dietaryEl ? dietaryEl.value.trim() : '';
        if (!name || !mealChoice) return null;
        guests.push({ name: name, mealChoice: mealChoice, dietary: dietary });
      }
      return guests;
    }

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var gotcha = document.getElementById('guest-gotcha');
      if (gotcha && gotcha.value) return;

      var emailEl = document.getElementById('guest-email');
      var email = emailEl ? emailEl.value.trim() : '';
      var partySize = parseInt(partySizeEl.value, 10) || 0;
      var needsHotelEl = form.querySelector('input[name="needsHotel"]:checked');
      var needsHotel = needsHotelEl && needsHotelEl.value === 'yes';
      var hotelRoomsEl = document.getElementById('hotel-rooms');
      var hotelRooms = needsHotel && hotelRoomsEl ? parseInt(hotelRoomsEl.value, 10) : 0;

      if (!email) {
        if (statusText) {
          statusText.textContent = 'Please enter your email.';
          statusText.classList.add('text-red-500');
        }
        return;
      }

      var guests = collectGuests(partySize);
      if (!guests || guests.length !== partySize) {
        if (statusText) {
          statusText.textContent = 'Please complete a name and meal choice for each guest.';
          statusText.classList.add('text-red-500');
        }
        return;
      }

      if (!recaptchaSiteKey && !recaptchaSiteKeyV2) {
        if (statusText) {
          statusText.textContent = 'Form is not configured. Set reCAPTCHA keys.';
          statusText.classList.add('text-red-500');
        }
        return;
      }
      if (!apiUrl) {
        if (statusText) {
          statusText.textContent = 'Form is not configured. Set PUBLIC_WEDDING_FORMS_API_URL.';
          statusText.classList.add('text-red-500');
        }
        return;
      }

      submitBtn.disabled = true;
      if (statusSpinner) statusSpinner.style.display = 'block';
      if (statusText) {
        statusText.textContent = 'Submitting…';
        statusText.classList.remove('text-red-500', 'text-green-600');
      }

      function failGuest(msg) {
        if (statusSpinner) statusSpinner.style.display = 'none';
        if (statusText) {
          statusText.textContent = msg;
          statusText.classList.add('text-red-500');
        }
        submitBtn.disabled = false;
      }

      if (typeof grecaptcha === 'undefined') {
        failGuest('Spam protection could not load. Please refresh and try again.');
        return;
      }

      function handleGuestJson(json) {
        if (statusSpinner) statusSpinner.style.display = 'none';
        if (json.success) {
          guestV2Mode = false;
          if (statusText) {
            statusText.textContent = json.message || 'Thank you! A confirmation email has been sent.';
            statusText.classList.remove('text-red-500', 'text-taupe');
            statusText.classList.add('text-green-600');
          }
          form.style.display = 'none';
          var v2w = document.getElementById('guest-recaptcha-v2-wrap');
          if (v2w) {
            v2w.classList.add('hidden');
            v2w.setAttribute('aria-hidden', 'true');
          }
        } else {
          if (json.recaptchaV2Required && recaptchaSiteKeyV2) {
            var wid = ensureGuestV2WidgetVisible();
            if (wid !== null && !isNaN(wid)) {
              guestV2Mode = true;
              if (statusText) {
                statusText.textContent = json.error || 'Complete the checkbox below, then submit again.';
                statusText.classList.remove('text-red-500', 'text-green-600');
                statusText.classList.add('text-taupe');
              }
              submitBtn.disabled = false;
              return;
            }
          }
          if (statusText) {
            statusText.textContent = json.error || 'Something went wrong.';
            statusText.classList.add('text-red-500');
          }
          submitBtn.disabled = false;
        }
      }

      function postGuest(token) {
        var payload = {
          action: 'guestdetails',
          data: {
            email: email,
            partySize: partySize,
            needsHotel: needsHotel,
            hotelRooms: needsHotel ? hotelRooms : 0,
            guests: guests,
          },
          recaptchaToken: token,
        };

        fetch(apiUrl, {
          method: 'POST',
          body: JSON.stringify(payload),
          headers: { 'Content-Type': 'text/plain;charset=utf-8' },
          redirect: 'follow',
        })
          .then(function (res) {
            return res.json();
          })
          .then(handleGuestJson)
          .catch(function (err) {
            failGuest(err.message || 'Network error. Please try again.');
          });
      }

      var useV2Token = !!recaptchaSiteKeyV2 && (!recaptchaSiteKey || guestV2Mode);
      if (useV2Token) {
        var v2id = getGuestV2WidgetId();
        if (v2id === null || isNaN(v2id)) {
          failGuest('Spam protection could not load. Please refresh and try again.');
          return;
        }
        var v2token = grecaptcha.getResponse(v2id);
        if (!v2token) {
          failGuest('Please complete the checkbox below, then submit again.');
          return;
        }
        postGuest(v2token);
        return;
      }

      grecaptcha.ready(function () {
        grecaptcha
          .execute(recaptchaSiteKey, { action: 'wedding_guest_details' })
          .then(function (token) {
            if (!token) {
              failGuest('Spam protection check failed. Please try again.');
              return;
            }
            postGuest(token);
          })
          .catch(function () {
            failGuest('Spam protection check failed. Please try again.');
          });
      });
    });
  })();
</script>
