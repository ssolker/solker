---
import { weddingMeta } from '../../data/wedding';
import WeddingCountdown from './WeddingCountdown.astro';

interface Props {
  showCountdown?: boolean;
}

const { showCountdown = false } = Astro.props;

const BACKGROUND_OPTIONS = [
  '#203A31',
  '#3E5F4B',
  '#7E4A35',
  '#5c5248',
  '#2D5247',
  '#5A7D66',
  '#152820',
  '#2E4738',
  '#BC6439',
];

const globs = [
  import.meta.glob<{ default: string }>('../../assets/wedding/*.jpg', { eager: true }),
  import.meta.glob<{ default: string }>('../../assets/wedding/*.jpeg', { eager: true }),
  import.meta.glob<{ default: string }>('../../assets/wedding/*.png', { eager: true }),
  import.meta.glob<{ default: string }>('../../assets/wedding/*.webp', { eager: true }),
];

function getUrl(m: unknown): string {
  if (typeof m === 'string') return m;
  const d = (m as { default?: string | { src?: string } }).default;
  return typeof d === 'string' ? d : (d?.src ?? '');
}

type Entry = { path: string; url: string };
const allEntries: Entry[] = globs
  .flatMap((g) =>
    Object.entries(g)
      .map(([path, mod]) => ({ path, url: getUrl(mod) }))
      .filter((e) => e.url)
  )
  .filter((e, i, arr) => arr.findIndex((x) => x.url === e.url) === i);

function filename(path: string): string {
  return path.split('/').pop()?.toLowerCase() ?? '';
}

// Always show imddle.jpg (the "middle" photo) first, then rotate through the
// rest in a deterministic (alphabetical) order.
const seedEntry = allEntries.find((e) => filename(e.path).includes('imddle'));
const restEntries = allEntries
  .filter((e) => e !== seedEntry)
  .sort((a, b) => filename(a.path).localeCompare(filename(b.path)));
const orderedEntries = seedEntry ? [seedEntry, ...restEntries] : restEntries;

const photoUrls = orderedEntries.map((e) => e.url);
const primaryPhoto = photoUrls[0] ?? '';

// Drifting autumn leaves over the photo. Values are hand-picked so leaves are
// spread out and never fall in sync.
const LEAF_COLORS = ['#BC6439', '#D4845A', '#7E4A35', '#9E6B52', '#c97a4a'];
const fallingLeaves = [
  { left: 6, size: 18, duration: 13, delay: 0, sway: 1 },
  { left: 18, size: 24, duration: 17, delay: 4, sway: -1 },
  { left: 31, size: 15, duration: 14, delay: 9, sway: 1 },
  { left: 44, size: 21, duration: 19, delay: 2, sway: -1 },
  { left: 55, size: 17, duration: 15, delay: 12, sway: 1 },
  { left: 67, size: 26, duration: 18, delay: 6, sway: -1 },
  { left: 78, size: 16, duration: 13.5, delay: 15, sway: 1 },
  { left: 90, size: 22, duration: 16, delay: 8, sway: -1 },
].map((leaf, i) => ({ ...leaf, color: LEAF_COLORS[i % LEAF_COLORS.length] }));
---

<aside
  class="relative h-svh w-full shrink-0 lg:sticky lg:top-0 lg:h-screen lg:w-[55vw] lg:self-start"
  aria-label="Wedding photos"
>
  {
    primaryPhoto ? (
      <div class="absolute inset-0" data-photo-rotator>
        <img
          id="wedding-photo-a"
          src={primaryPhoto}
          alt=""
          class="absolute inset-0 h-full w-full object-cover opacity-100 transition-opacity duration-1000 ease-in-out"
          loading="eager"
          decoding="async"
        />
        <img
          id="wedding-photo-b"
          src=""
          alt=""
          class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-1000 ease-in-out"
          decoding="async"
          aria-hidden="true"
        />
      </div>
    ) : (
      <div class="h-full w-full bg-forest" aria-hidden="true" />
    )
  }
  <div
    class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/30 to-black/20 lg:bg-gradient-to-r lg:from-black/40 lg:via-black/20 lg:to-black/50"
    aria-hidden="true"
  />
  <div class="wedding-leaves pointer-events-none absolute inset-0 z-10 overflow-hidden" aria-hidden="true">
    {
      fallingLeaves.map((leaf) => (
        <span
          class="wedding-falling-leaf"
          style={`left:${leaf.left}%;--leaf-duration:${leaf.duration}s;--leaf-delay:${leaf.delay}s;--leaf-sway:${leaf.sway};color:${leaf.color};`}
        >
          <svg width={leaf.size} height={leaf.size} viewBox="0 0 24 24" fill="currentColor">
            <path d="M17 8C8 10 5.9 16.17 3.82 21.34l1.89.66.95-2.3c.48.17.98.3 1.34.3C19 20 22 3 22 3c-1 2-8 2.25-13 3.25S2 11.5 2 13.5s1.75 3.75 1.75 3.75C7 8 17 8 17 8z" />
          </svg>
        </span>
      ))
    }
  </div>
  <div class="absolute left-4 top-4 z-20 lg:left-6 lg:top-6">
    <slot name="menu" />
  </div>
  <div class="absolute inset-0 flex flex-col items-center justify-center px-6 text-center">
    <h1 class="font-heading text-4xl font-bold leading-tight text-white-constant drop-shadow-lg md:text-5xl lg:text-6xl">
      {weddingMeta.headline}
    </h1>
    <p class="mt-6 font-heading text-xl font-semibold text-white-constant drop-shadow md:text-2xl lg:text-3xl">
      {weddingMeta.dateLabel}
    </p>
    <p class="mt-2 font-heading text-xl font-semibold text-white-constant drop-shadow md:text-2xl lg:text-3xl">
      {weddingMeta.locationLabel}
    </p>
    {showCountdown && <WeddingCountdown />}
    <button
      type="button"
      id="wedding-scroll-down"
      class="mt-8 flex h-11 w-11 animate-bounce items-center justify-center rounded-full bg-black/40 text-white-constant shadow-lg shadow-black/20 backdrop-blur-sm transition hover:bg-black/60 focus:outline-none focus:ring-2 focus:ring-orange lg:hidden"
      aria-label="Scroll down to see more"
    >
      <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
      </svg>
    </button>
  </div>
</aside>

<style>
  .wedding-falling-leaf {
    position: absolute;
    top: -32px;
    animation: wedding-leaf-fall var(--leaf-duration, 15s) linear var(--leaf-delay, 0s) infinite;
    filter: drop-shadow(0 1px 2px rgb(0 0 0 / 0.35));
  }
  .wedding-falling-leaf svg {
    animation: wedding-leaf-sway calc(var(--leaf-duration, 15s) / 4) ease-in-out infinite alternate;
  }

  @keyframes wedding-leaf-fall {
    0% {
      transform: translateY(0) rotate(0deg);
      opacity: 0;
    }
    6% {
      opacity: 0.85;
    }
    90% {
      opacity: 0.85;
    }
    100% {
      transform: translateY(110vh) rotate(calc(300deg * var(--leaf-sway, 1)));
      opacity: 0;
    }
  }

  @keyframes wedding-leaf-sway {
    from {
      transform: translateX(calc(-22px * var(--leaf-sway, 1))) rotate(-12deg);
    }
    to {
      transform: translateX(calc(22px * var(--leaf-sway, 1))) rotate(12deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wedding-leaves {
      display: none;
    }
  }
</style>

<script>
  const scrollBtn = document.getElementById('wedding-scroll-down');
  const panel = scrollBtn?.closest('aside');
  if (scrollBtn && panel) {
    scrollBtn.addEventListener('click', () => {
      window.scrollTo({ top: panel.offsetHeight, behavior: 'smooth' });
    });
  }
</script>

{
  !primaryPhoto && (
    <script define:vars={{ backgroundOptions: BACKGROUND_OPTIONS }}>
      const panel = document.querySelector('[aria-label="Wedding photos"]');
      if (panel instanceof HTMLElement) {
        const color = backgroundOptions[Math.floor(Math.random() * backgroundOptions.length)];
        panel.style.background = color;
      }
    </script>
  )
}

{
  primaryPhoto && photoUrls.length > 1 && (
    <script define:vars={{ photoUrls, rotateMs: 10000 }}>
      (function () {
        var urls = photoUrls;
        var a = document.getElementById('wedding-photo-a');
        var b = document.getElementById('wedding-photo-b');
        if (!a || !b || urls.length < 2) return;

        // Always start on the first image (imddle / middle), then rotate.
        var idx = 0;
        var front = a;
        var back = b;

        // Preload all images so crossfades are smooth.
        urls.forEach(function (u) {
          var img = new Image();
          img.src = u;
        });

        function advance() {
          idx = (idx + 1) % urls.length;
          var nextUrl = urls[idx];
          var loader = new Image();
          loader.onload = function () {
            back.src = nextUrl;
            back.style.opacity = '1';
            front.style.opacity = '0';
            var tmp = front;
            front = back;
            back = tmp;
          };
          loader.src = nextUrl;
        }

        window.setInterval(advance, rotateMs);
      })();
    </script>
  )
}
