---
interface Props {
  id: string;
  title: string;
  variant?: 'default' | 'muted';
}
const { id, title, variant = 'default' } = Astro.props;
const sectionClass =
  variant === 'muted'
    ? 'bg-sage-light/40 py-6 md:py-8 -mx-4 px-4 lg:-mx-10 lg:px-10'
    : 'py-6 md:py-8';
---

<section id={id} class={`${sectionClass} wedding-reveal`} aria-labelledby={`${id}-heading`}>
  <h2
    id={`${id}-heading`}
    class="font-heading mb-3 flex items-center gap-2.5 text-2xl font-bold text-white md:text-3xl"
  >
    <span class="wedding-leaf text-orange" aria-hidden="true">
      <svg class="h-6 w-6 md:h-7 md:w-7" viewBox="0 0 24 24" fill="currentColor">
        <path d="M17 8C8 10 5.9 16.17 3.82 21.34l1.89.66.95-2.3c.48.17.98.3 1.34.3C19 20 22 3 22 3c-1 2-8 2.25-13 3.25S2 11.5 2 13.5s1.75 3.75 1.75 3.75C7 8 17 8 17 8z" />
      </svg>
    </span>
    {title}
  </h2>
  <div class="wedding-section-body text-base leading-relaxed text-taupe-dark">
    <slot />
  </div>
</section>
