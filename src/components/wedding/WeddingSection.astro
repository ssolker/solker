---
interface Props {
  id: string;
  title: string;
  variant?: 'default' | 'muted';
}
const { id, title, variant = 'default' } = Astro.props;
const sectionClass =
  variant === 'muted'
    ? 'bg-sage-light/40 py-6 md:py-8 -mx-4 px-4 lg:-mx-10 lg:px-10'
    : 'py-6 md:py-8';
---

<section id={id} class={sectionClass} aria-labelledby={`${id}-heading`}>
  <h2 id={`${id}-heading`} class="font-heading mb-3 text-2xl font-bold text-white md:text-3xl">
    {title}
  </h2>
  <div class="wedding-section-body text-base leading-relaxed text-taupe-dark">
    <slot />
  </div>
</section>
