---
interface Props {
  title: string;
  description?: string;
  href: string;
  badge?: string;
  /** Show accent styling (e.g. orange border) */
  accent?: boolean;
}
const { title, description, href, badge, accent = false } = Astro.props;
const borderClass = accent ? 'border-orange/60 hover:border-orange' : 'border-taupe/30 hover:border-taupe-light/50';
---
<a
  href={href}
  class={`block rounded-xl border bg-sage p-6 text-left transition hover:bg-sage-light focus:outline-none focus:ring-2 focus:ring-orange focus:ring-offset-2 focus:ring-offset-forest ${borderClass}`}
>
  {badge && (
    <p class="text-xs font-semibold uppercase tracking-wide text-orange">{badge}</p>
  )}
  <h2 class={`font-heading text-xl font-semibold text-white md:text-2xl ${badge ? 'mt-1' : ''}`}>
    {title}
  </h2>
  {description && (
    <p class="mt-2 text-taupe">
      {description}
    </p>
  )}
  <span class="mt-3 inline-block text-sm font-medium text-orange hover:text-orange-light">
    Learn more →
  </span>
</a>
