---
import nightSoccerField from '../assets/night-soccer-field.jpg';
interface Props {
  headline: string;
  subhead: string;
  ctaText: string;
  ctaHref?: string;
  secondaryText?: string;
  secondaryHref?: string;
}
const { headline, subhead, ctaText, ctaHref = '#', secondaryText, secondaryHref = '#' } = Astro.props;
---

<section class="relative min-h-[90vh] flex flex-col items-center justify-center px-4 py-24 text-center md:py-32" aria-label="Hero">
  <div class="absolute inset-0 overflow-hidden">
    <img
      src={nightSoccerField.src}
      alt=""
      class="hero-bg-rotated"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-hero-overlay" aria-hidden="true" />
  </div>
  <div class="relative z-10 mx-auto max-w-4xl">
    <h1 class="font-heading text-4xl font-bold leading-tight text-white-constant drop-shadow-md md:text-5xl lg:text-6xl">
      {headline}
    </h1>
    <p class="mt-4 text-lg text-white-constant/95 drop-shadow md:text-xl">
      {subhead}
    </p>
    <div class="mt-8 flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
      <a
        href={ctaHref}
        class="inline-block rounded bg-gradient-cta px-6 py-3 text-base font-semibold text-white-constant hover:opacity-90 focus:outline-none focus:ring-2 focus:ring-orange focus:ring-offset-2 focus:ring-offset-forest"
      >
        {ctaText}
      </a>
      {secondaryText && (
        <a
          href={secondaryHref}
          class="text-sm font-medium text-white-constant underline decoration-white-constant/70 underline-offset-2 hover:decoration-white-constant focus:outline-none focus:ring-2 focus:ring-orange focus:ring-offset-2 focus:ring-offset-forest"
        >
          {secondaryText}
        </a>
      )}
    </div>
  </div>
  <p class="absolute bottom-4 left-4 right-4 z-10 text-center text-xs text-white-constant/70 md:left-6 md:right-auto">
    Photo by <a href="https://unsplash.com/@izuddinhelmi?utm_source=unsplash&utm_medium=referral&utm_content=creditCopyText" class="underline hover:text-white" target="_blank" rel="noopener noreferrer">Izuddin Helmi Adnan</a> on <a href="https://unsplash.com/photos/birds-eye-view-photography-of-green-soccer-field-with-lights-K5ChxJaheKI?utm_source=unsplash&utm_medium=referral&utm_content=creditCopyText" class="underline hover:text-white" target="_blank" rel="noopener noreferrer">Unsplash</a>
  </p>
</section>

<style>
  .hero-bg-rotated {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 100vmax;
    height: 100vmax;
    transform: translate(-50%, -50%) rotate(90deg);
    object-fit: cover;
  }
</style>
