---
const navLinkClass =
  'block rounded px-3 py-2 text-sm font-medium text-taupe-dark hover:bg-sage-dark hover:text-white focus:outline-none focus:ring-2 focus:ring-orange';

const links = [
  { href: '/wedding#our-story', label: 'Our Story' },
  { href: '/wedding#location', label: 'Location' },
  { href: '/wedding#schedule', label: 'Schedule' },
  { href: '/wedding#accommodations', label: 'Stay' },
  { href: '/wedding#registry', label: 'Registry' },
  { href: '/wedding#faq', label: 'Q&A' },
];

const guestDetailsLink = { href: '/wedding/guest-details', label: 'Guest Details' };
const menuId = 'wedding-nav-menu';
const buttonId = 'wedding-nav-menu-button';
---

<div class="relative">
  <button
    id={buttonId}
    type="button"
    class="wedding-nav-toggle flex h-11 w-11 items-center justify-center rounded-full bg-black/40 text-white-constant shadow-lg shadow-black/20 backdrop-blur-sm transition hover:bg-black/60 focus:outline-none focus:ring-2 focus:ring-orange"
    aria-expanded="false"
    aria-controls={menuId}
    aria-label="Open menu"
  >
    <svg class="wedding-nav-icon-menu h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
    </svg>
    <svg class="wedding-nav-icon-close hidden h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>

  <div
    id={menuId}
    class="absolute left-0 top-full z-50 mt-2 w-56 rounded-lg border border-taupe/20 bg-forest-dark shadow-lg"
    role="dialog"
    aria-label="Wedding menu"
    hidden
  >
    <nav class="flex flex-col p-2" aria-label="Wedding">
      {links.map(({ href, label }) => (
        <a href={href} class={navLinkClass} data-nav-close>{label}</a>
      ))}
      <a
        href={guestDetailsLink.href}
        class={`${navLinkClass} mt-1 bg-orange/20 text-orange-dark hover:bg-orange hover:text-white`}
        data-nav-close
      >
        {guestDetailsLink.label}
      </a>
    </nav>
  </div>
</div>

<style>
  .wedding-nav-toggle.open .wedding-nav-icon-menu {
    display: none;
  }
  .wedding-nav-toggle.open .wedding-nav-icon-close {
    display: block;
  }
</style>

<script>
  (function () {
    const button = document.getElementById('wedding-nav-menu-button');
    const menu = document.getElementById('wedding-nav-menu');
    if (!button || !menu) return;

    const open = () => {
      menu.hidden = false;
      button.classList.add('open');
      button.setAttribute('aria-expanded', 'true');
      button.setAttribute('aria-label', 'Close menu');
    };

    const close = () => {
      menu.hidden = true;
      button.classList.remove('open');
      button.setAttribute('aria-expanded', 'false');
      button.setAttribute('aria-label', 'Open menu');
    };

    button.addEventListener('click', () =>
      button.getAttribute('aria-expanded') === 'true' ? close() : open()
    );

    menu.querySelectorAll('[data-nav-close]').forEach((link) => {
      link.addEventListener('click', close);
    });

    document.addEventListener('click', (e) => {
      const target = e.target as Node | null;
      if (
        target &&
        button.getAttribute('aria-expanded') === 'true' &&
        !menu.contains(target) &&
        !button.contains(target)
      ) {
        close();
      }
    });
  })();
</script>
