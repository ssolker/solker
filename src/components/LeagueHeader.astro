---
import astroLogo from '../assets/astro.svg';
---

<header class="fixed left-0 right-0 top-0 z-10 flex items-center justify-between border-b border-slate-700/50 bg-slate-900/80 px-4 py-3 backdrop-blur-sm md:px-6">
  <a href="/" class="flex shrink-0 focus:outline-none focus:ring-2 focus:ring-emerald-400 focus:ring-offset-2 focus:ring-offset-slate-900" aria-label="Home">
    <img src={astroLogo.src} alt="Logo" class="h-10 w-auto md:h-12" width="115" height="48" />
  </a>
  <nav class="flex items-center gap-1 md:gap-2" aria-label="Main">
    <a href="#current-season" class="rounded px-3 py-2 text-sm font-medium text-slate-300 hover:bg-slate-800 hover:text-white focus:outline-none focus:ring-2 focus:ring-emerald-400 focus:ring-offset-2 focus:ring-offset-slate-900">Current Season</a>
    <a href="#all-sports" class="rounded px-3 py-2 text-sm font-medium text-slate-300 hover:bg-slate-800 hover:text-white focus:outline-none focus:ring-2 focus:ring-emerald-400 focus:ring-offset-2 focus:ring-offset-slate-900">All Sports</a>
    <a href="#standings" class="rounded px-3 py-2 text-sm font-medium text-slate-300 hover:bg-slate-800 hover:text-white focus:outline-none focus:ring-2 focus:ring-emerald-400 focus:ring-offset-2 focus:ring-offset-slate-900">Standings</a>
    <a href="#resources" class="rounded px-3 py-2 text-sm font-medium text-slate-300 hover:bg-slate-800 hover:text-white focus:outline-none focus:ring-2 focus:ring-emerald-400 focus:ring-offset-2 focus:ring-offset-slate-900">Resources</a>
    <a href="#about" class="rounded px-3 py-2 text-sm font-medium text-slate-300 hover:bg-slate-800 hover:text-white focus:outline-none focus:ring-2 focus:ring-emerald-400 focus:ring-offset-2 focus:ring-offset-slate-900">About</a>
  </nav>
  <a href="#" class="shrink-0 rounded bg-emerald-500 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-400 focus:outline-none focus:ring-2 focus:ring-emerald-400 focus:ring-offset-2 focus:ring-offset-slate-900">Log in / Register</a>
</header>
