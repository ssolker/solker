---
interface Props {
  companyName: string;
  contactHref?: string;
  contactText?: string;
  copyrightYear?: number;
}
const { companyName, contactHref = '/contact', contactText = 'Contact', copyrightYear = new Date().getFullYear() } = Astro.props;
---

<footer class="border-t border-slate-700 bg-slate-900/80 px-4 py-8 md:px-6">
  <div class="mx-auto flex max-w-5xl flex-col gap-6 md:flex-row md:items-center md:justify-between">
    <div>
      <p class="font-heading font-semibold text-white">{companyName}</p>
      <a href={contactHref} class="mt-1 block text-sm text-slate-400 hover:text-emerald-400 focus:outline-none focus:ring-2 focus:ring-emerald-400 focus:ring-offset-2 focus:ring-offset-slate-900">
        {contactText}
      </a>
    </div>
    <div class="flex flex-wrap items-center gap-4 text-sm text-slate-400">
      <a href="#" class="hover:text-white focus:outline-none focus:ring-2 focus:ring-emerald-400 focus:ring-offset-2 focus:ring-offset-slate-900">Privacy Policy</a>
      <a href="#" class="hover:text-white focus:outline-none focus:ring-2 focus:ring-emerald-400 focus:ring-offset-2 focus:ring-offset-slate-900">Terms of Service</a>
      <span>© {copyrightYear} {companyName}</span>
    </div>
  </div>
</footer>
