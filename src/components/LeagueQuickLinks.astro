---
import QuickLinkCard from './QuickLinkCard.astro';
const iconClass = 'h-6 w-6 shrink-0 text-taupe';
---

<section class="px-4 py-12 md:py-16" aria-labelledby="quick-links-heading">
  <div class="mx-auto max-w-5xl">
    <h2 id="quick-links-heading" class="font-heading mb-8 text-center text-2xl font-bold text-white md:text-3xl">
      Quick Links
    </h2>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      <QuickLinkCard
        title="Registration"
        description="Register your team or join as a free agent."
        buttonText="Register"
        href="/league/registration"
      >
        <svg slot="icon" class={iconClass} fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
      </QuickLinkCard>
      <QuickLinkCard
        title="Sign Waiver"
        description="Mandatory for ALL players before first game."
        buttonText="Sign now"
        href="/league/waiver"
      >
        <svg slot="icon" class={iconClass} fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
        </svg>
      </QuickLinkCard>
      <QuickLinkCard
        title="Payment Info"
        description="View payment instructions and waiver next steps."
        buttonText="Payment details"
        href="/league/payment"
      >
        <svg slot="icon" class={iconClass} fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2 7h20M4 7v10a2 2 0 002 2h12a2 2 0 002-2V7M8 15h4" />
        </svg>
      </QuickLinkCard>
      <QuickLinkCard
        title="Score Submission"
        description="Submit scores after each game."
        buttonText="Submit scores"
        href="/league/score-submission"
      >
        <svg slot="icon" class={iconClass} fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
        </svg>
      </QuickLinkCard>
      <QuickLinkCard
        title="Standings & Schedule"
        description="View standings and game schedule."
        buttonText="View"
        href="#standings-and-schedule"
      >
        <svg slot="icon" class={iconClass} fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
        </svg>
      </QuickLinkCard>
    </div>
  </div>
</section>
