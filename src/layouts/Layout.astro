---
import '../styles/global.css';
import ThemeSwitcher from '../components/ThemeSwitcher.astro';
import logoLight from '../assets/Solker_b.svg';
import logoDark from '../assets/Solker_w.svg';
interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  showThemeSwitcher?: boolean;
}
const { title = 'Solker', description, canonical, showThemeSwitcher = true } = Astro.props;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).toString();
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<script is:inline>
			(function() {
			 var theme = 'light', palette = 'new';
			 try {
			   var stored = localStorage.getItem('solker-theme');
			   if (stored === 'light' || stored === 'dark') { theme = stored; }
			   else if (typeof matchMedia !== 'undefined' && matchMedia('(prefers-color-scheme: dark)').matches) { theme = 'dark'; }
			 } catch (e) {}
			 document.documentElement.setAttribute('data-theme', theme);
			 document.documentElement.setAttribute('data-palette', palette);
			})();
		</script>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="canonical" href={canonicalUrl} />
		{description && <meta name="description" content={description} />}
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;600;700&display=swap" rel="stylesheet" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="flex min-h-screen flex-col bg-forest text-white font-sans antialiased">
		<header class="fixed left-0 right-0 top-0 z-50 flex shrink-0 items-center justify-between border-b border-taupe/20 bg-forest-dark/95 px-4 py-3 backdrop-blur-sm md:px-6">
			<a href="/" class="logo-link flex shrink-0 focus:outline-none" aria-label="Home" data-logo-clicks="0">
				<img src={logoLight.src} alt="Solker" class="logo logo-light h-10 w-auto md:h-12" width="115" height="48" />
				<img src={logoDark.src} alt="Solker" class="logo logo-dark h-10 w-auto md:h-12" width="115" height="48" />
			</a>
			<script>
				document.querySelector('.logo-link')?.addEventListener('click', (e) => {
					const link = e.currentTarget as HTMLAnchorElement | null;
					if (!link) return;
					const count = parseInt(link.getAttribute('data-logo-clicks') ?? '0', 10) + 1;
					link.setAttribute('data-logo-clicks', String(count));
					if (count < 12) {
						e.preventDefault();
					}
				});
			</script>
			<div class="flex min-w-0 flex-1 justify-center">
				<slot name="header-nav" />
			</div>			<div class="flex shrink-0 items-center gap-2">
				<!-- Log in / Register (commented out)
				<a href="#" class="rounded bg-orange px-4 py-2 text-sm font-semibold text-white hover:bg-orange-dark focus:outline-none focus:ring-2 focus:ring-orange focus:ring-offset-2 focus:ring-offset-forest-dark">Log in / Register</a>
				-->
				{showThemeSwitcher && <ThemeSwitcher />}
			</div>
		</header>
		<div class="flex min-h-0 flex-1 flex-col pt-16">
			<slot />
		</div>
	</body>
</html>
