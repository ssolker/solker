---
import Layout from './Layout.astro';
import Footer from '../components/Footer.astro';
import WeddingNav from '../components/WeddingNav.astro';
import WeddingPhotoPanel from '../components/wedding/WeddingPhotoPanel.astro';
import { weddingMeta } from '../data/wedding';

interface Props {
  title: string;
  description?: string;
  showFooter?: boolean;
  showCountdown?: boolean;
  /** Show the floating "Fill in guest details" button (hide on the form page itself). */
  showGuestDetailsFab?: boolean;
}
const {
  title,
  description,
  showFooter = true,
  showCountdown = false,
  showGuestDetailsFab = true,
} = Astro.props;
---

<Layout
  title={title}
  description={description}
  showThemeSwitcher={false}
  forcedTheme="light"
  showHeader={false}
>
  <div class="flex min-h-screen flex-col lg:flex-row">
    <WeddingPhotoPanel showCountdown={showCountdown}>
      <Fragment slot="menu">
        <WeddingNav />
      </Fragment>
    </WeddingPhotoPanel>
    <div class="flex flex-1 flex-col">
      <main class="flex-1 px-4 py-8 lg:overflow-y-auto lg:px-10 lg:py-12">
        <div class="mx-auto max-w-2xl">
          <slot />
        </div>
      </main>
      {showFooter && (
        <Footer contactHref="/contact" contactText="Contact" copyrightYear={2026} />
      )}
    </div>
  </div>

  {
    showGuestDetailsFab && (
      <a
        href={weddingMeta.guestDetailsPath}
        class="fixed bottom-5 right-5 z-40 inline-flex items-center gap-2 rounded-full bg-orange px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-black/20 transition hover:bg-orange-dark focus:outline-none focus:ring-2 focus:ring-orange focus:ring-offset-2 focus:ring-offset-forest sm:bottom-6 sm:right-6 sm:text-base"
      >
        <svg
          class="h-5 w-5 shrink-0"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"
          />
        </svg>
        {weddingMeta.guestDetailsCta}
      </a>
    )
  }

  <style is:global>
    /* Autumn scroll reveal: content drifts up and settles like leaves coming to rest. */
    .wedding-reveal {
      opacity: 0;
      transform: translateY(28px);
      transition:
        opacity 0.8s ease-out,
        transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
      will-change: opacity, transform;
    }
    .wedding-reveal.is-visible {
      opacity: 1;
      transform: none;
    }

    /* Leaf ornament tumbles in after its section settles. */
    .wedding-leaf {
      display: inline-flex;
      opacity: 0;
      transform: translateY(-14px) rotate(-75deg);
      transition:
        opacity 0.9s ease-out 0.25s,
        transform 0.9s cubic-bezier(0.34, 1.4, 0.64, 1) 0.25s;
    }
    .wedding-reveal.is-visible .wedding-leaf {
      opacity: 1;
      transform: none;
    }

    /* Schedule/list items ripple in one after another. */
    .wedding-reveal .wedding-section-body > ol > li,
    .wedding-reveal .wedding-section-body dl > div {
      opacity: 0;
      transform: translateY(16px);
      transition:
        opacity 0.6s ease-out,
        transform 0.6s ease-out;
    }
    .wedding-reveal.is-visible .wedding-section-body > ol > li,
    .wedding-reveal.is-visible .wedding-section-body dl > div {
      opacity: 1;
      transform: none;
    }
    .wedding-reveal.is-visible .wedding-section-body > ol > li:nth-child(1) { transition-delay: 0.1s; }
    .wedding-reveal.is-visible .wedding-section-body > ol > li:nth-child(2) { transition-delay: 0.2s; }
    .wedding-reveal.is-visible .wedding-section-body > ol > li:nth-child(3) { transition-delay: 0.3s; }
    .wedding-reveal.is-visible .wedding-section-body > ol > li:nth-child(4) { transition-delay: 0.4s; }
    .wedding-reveal.is-visible .wedding-section-body > ol > li:nth-child(5) { transition-delay: 0.5s; }
    .wedding-reveal.is-visible .wedding-section-body > ol > li:nth-child(6) { transition-delay: 0.6s; }
    .wedding-reveal.is-visible .wedding-section-body > ol > li:nth-child(7) { transition-delay: 0.7s; }
    .wedding-reveal.is-visible .wedding-section-body > ol > li:nth-child(n + 8) { transition-delay: 0.8s; }
    .wedding-reveal.is-visible .wedding-section-body dl > div:nth-child(1) { transition-delay: 0.1s; }
    .wedding-reveal.is-visible .wedding-section-body dl > div:nth-child(2) { transition-delay: 0.2s; }
    .wedding-reveal.is-visible .wedding-section-body dl > div:nth-child(3) { transition-delay: 0.3s; }
    .wedding-reveal.is-visible .wedding-section-body dl > div:nth-child(n + 4) { transition-delay: 0.4s; }

    @media (prefers-reduced-motion: reduce) {
      .wedding-reveal,
      .wedding-leaf,
      .wedding-reveal .wedding-section-body > ol > li,
      .wedding-reveal .wedding-section-body dl > div {
        opacity: 1;
        transform: none;
        transition: none;
      }
    }
  </style>

  <script>
    const revealEls = document.querySelectorAll('.wedding-reveal');
    if ('IntersectionObserver' in window && revealEls.length > 0) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
      );
      revealEls.forEach((el) => observer.observe(el));
    } else {
      revealEls.forEach((el) => el.classList.add('is-visible'));
    }
  </script>
</Layout>
