---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';

// Contact form is served by the same Apps Script Web App as waiver/registration (PUBLIC_WAIVER_FORM_URL).
const webAppBaseUrl = import.meta.env.PUBLIC_WAIVER_FORM_URL || 'https://script.google.com/macros/s/AKfycbxQ6F0QnbJB6y7gAPbMn3GMfjw1zBWv1niMjJx0T0vd0g_UU-1BalgNcu2LSoCf9TxIHg/exec';
const contactFormUrl = `${webAppBaseUrl}${webAppBaseUrl.includes('?') ? '&' : '?'}page=contact`;
---

<Layout
  title="Contact — Solker"
  description="Contact Solker for general inquiries, privacy requests, or legal matters."
>
  <main class="flex-1 px-4 py-12 md:py-16">
    <div class="mx-auto max-w-4xl">
      <h1 class="font-heading text-3xl font-bold text-white md:text-4xl">
        Contact
      </h1>
      <p class="mt-2 text-taupe">
        For general inquiries, privacy requests (access, correction, withdrawal of consent), or legal matters, use the form below.
      </p>

      <!-- Full-height iframe: viewport minus navbar + title + subtitle -->
      <div class="relative mt-8 w-full overflow-hidden rounded-lg border border-taupe/30 bg-forest-dark" style="min-height: 400px; height: calc(100vh - 220px);">
        <div id="contact-loading-overlay" class="form-loading-overlay absolute inset-0 z-10 flex flex-col items-center justify-center bg-forest-dark text-white" aria-live="polite">
          <div class="form-spinner h-10 w-10 rounded-full border-2 border-sage-dark" />
          <p class="mt-4 font-medium text-white">Loading form…</p>
        </div>
        <iframe
          id="form-iframe"
          title="Contact form"
          src={contactFormUrl}
          width="100%"
          height="100%"
          style="border: none; display: block; height: 100%;"
          loading="lazy"
        />
      </div>

      <p class="mt-6 text-sm text-taupe">
        Submissions are used only to respond to your inquiry. See our <a href="/legal#privacy" class="text-orange hover:text-orange-light focus:outline-none focus:ring-2 focus:ring-orange focus:ring-offset-2 focus:ring-offset-forest">Privacy Policy</a>.
      </p>
    </div>
  </main>

  <style>
    .form-spinner {
      border-top-color: var(--theme-orange);
      animation: form-spin 0.8s linear infinite;
    }
    @keyframes form-spin {
      to { transform: rotate(360deg); }
    }
    .form-loading-overlay[aria-hidden="true"] {
      display: none;
    }
  </style>

  <script>
    (function() {
      var overlay = document.getElementById('contact-loading-overlay');
      var iframe = document.getElementById('form-iframe');
      if (!overlay || !iframe) return;
      var iframeLoaded = false;
      var minTimeDone = false;
      function maybeHide() {
        if (iframeLoaded && minTimeDone && overlay) {
          overlay.setAttribute('aria-hidden', 'true');
          overlay.style.display = 'none';
        }
      }
      iframe.addEventListener('load', function() {
        iframeLoaded = true;
        maybeHide();
      });
      window.setTimeout(function() {
        minTimeDone = true;
        maybeHide();
      }, 2000);
    })();
  </script>

  <Footer contactHref="/contact" contactText="Contact" copyrightYear={2026} />
</Layout>
