---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';

const apiUrl = import.meta.env.PUBLIC_FORMS_API_URL || '';
const recaptchaSiteKey = import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY || '';
---

<Layout
  title="Contact — Solker"
  description="Contact Solker for general inquiries, privacy requests, or legal matters."
>
  <main class="flex-1 px-4 py-12 md:py-16">
    <div class="mx-auto max-w-2xl">
      <h1 class="font-heading text-3xl font-bold text-white md:text-4xl">
        Contact
      </h1>
      <p class="mt-2 text-taupe">
        For general inquiries, privacy requests (access, correction, withdrawal of consent), or legal matters, use the form below.
      </p>

      <form id="contact-form" class="mt-8 space-y-4" novalidate>
        <input type="text" name="_gotcha" id="gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" class="absolute left-[-9999px]" />

        <div>
          <label for="email" class="mb-1 block font-medium text-white">Your email</label>
          <input type="email" id="email" name="email" required placeholder="you@example.com" class="w-full rounded-lg border border-taupe/30 bg-forest-dark px-4 py-2 text-white placeholder:text-taupe/60 focus:border-orange focus:outline-none focus:ring-1 focus:ring-orange" />
        </div>
        <div>
          <label for="subject" class="mb-1 block font-medium text-white">Subject</label>
          <input type="text" id="subject" name="subject" placeholder="e.g. Privacy request" class="w-full rounded-lg border border-taupe/30 bg-forest-dark px-4 py-2 text-white placeholder:text-taupe/60 focus:border-orange focus:outline-none focus:ring-1 focus:ring-orange" />
        </div>
        <div>
          <label for="message" class="mb-1 block font-medium text-white">Message</label>
          <textarea id="message" name="message" required placeholder="Your message…" rows="5" class="w-full resize-y rounded-lg border border-taupe/30 bg-forest-dark px-4 py-2 text-white placeholder:text-taupe/60 focus:border-orange focus:outline-none focus:ring-1 focus:ring-orange"></textarea>
        </div>

        <div id="recaptcha-wrap" class="flex justify-center"></div>

        <button type="submit" id="submitBtn" class="w-full rounded-lg bg-orange px-4 py-3 font-semibold text-white hover:bg-orange-dark focus:outline-none focus:ring-2 focus:ring-orange disabled:cursor-not-allowed disabled:opacity-70">
          Send
        </button>
      </form>

      <p id="statusMessage" class="mt-4 min-h-[1.5em] text-center font-medium" aria-live="polite"></p>

      <p class="mt-6 text-sm text-taupe">
        Submissions are used only to respond to your inquiry. See our <a href="/legal#privacy" class="text-orange hover:text-orange-light focus:outline-none focus:ring-2 focus:ring-orange focus:ring-offset-2 focus:ring-offset-forest">Privacy Policy</a>.
      </p>
    </div>
  </main>

  <script src="https://www.google.com/recaptcha/api.js?onload=onRecaptchaLoadContact&render=explicit" async defer />
  <script define:vars={{ apiUrl, recaptchaSiteKey }}>
    (function() {
      window.onRecaptchaLoadContact = function() {
        if (typeof grecaptcha === 'undefined' || !recaptchaSiteKey) return;
        var wrap = document.getElementById('recaptcha-wrap');
        if (wrap) window.contactRecaptchaId = grecaptcha.render(wrap, { sitekey: recaptchaSiteKey, theme: 'dark' });
      };

      var form = document.getElementById('contact-form');
      if (form) {
        form.addEventListener('submit', function(e) {
          e.preventDefault();
          var gotcha = document.getElementById('gotcha');
          if (gotcha && gotcha.value) return;
          var email = document.getElementById('email').value.trim();
          var message = document.getElementById('message').value.trim();
          var statusEl = document.getElementById('statusMessage');
          var submitBtn = document.getElementById('submitBtn');

          if (!email || !message) {
            if (statusEl) statusEl.textContent = 'Please fill in your email and message.';
            return;
          }
          var token = '';
          if (typeof grecaptcha !== 'undefined' && recaptchaSiteKey && window.contactRecaptchaId !== undefined) {
            token = grecaptcha.getResponse(window.contactRecaptchaId);
            if (!token) {
              if (statusEl) statusEl.textContent = 'Please complete the verification below.';
              return;
            }
          }
          if (!apiUrl) {
            if (statusEl) statusEl.textContent = 'Form is not configured. Set PUBLIC_FORMS_API_URL.';
            return;
          }

          submitBtn.disabled = true;
          if (statusEl) { statusEl.textContent = 'Sending…'; statusEl.classList.remove('text-red-500', 'text-green-600'); }

          var payload = {
            action: 'contact',
            data: {
              email: email,
              subject: document.getElementById('subject').value.trim(),
              message: message
            },
            recaptchaToken: token
          };

          fetch(apiUrl, {
            method: 'POST',
            body: JSON.stringify(payload),
            headers: { 'Content-Type': 'text/plain;charset=utf-8' },
            redirect: 'follow'
          })
            .then(function(res) { return res.json(); })
            .then(function(json) {
              if (json.success) {
                if (statusEl) { statusEl.textContent = json.message || 'Message sent.'; statusEl.classList.add('text-green-600'); }
                submitBtn.style.display = 'none';
                var recWrap = document.getElementById('recaptcha-wrap');
                if (recWrap) recWrap.innerHTML = '';
              } else {
                if (statusEl) { statusEl.textContent = json.error || 'Something went wrong.'; statusEl.classList.add('text-red-500'); }
                submitBtn.disabled = false;
              }
            })
            .catch(function(err) {
              if (statusEl) { statusEl.textContent = err.message || 'Network error. Please try again.'; statusEl.classList.add('text-red-500'); }
              submitBtn.disabled = false;
            });
        });
      }
    })();
  </script>

  <Footer contactHref="/contact" contactText="Contact" copyrightYear={2026} />
</Layout>
