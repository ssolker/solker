---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
---
<Layout title="Page not found — Solker">
  <main class="flex min-h-0 flex-1 flex-col items-center justify-center px-4">
    <h1 class="font-heading text-3xl font-bold text-white md:text-4xl">
      404
    </h1>
    <p class="mt-2 text-taupe">
      This page could not be found.
    </p>
    <a
      href="/"
      class="mt-6 inline-block rounded-lg bg-orange px-4 py-2 text-sm font-medium text-white hover:bg-orange-dark focus:outline-none focus:ring-2 focus:ring-orange focus:ring-offset-2 focus:ring-offset-forest"
    >
      Back to home
    </a>
  </main>
  <Footer contactHref="/contact" contactText="Contact" copyrightYear={2026} />
</Layout>
