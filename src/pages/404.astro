---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page not found — Solker">
  <main class="flex min-h-[60vh] flex-col items-center justify-center px-4">
    <h1 class="font-heading text-3xl font-bold text-white md:text-4xl">
      404
    </h1>
    <p class="mt-2 text-slate-400">
      This page could not be found.
    </p>
    <a
      href="/"
      class="mt-6 inline-block rounded-lg bg-emerald-500 px-4 py-2 text-sm font-medium text-white hover:bg-emerald-600 focus:outline-none focus:ring-2 focus:ring-emerald-400 focus:ring-offset-2 focus:ring-offset-slate-900"
    >
      Back to home
    </a>
  </main>
</Layout>
