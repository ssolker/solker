---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import VentureCard from '../components/VentureCard.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Solker" description="Solker — Public Hub.">
  <main class="flex-1">
    <Hero title="Solker" tagline="Public Hub." />
    <section class="px-4 pb-16 md:pb-24" aria-label="Projects">
      <div class="mx-auto max-w-5xl space-y-12">
        <div>
          <h2 class="font-heading mb-6 text-xl font-bold text-white">Organization</h2>
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            <VentureCard
              title="Leagues"
              description="Adult recreational leagues."
              href="/league"
              badge="Under construction"
            />
            <VentureCard
            title="Soccer League"
            description="Rules, registration, waivers, and schedules for soccer league."
            href="/league/soccer"
            badge="Under construction"
          />
          </div>
        </div>
        <div>
          <h2 class="font-heading mb-6 text-xl font-bold text-white">Personal</h2>
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            <VentureCard
              title="Wedding"
              description="Shuaib & Hanna — October 10, 2026 at Bellamere Winery."
              href="/wedding"
              badge="Under construction"
            />
            <VentureCard
              title="Color Palette"
              description="Page to preview the color palette."
              href="/color-palette"
            />
            <VentureCard
              title="Resume"
              description="Professional background and experience."
              href="#"
              accent
            />
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer contactHref="/contact" contactText="Contact" copyrightYear={2026} />
</Layout>
