---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import VentureCard from '../components/VentureCard.astro';
---

<Layout title="Solker" description="Solker — ventures and community.">
  <main>
    <Hero title="Solker" tagline="Ventures and community." />
    <section class="px-4 pb-16 md:pb-24" aria-label="Ventures">
      <div class="mx-auto max-w-5xl">
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          <VentureCard
            title="League"
            description="Rules, registration, and waivers for the league."
            href="/league"
          />
          <VentureCard
            title="Coming soon"
            description="More ventures and projects."
            href="#"
          />
        </div>
      </div>
    </section>
  </main>
</Layout>
