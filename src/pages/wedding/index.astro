---
import Layout from '../../layouts/Layout.astro';
import WeddingNav from '../../components/WeddingNav.astro';
import WeddingHero from '../../components/WeddingHero.astro';
import Footer from '../../components/Footer.astro';

const wedding = {
  headline: 'Shuaib & Hanna',
  subhead: 'Saturday, October 10, 2026 | London, Ontario',
  heroImage: null as string | { src: string } | null,
  howWeMet: 'We met through friends and quickly knew we had something special. Our story is still being written — more to come.',
  proposal: 'He asked, she said yes. We\'re so excited to celebrate with you.',
  venueName: 'Bellamere Winery',
  venueAddress: '1260 Gainsborough Rd, London, ON N6H 5K8',
  venueMapUrl: 'https://www.google.com/maps/search/?api=1&query=1260+Gainsborough+Rd,+London,+ON+N6H+5K8',
  venueUrl: 'https://www.bellamere.com/',
  ceremonyTime: 'To be announced',
  receptionTime: 'To be announced',
  attire: 'Semi-Formal',
  hotelName: 'To be announced',
  hotelGroupCode: '',
  hotelDeadline: '',
  transportation: 'Details on parking and shuttles will be shared closer to the date.',
  presenceNote: 'Your presence is the greatest gift. If you wish to honor us with a contribution, we have registered at the following.',
  registries: [] as Array<{ name: string; url: string }>,
};
---

<Layout
  title="Wedding — Solker"
  description="Shuaib & Hanna Solker — October 10, 2026 at Bellamere Winery, London, Ontario."
>
  <Fragment slot="header-nav">
    <WeddingNav />
  </Fragment>

  <main class="pt-0">
    <div class="bg-orange/90 px-4 py-2 text-center text-sm font-medium text-white" role="status">
      Under construction — we're getting things ready.
    </div>

    <WeddingHero
      headline={wedding.headline}
      subhead={wedding.subhead}
      imageSrc={wedding.heroImage ?? undefined}
    />

    <section id="our-story" class="px-4 py-12 md:py-16" aria-labelledby="our-story-heading">
      <div class="mx-auto max-w-5xl">
        <h2 id="our-story-heading" class="font-heading mb-8 text-center text-2xl font-bold text-white md:text-3xl">
          Our Story
        </h2>
        <div class="grid gap-8 md:grid-cols-2 md:gap-12">
          <div class="space-y-6 text-taupe-light">
            <div>
              <h3 class="font-heading text-lg font-semibold text-white">How We Met</h3>
              <p class="mt-2">{wedding.howWeMet}</p>
            </div>
            <div>
              <h3 class="font-heading text-lg font-semibold text-white">The Proposal</h3>
              <p class="mt-2">{wedding.proposal}</p>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-3 sm:grid-cols-3" aria-label="Photo gallery">
            <div class="aspect-square rounded-lg bg-sage-dark" aria-hidden="true" />
            <div class="aspect-square rounded-lg bg-sage-dark" aria-hidden="true" />
            <div class="aspect-square rounded-lg bg-sage-dark col-span-2 sm:col-span-1" aria-hidden="true" />
          </div>
        </div>
      </div>
    </section>

    <section id="event-details" class="bg-sage-light/40 px-4 py-12 md:py-16" aria-labelledby="event-details-heading">
      <div class="mx-auto max-w-5xl">
        <h2 id="event-details-heading" class="font-heading mb-8 text-center text-2xl font-bold text-white md:text-3xl">
          Event Details
        </h2>
        <div class="space-y-8 text-taupe-light">
          <div>
            <h3 class="font-heading text-lg font-semibold text-white">Ceremony</h3>
            <p class="mt-1">{wedding.ceremonyTime}</p>
            <p class="mt-1">
              <a
                href={wedding.venueUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-orange hover:text-orange-light focus:outline-none focus:ring-2 focus:ring-orange focus:ring-offset-2 focus:ring-offset-forest"
              >
                {wedding.venueName}
              </a>
            </p>
            <p class="mt-1">{wedding.venueAddress}</p>
            <a
              href={wedding.venueMapUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-2 inline-block text-sm font-medium text-orange hover:text-orange-light focus:outline-none focus:ring-2 focus:ring-orange focus:ring-offset-2 focus:ring-offset-forest"
            >
              View Map →
            </a>
          </div>
          <div>
            <h3 class="font-heading text-lg font-semibold text-white">Cocktail Hour & Reception</h3>
            <p class="mt-1">{wedding.receptionTime}</p>
            <p class="mt-1">{wedding.venueName} — {wedding.venueAddress}</p>
          </div>
          <div>
            <h3 class="font-heading text-lg font-semibold text-white">Attire</h3>
            <p class="mt-1">{wedding.attire}</p>
          </div>
        </div>
      </div>
    </section>

    <section id="travel-stay" class="px-4 py-12 md:py-16" aria-labelledby="travel-stay-heading">
      <div class="mx-auto max-w-5xl">
        <h2 id="travel-stay-heading" class="font-heading mb-8 text-center text-2xl font-bold text-white md:text-3xl">
          Travel & Stay
        </h2>
        <div class="grid gap-8 md:grid-cols-2">
          <div>
            <h3 class="font-heading text-lg font-semibold text-white">Accommodation</h3>
            <p class="mt-2 text-taupe-light">{wedding.hotelName}</p>
            {wedding.hotelGroupCode && <p class="mt-1 text-sm text-taupe-light">Group code: {wedding.hotelGroupCode}</p>}
            {wedding.hotelDeadline && <p class="mt-1 text-sm text-taupe-light">Book by: {wedding.hotelDeadline}</p>}
          </div>
          <div>
            <h3 class="font-heading text-lg font-semibold text-white">Transportation</h3>
            <p class="mt-2 text-taupe-light">{wedding.transportation}</p>
          </div>
        </div>
      </div>
    </section>

    <section id="registry" class="bg-sage-light/40 px-4 py-12 md:py-16" aria-labelledby="registry-heading">
      <div class="mx-auto max-w-5xl">
        <h2 id="registry-heading" class="font-heading mb-8 text-center text-2xl font-bold text-white md:text-3xl">
          Registry
        </h2>
        <p class="mx-auto max-w-2xl text-center text-taupe-light">
          {wedding.presenceNote}
        </p>
        {wedding.registries.length > 0 && (
          <div class="mt-8 flex flex-wrap justify-center gap-4">
            {wedding.registries.map(({ name, url }) => (
              <a
                href={url}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded bg-orange px-6 py-3 text-sm font-semibold text-white hover:bg-orange-dark focus:outline-none focus:ring-2 focus:ring-orange focus:ring-offset-2 focus:ring-offset-forest"
              >
                {name}
              </a>
            ))}
          </div>
        )}
        {wedding.registries.length === 0 && (
          <p class="mt-4 text-center text-sm text-taupe-light">Registry links will be added soon.</p>
        )}
      </div>
    </section>

    <Footer companyName="Solker" contactHref="/contact" contactText="Contact" copyrightYear={2026} />
  </main>
</Layout>
