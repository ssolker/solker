---
import WeddingLayout from '../../layouts/WeddingLayout.astro';
import WeddingGuestForm from '../../components/wedding/WeddingGuestForm.astro';
import WeddingMealOptions from '../../components/wedding/WeddingMealOptions.astro';
import {
  getWeddingFormsApiUrl,
  getRecaptchaSiteKeyV3,
  getRecaptchaSiteKeyV2,
} from '../../env/weddingForms';

const apiUrl = getWeddingFormsApiUrl();
const recaptchaSiteKey = getRecaptchaSiteKeyV3();
const recaptchaSiteKeyV2 = getRecaptchaSiteKeyV2();
---

<WeddingLayout
  title="Guest Details — Shuaib & Hanna"
  description="Submit your guest details, meal choices, and hotel room needs for Shuaib & Hanna's wedding."
  showGuestDetailsFab={false}
>
  <header class="wedding-reveal mb-6 border-b border-taupe/20 pb-5">
    <nav aria-label="Breadcrumb">
      <ol class="flex items-center gap-1.5 text-sm leading-none text-taupe-dark">
        <li class="flex items-center">
          <a
            href="/wedding"
            class="inline-flex items-center gap-1.5 text-orange hover:text-orange-light focus:outline-none focus:ring-2 focus:ring-orange"
          >
            <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
            </svg>
            Wedding
          </a>
        </li>
        <li aria-hidden="true">/</li>
        <li aria-current="page">Guest Details</li>
      </ol>
    </nav>
    <h1 class="font-heading mt-3 text-2xl font-bold text-white md:text-3xl">Tell us who's coming</h1>
    <p class="mt-2 text-sm leading-relaxed text-taupe-dark">
      Share who's attending, meal choices, dietary needs, and whether you need a hotel room.
    </p>
  </header>

  <div class="wedding-reveal">
    <WeddingMealOptions />
  </div>

  <div class="wedding-reveal">
    <WeddingGuestForm
      apiUrl={apiUrl}
      recaptchaSiteKey={recaptchaSiteKey}
      recaptchaSiteKeyV2={recaptchaSiteKeyV2}
    />
  </div>
</WeddingLayout>
