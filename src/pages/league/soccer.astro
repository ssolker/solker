---
import Layout from '../../layouts/Layout.astro';
import LeagueNav from '../../components/LeagueNav.astro';
import LeagueHero from '../../components/LeagueHero.astro';
import LeagueCard from '../../components/LeagueCard.astro';
import QuickLinkCard from '../../components/QuickLinkCard.astro';
import CollapsibleSection from '../../components/CollapsibleSection.astro';
import Footer from '../../components/Footer.astro';
import astroLogo from '../../assets/astro.svg';
import soccerIllustrationSpring from '../../assets/soccer/soccer_spring.svg';
import soccerIllustrationSummer from '../../assets/soccer/soccer_summer.svg';
const soccerSpringImageCredit =
  'Illustration by <a href="https://unsplash.com/@fadhilsanad?utm_source=unsplash&utm_medium=referral&utm_content=creditCopyText">Fast Ink</a> on <a href="https://unsplash.com/illustrations/a-person-standing-on-top-of-a-soccer-ball-JYoednJRax0?utm_source=unsplash&utm_medium=referral&utm_content=creditCopyText">Unsplash</a>';
const soccerSummerImageCredit =
  'Illustration by <a href="https://unsplash.com/@simonliillustrates?utm_source=unsplash&utm_medium=referral&utm_content=creditCopyText">Simon Li</a> on <a href="https://unsplash.com/illustrations/two-soccer-players-in-action-on-the-field-r48cN5wp-B0?utm_source=unsplash&utm_medium=referral&utm_content=creditCopyText">Unsplash</a>';
---

<Layout title="6v6 Co-Ed Soccer — League — Solker" description="Woodstock Adult Co-Ed Soccer. Rules, registration, waivers, and resources.">
  <Fragment slot="header-nav">
    <LeagueNav />
  </Fragment>

  <main class="flex-1 pt-0">
    <div class="bg-orange/90 px-4 py-2 text-center text-sm font-medium text-white" role="status">
      Under construction — we're getting things ready.
    </div>
    <LeagueHero
      headline="6v6 Co-Ed Soccer"
      subhead="Spirit of the Game."
      ctaText="View Leagues"
      ctaHref="#active-leagues-heading"
    />

    <section class="px-4 py-12 md:py-16" aria-labelledby="active-leagues-heading">
      <div class="mx-auto max-w-5xl">
        <h2 id="active-leagues-heading" class="font-heading mb-8 text-center text-2xl font-bold text-white md:text-3xl">
          Current Leagues
        </h2>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-2">
          <LeagueCard
            title="6v6 Co-Ed Soccer (Season 1)"
            subtitle="Thursday Nights (May 7th - June 25th)"
            badge="Coming soon!"
            imageSrc={soccerIllustrationSpring}
            imageAlt="Person standing on a soccer ball"
            imageCredit={soccerSpringImageCredit}
            primaryButtonText="Register team"
            primaryButtonHref="/league/registration"
            secondaryButtonText="Join as free agent"
            secondaryButtonHref="/league/registration"
          />
          <LeagueCard
            title="6v6 Co-Ed Soccer (Season 2)"
            subtitle="Thursday Nights (July - August)"
            badge="Coming soon"
            imageSrc={soccerIllustrationSummer}
            imageAlt="Two soccer players in action"
            imageCredit={soccerSummerImageCredit}
            primaryButtonText="Coming soon!"
            primaryButtonHref="#active-leagues-heading"
          />
        </div>
      </div>
    </section>

    <section class="px-4 py-12 md:py-16" aria-labelledby="quick-links-heading">
      <div class="mx-auto max-w-5xl">
        <h2 id="quick-links-heading" class="font-heading mb-8 text-center text-2xl font-bold text-white md:text-3xl">
          Quick Links
        </h2>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          <QuickLinkCard
            title="Registration"
            description="Register your team or join as a free agent."
            buttonText="Register"
            href="/league/registration"
          >
            <img slot="icon" src={astroLogo.src} alt="" class="h-8 w-auto" width="32" height="32" />
          </QuickLinkCard>
          <QuickLinkCard
            title="Sign Waiver"
            description="Mandatory for ALL players before first game."
            buttonText="Sign now"
            href="/league/waiver"
          >
            <img slot="icon" src={astroLogo.src} alt="" class="h-8 w-auto" width="32" height="32" />
          </QuickLinkCard>
          <QuickLinkCard
            title="Score Submission"
            description="Submit scores after each game."
            buttonText="Submit scores"
            href="/league/score-submission"
          >
            <img slot="icon" src={astroLogo.src} alt="" class="h-8 w-auto" width="32" height="32" />
          </QuickLinkCard>
          <QuickLinkCard
            title="Standings & Schedule"
            description="View standings and game schedule."
            buttonText="View"
            href="#standings"
          >
            <img slot="icon" src={astroLogo.src} alt="" class="h-8 w-auto" width="32" height="32" />
          </QuickLinkCard>
        </div>
      </div>
    </section>

    <section id="rules" class="px-4 py-12 md:py-16" aria-labelledby="rules-heading">
      <div class="mx-auto max-w-3xl">
        <h2 id="rules-heading" class="font-heading mb-8 text-center text-2xl font-bold text-white md:text-3xl">
          Rules & Resources
        </h2>
        <div class="space-y-4">
          <CollapsibleSection title="Vision & Philosophy">
            <div class="prose prose-invert max-w-none space-y-4 text-sm">
              <p><strong>Mission:</strong> Cultivating a culture of accountability and connection in the Friendly City. Our mission is to provide a fun, self-regulated sports environment built on the pillars of integrity and community.</p>
              <p><strong>Spirit of the Game:</strong> The league operates on a self-officiated model to encourage player accountability and lower operational overhead. When players take ownership of the rules, the game becomes more honest, fluid, and enjoyable for everyone involved.</p>
              <p><strong>Collaborative Competition:</strong> Every match is a joint effort between two teams to maintain a safe, fair, and welcoming environment. We prioritize open communication and social connection, ensuring that providing a fun, active, and social outlet for Woodstock remains the primary goal of every season.</p>
            </div>
          </CollapsibleSection>
          <CollapsibleSection title="League Essentials: Structure, Fees & Scheduling">
            <div class="prose prose-invert max-w-none space-y-4 text-sm">
              <h3 class="font-semibold text-white">Roster & Structure</h3>
              <ul class="list-disc pl-5 space-y-1">
                <li>Match Format: 6v6 (5 outfield players + 1 Goalkeeper). Ten per roster.</li>
                <li>Gender Minimum: A minimum of 1 female player must be on the field at all times. The goalkeeper does not count toward this requirement.</li>
                <li>Captains/Rep: Each team must designate one representative. Confirmed Captains receive a "Captain's Kit" with instructions and equipment prior to the season.</li>
                <li>Game Time: Matches kick off at 6:30 PM EST, two 20-minute halves, 5-minute halftime.</li>
                <li>Game Day: Each team is scheduled for two games per night.</li>
              </ul>
              <h3 class="font-semibold text-white mt-4">Season Structure & Fees</h3>
              <ul class="list-disc pl-5 space-y-1">
                <li>Season Length: 8-Week Blocks (e.g., May/June or July/August).</li>
                <li>Player Fees: $50 CAD per player for the 8-week season.</li>
                <li>Captains Fees: Waived for designated Captains.</li>
                <li>10 per roster means $500 per team. Guest players do not pay if replacing someone who has paid. Part timers get a discount.</li>
              </ul>
            </div>
          </CollapsibleSection>
          <CollapsibleSection title="Captains Information">
            <div class="prose prose-invert max-w-none space-y-4 text-sm">
              <p>This section outlines the mandatory roles and responsibilities for all team Captains.</p>
              <h3 class="font-semibold text-white">Reporting & Timekeeping</h3>
              <ul class="list-disc pl-5 space-y-1">
                <li><strong>Self-Officiating:</strong> There are no referees. Players call their own fouls.</li>
                <li><strong>The 30-Second Rule:</strong> If Captains cannot resolve a dispute within 30 seconds, play resets with an indirect free kick for the defending team at the spot of the foul.</li>
                <li><strong>Timekeeping:</strong> Both Captains are responsible for ensuring a "Timekeeper" is designated for the two 20-minute halves and 5-minute halftime break.</li>
                <li><strong>Post-Game Reporting:</strong> Captains must submit the electronic Game Day & Spirit Form immediately after each game.</li>
                <li><strong>Waivers:</strong> Mandatory to be signed before playing for every participant.</li>
              </ul>
            </div>
          </CollapsibleSection>
          <CollapsibleSection title="Official 6v6 League Rules">
            <div class="prose prose-invert max-w-none space-y-4 text-sm">
              <ul class="list-disc pl-5 space-y-1">
                <li><strong>The Start:</strong> Initial possession by rock-paper-scissors. Kickoff can go in any direction. Possession and sides swap at halftime.</li>
                <li><strong>Offsides:</strong> No offside penalties in 6v6.</li>
                <li><strong>No Sliding:</strong> Zero-tolerance. Any slide results in an indirect free kick for the opponent.</li>
                <li><strong>Sidelines:</strong> Kick-ins (not throw-ins). Kick-ins are indirect.</li>
                <li><strong>Goal Kicks:</strong> Can be kicked or thrown by the goalie.</li>
                <li><strong>Distance:</strong> Opponents must provide 5 yards on all restarts.</li>
                <li><strong>Free Kicks:</strong> All fouls = Indirect kick (must touch another player before scoring) except Penalty Kicks.</li>
                <li><strong>Penalty Kicks:</strong> From 8 meters for fouls in the box that stop a clear scoring chance.</li>
                <li><strong>Goalkeeper:</strong> May use hands in the box. Back Pass rule applies—goalies cannot pick up a ball intentionally kicked by a teammate.</li>
              </ul>
            </div>
          </CollapsibleSection>
          <CollapsibleSection title="Friendly City Spirit Score">
            <div class="prose prose-invert max-w-none space-y-4 text-sm">
              <p>The Spirit Score is a fundamental pillar of the "Friendly City" approach. It ensures that on-field conduct and collaborative communication are valued just as highly as athletic skill. The rubric and scores will be shared with team Captains.</p>
              <p><strong>Why Spirit Matters:</strong> In the event of a tie in the standings, the team with the higher Spirit Average will automatically take the higher seed.</p>
            </div>
          </CollapsibleSection>
          <CollapsibleSection title="FAQ">
            <div class="prose prose-invert max-w-none space-y-4 text-sm">
              <p class="text-taupe">FAQ content coming soon. Contact us with questions.</p>
            </div>
          </CollapsibleSection>
        </div>
      </div>
    </section>

    <section id="standings" class="bg-forest-light/40 px-4 py-12 md:py-16" aria-labelledby="friendly-spirit-heading">
      <div class="mx-auto max-w-5xl text-center">
        <h2 id="friendly-spirit-heading" class="font-heading text-2xl font-bold text-white md:text-3xl">
          Standings & Schedule
        </h2>
        <p class="mt-2 text-taupe">Coming soon.</p>
      </div>
    </section>
  </main>
  <Footer contactHref="/contact" contactText="Contact" copyrightYear={2026} />
</Layout>
