---
import Layout from '../../layouts/Layout.astro';
import LeagueNav from '../../components/LeagueNav.astro';
import LeagueHero from '../../components/LeagueHero.astro';
import ActiveLeagues from '../../components/ActiveLeagues.astro';
import LeagueQuickLinks from '../../components/LeagueQuickLinks.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="Solker - League" description="Solker: League in Woodstock. Active leagues, rules, waivers, and resources.">
  <Fragment slot="header-nav">
    <LeagueNav />
  </Fragment>

  <main class="flex-1 pt-0">
    <div class="bg-orange/90 px-4 py-2 text-center text-sm font-medium text-white" role="status">
      Under construction — we're getting things ready.
    </div>
    <LeagueHero
      headline="Providing Recreational Sports Leagues in Woodstock"
      subhead="Spirit of the Game."
      ctaText="View Leagues"
      ctaHref="#active-leagues-heading"
    />

    <ActiveLeagues />

    <!-- <LeagueQuickLinks /> -->

    <section id="standings" class="bg-forest-light/40 px-4 py-12 md:py-16" aria-labelledby="friendly-spirit-heading">
      <div class="mx-auto max-w-5xl text-center">
        <h2 id="friendly-spirit-heading" class="font-heading text-2xl font-bold text-white md:text-3xl">
          Adult Rec League in Woodstock
        </h2>
      </div>
    </section>
  </main>
  <Footer contactHref="/contact" contactText="Contact" copyrightYear={2026} />
</Layout>
