---
import Layout from '../../layouts/Layout.astro';
import LeagueNav from '../../components/LeagueNav.astro';
import LeagueHero from '../../components/LeagueHero.astro';
import VentureCard from '../../components/VentureCard.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="League — Solker" description="Woodstock's recreational league. Active leagues, rules, waivers, and resources.">
  <Fragment slot="header-nav">
    <LeagueNav />
  </Fragment>

  <main class="flex-1 pt-0">
    <div class="bg-orange/90 px-4 py-2 text-center text-sm font-medium text-white" role="status">
      Under construction — we're getting things ready.
    </div>
    <LeagueHero
      headline="Woodstock's Recreational Sports League"
      subhead="Spirit of the Game."
      ctaText="View Leagues"
      ctaHref="#current-leagues-heading"
    />

    <section class="px-4 py-12 md:py-16" aria-labelledby="current-leagues-heading">
      <div class="mx-auto max-w-5xl">
        <h2 id="current-leagues-heading" class="font-heading mb-8 text-center text-2xl font-bold text-white md:text-3xl">
          Current Leagues
        </h2>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          <VentureCard
            title="6v6 Co-Ed Soccer"
            description="Adult co-ed soccer. Rules, registration, waivers, standings."
            href="/league/soccer"
            badge="Under construction"
          />
        </div>
      </div>
    </section>
  </main>
  <Footer contactHref="/contact" contactText="Contact" copyrightYear={2026} />
</Layout>
