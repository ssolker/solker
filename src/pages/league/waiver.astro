---
import Layout from '../../layouts/Layout.astro';
import LeagueNav from '../../components/LeagueNav.astro';
import Footer from '../../components/Footer.astro';
import WaiverForm from '../../components/WaiverForm.astro';
import { getFormsApiUrl, getRecaptchaSiteKeyV3, getRecaptchaSiteKeyV2 } from '../../env/publicForms';

const apiUrl = getFormsApiUrl();
const recaptchaSiteKeyV3 = getRecaptchaSiteKeyV3();
const recaptchaSiteKeyV2 = getRecaptchaSiteKeyV2();
---

<Layout
  title="Sign Waiver — League — Solker"
  description="Sign the mandatory waiver for league players. Woodstock recreational league."
  showThemeSwitcher={false}
>
  <Fragment slot="header-nav">
    <LeagueNav />
  </Fragment>

  <main class="flex-1 px-4 py-8 md:py-12">
    <div class="mx-auto max-w-3xl">
      <h1 class="font-heading text-2xl font-bold text-white md:text-3xl">
        Waiver
      </h1>
      <p class="mt-2 text-taupe">
        Mandatory for all players before they can play. Fill out the form below.
      </p>

      <WaiverForm
        apiUrl={apiUrl}
        recaptchaSiteKey={recaptchaSiteKeyV3}
        recaptchaSiteKeyV2={recaptchaSiteKeyV2}
        context="standalone"
      />

      <p class="mt-6 text-sm text-taupe">
        This site is protected by reCAPTCHA and the Google
        <a href="https://policies.google.com/privacy" class="text-orange hover:text-orange-light" rel="noopener noreferrer">Privacy Policy</a> and
        <a href="https://policies.google.com/terms" class="text-orange hover:text-orange-light" rel="noopener noreferrer">Terms of Service</a> apply.
      </p>

      <a href="/league/soccer" class="mt-6 inline-block text-sm font-medium text-orange hover:text-orange-light">Back to Soccer league</a>
    </div>
  </main>

  <Footer contactHref="/contact" contactText="Contact" copyrightYear={2026} />
</Layout>
