---
import Layout from '../../layouts/Layout.astro';
import LeagueNav from '../../components/LeagueNav.astro';
import Footer from '../../components/Footer.astro';

const webAppBaseUrl = import.meta.env.PUBLIC_WAIVER_FORM_URL || 'https://script.google.com/macros/s/AKfycbxQ6F0QnbJB6y7gAPbMn3GMfjw1zBWv1niMjJx0T0vd0g_UU-1BalgNcu2LSoCf9TxIHg/exec';
const registrationFormUrl = `${webAppBaseUrl}${webAppBaseUrl.includes('?') ? '&' : '?'}page=registration`;
---

<Layout
  title="Registration — League — Solker"
  description="Register your team or join as a free agent. Woodstock recreational league."
>
  <Fragment slot="header-nav">
    <LeagueNav />
  </Fragment>

  <main class="flex-1 px-4 py-8 md:py-12">
    <div class="mx-auto max-w-4xl">
      <h1 class="font-heading text-2xl font-bold text-white md:text-3xl">
        Registration
      </h1>
      <p class="mt-2 text-taupe">
        Register your team or join as a free agent for the 6v6 Co-Ed Soccer league.
      </p>
      <!-- Backup: iframe commented out. New form at /league/registration-api. -->
      <!--
      <div class="relative mt-6 w-full overflow-hidden rounded-lg border border-taupe/30 bg-forest-dark" style="min-height: 400px; height: calc(100vh - 220px);">
        <div id="registration-loading-overlay" class="form-loading-overlay absolute inset-0 z-10 flex flex-col items-center justify-center bg-forest-dark text-white" aria-live="polite">
          <div class="form-spinner h-10 w-10 rounded-full border-2 border-sage-dark" />
          <p class="mt-4 font-medium text-white">Loading form…</p>
        </div>
        <iframe
          id="form-iframe"
          title="League registration form"
          src={registrationFormUrl}
          width="100%"
          height="100%"
          style="border: none; display: block; height: 100%;"
          loading="lazy"
        />
      </div>
      -->
      <p class="mt-6">
        <a href="/league/registration-api" class="rounded-lg bg-orange px-4 py-2 font-semibold text-white hover:bg-orange-dark focus:outline-none focus:ring-2 focus:ring-orange">Go to registration form</a>
      </p>
      <a
        href="/league/soccer"
        class="mt-6 inline-block text-sm font-medium text-orange hover:text-orange-light"
      >
        Back to Soccer league
      </a>
    </div>
  </main>

  <style>
    .form-spinner {
      border-top-color: var(--theme-orange);
      animation: form-spin 0.8s linear infinite;
    }
    @keyframes form-spin {
      to { transform: rotate(360deg); }
    }
    .form-loading-overlay[aria-hidden="true"] {
      display: none;
    }
  </style>

  <!-- Backup: overlay script commented out (iframe above is commented).
