        if (iframeLoaded && minTimeDone && overlay) {
          overlay.setAttribute('aria-hidden', 'true');
          overlay.style.display = 'none';
        }
      }
      iframe.addEventListener('load', function() {
        iframeLoaded = true;
        maybeHide();
      });
      window.setTimeout(function() {
        minTimeDone = true;
        maybeHide();
      }, 2000);
    })();
  </script>
  -->

  <Footer contactHref="/contact" contactText="Contact" copyrightYear={2026} />
</Layout>
