---
import Layout from '../../layouts/Layout.astro';
import LeagueNav from '../../components/LeagueNav.astro';
import Footer from '../../components/Footer.astro';
import RegistrationForm from '../../components/RegistrationForm.astro';
import WaiverForm from '../../components/WaiverForm.astro';

const apiUrl = import.meta.env.PUBLIC_FORMS_API_URL || '';
const recaptchaSiteKey = import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY || '';
const eTransferEmail = 'e-transfer@solker.ca';
---

<Layout
  title="Registration — League — Solker"
  description="Register your team or join as a free agent. Woodstock recreational league."
>
  <Fragment slot="header-nav">
    <LeagueNav />
  </Fragment>

  <main class="flex-1 px-4 py-8 md:py-12">
    <div class="mx-auto max-w-2xl">
      <h1 class="font-heading text-2xl font-bold text-white md:text-3xl">
        Registration
      </h1>
      <p class="mt-2 text-taupe">
        Register a new team, join a team, or register as a free agent for the league.
      </p>

      <!-- Step indicator: 3 dots -->
      <div class="mt-6 flex items-center justify-center gap-2" aria-label="Registration steps">
        <span id="stepDot1" class="step-dot h-3 w-3 rounded-full border-2 border-orange bg-orange" aria-current="step" title="Step 1: Registration"></span>
        <span id="stepDot2" class="step-dot h-3 w-3 rounded-full border-2 border-taupe/50 bg-transparent" title="Step 2: Payment"></span>
        <span id="stepDot3" class="step-dot h-3 w-3 rounded-full border-2 border-taupe/50 bg-transparent" title="Step 3: Waiver"></span>
      </div>
      <p class="mt-1 text-center text-sm text-taupe">
        <span id="stepLabel">Step 1: Registration</span>
      </p>

      <!-- Step 1: Registration form -->
      <div id="step1Panel" class="step-panel mt-6" data-step="1">
        <RegistrationForm apiUrl={apiUrl} recaptchaSiteKey={recaptchaSiteKey} context="flow" />
      </div>

      <!-- Step 2: Payment -->
      <div id="step2Panel" class="step-panel mt-6 hidden space-y-4" data-step="2">
        <p class="text-taupe font-semibold">To complete your registration, please send your payment. Your registration is not complete until payment is received and waiver is signed.</p>

        <div class="payment-step rounded-lg border border-taupe/30 bg-forest-dark p-4">
          <h2 class="text-base font-bold text-white mb-3">e-Transfer Instructions</h2>
          <p class="text-sm font-semibold text-taupe mb-2">Send e-Transfer to this email address:</p>
          <div class="flex items-center gap-2">
            <input type="text" id="paymentEmail" readonly value={eTransferEmail} class="flex-1 border-0 bg-transparent px-0 py-2 text-white font-semibold focus:ring-0 focus:outline-none" />
            <button type="button" id="copyEmailBtn" class="copy-btn rounded-lg border border-taupe/30 bg-forest-dark px-3 py-2 text-white font-semibold hover:bg-sage-dark focus:outline-none focus:ring-2 focus:ring-orange" title="Copy email">Copy</button>
          </div>
          <p class="text-sm font-semibold text-taupe mt-3 mb-1">Amount</p>
          <p id="paymentAmount" class="text-lg font-bold text-white">$50.00</p>
          <p class="text-sm font-semibold text-taupe mt-3 mb-1">Message to include in e-Transfer</p>
          <div class="flex items-center gap-2">
            <input type="text" id="paymentMessage" class="flex-1 rounded-lg border border-taupe/30 bg-forest-dark/80 px-4 py-2 text-white font-semibold" placeholder="Registration for [Full Name] - [Phone Number]" />
            <button type="button" id="copyMessageBtn" class="copy-btn rounded-lg border border-taupe/30 bg-forest-dark px-3 py-2 text-white font-semibold hover:bg-sage-dark focus:outline-none focus:ring-2 focus:ring-orange" title="Copy message">Copy</button>
          </div>
        </div>

        <div class="border-b border-taupe/30 pb-4">
            <h2 class="text-base font-bold text-white mb-3">Participant Details</h2>
            <p class="text-sm font-semibold text-taupe mb-1"><span class="text-red-500 font-medium">*</span> Registration name</p>
            <div class="flex items-center gap-2 mb-3">
              <input type="text" id="paymentName" required class="flex-1 rounded-lg border border-taupe/30 bg-forest-dark px-4 py-2 text-white font-semibold" placeholder="Your name" />
              <!-- <button type="button" id="copyNameBtn" class="copy-btn rounded-lg border border-taupe/30 bg-forest-dark px-3 py-2 text-white font-semibold hover:bg-sage-dark focus:outline-none focus:ring-2 focus:ring-orange" title="Copy name">Copy</button> -->
            </div>
            <p class="text-sm font-semibold text-taupe mb-1"><span class="text-red-500 font-medium">*</span> Your email address</p>
            <div class="flex items-center gap-2">
              <input type="email" id="paymentUserEmail" required class="flex-1 rounded-lg border border-taupe/30 bg-forest-dark px-4 py-2 text-white font-semibold" placeholder="you@example.com" />
              <!-- <button type="button" id="copyUserEmailBtn" class="copy-btn rounded-lg border border-taupe/30 bg-forest-dark px-3 py-2 text-white font-semibold hover:bg-sage-dark focus:outline-none focus:ring-2 focus:ring-orange" title="Copy your email">Copy</button> -->
            </div>
          </div>

          <div class="border-b border-taupe/30 pb-4">
            <h2 class="text-base font-bold text-white mb-3"><span class="text-red-500 font-medium">*</span> Payment method</h2>
            <div class="space-y-2">
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="radio" name="paymentMethod" id="paymentMethodEtransfer" value="etransfer" class="h-4 w-4 accent-orange" checked />
                <span class="text-white font-semibold">E-Transfer</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="radio" name="paymentMethod" id="paymentMethodCash" value="cash" class="h-4 w-4 accent-orange" />
                <span class="text-white font-semibold">Cash (only if e-Transfer cannot be done)</span>
              </label>
            </div>
            <p class="mt-2 text-sm text-taupe font-semibold">If e-Transfer cannot be made, cash is an option but must be paid before you play.</p>
          </div>

          <div id="step2RecaptchaWrap" class="flex justify-center py-2"></div>

          <button type="button" id="proceedToWaiverBtn" class="w-full rounded-lg bg-orange px-4 py-3 font-semibold text-white hover:bg-orange-dark focus:outline-none focus:ring-2 focus:ring-orange disabled:cursor-not-allowed disabled:opacity-70">
            Submit and Proceed to Waiver
          </button>
          <!-- <button type="button" id="mockProceedToWaiverBtn" class="mt-2 w-full rounded-lg border border-taupe/30 bg-forest-dark px-4 py-3 font-semibold text-white hover:bg-sage-dark focus:outline-none focus:ring-2 focus:ring-orange disabled:cursor-not-allowed disabled:opacity-70">
            Mock Proceed to Waiver
          </button> -->
        <div id="paymentStatusMessage" class="mt-4 min-h-[1.5em] flex flex-col items-center justify-center gap-2 text-center font-medium" aria-live="polite">
          <span id="paymentStatusSpinner" class="submit-spinner h-10 w-10 rounded-full border-2 border-sage-dark border-t-orange" aria-hidden="true" style="display: none;"></span>
          <p id="paymentStatusText" class="min-h-[1.5em] text-center text-sm font-medium text-red-500"></p>
        </div>
      </div>

      <!-- Step 3: Waiver form -->
      <div id="step3Panel" class="step-panel mt-6 hidden" data-step="3">
        <WaiverForm apiUrl={apiUrl} recaptchaSiteKey={recaptchaSiteKey} context="flow" />
      </div>

      <a id="backToSoccerLink" href="/league/soccer" class="mt-6 inline-block text-sm font-medium text-orange hover:text-orange-light">Back to Soccer league</a>
    </div>
  </main>

  <style>
    .step-dot.bg-orange { background-color: var(--theme-orange, #ea580c); }
    .step-dot.bg-transparent { background-color: transparent; }
    .step-panel.hidden { display: none !important; }
    .submit-spinner {
      border-top-color: var(--theme-orange, #ea580c);
      animation: submit-spin 0.8s linear infinite;
    }
    @keyframes submit-spin {
      to { transform: rotate(360deg); }
    }
  </style>

  <script define:vars={{ apiUrl, eTransferEmail, recaptchaSiteKey }}>
    (function() {
      var currentStep = 1;
      var paymentPrefill = { fullName: '', phone: '', leagueSeason: '', email: '' };
      var step2RecaptchaId = null;

      function generateUuid() {
        return typeof crypto !== 'undefined' && crypto.randomUUID ? crypto.randomUUID() : 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {
          var r = Math.random() * 16 | 0, v = c === 'x' ? r : (r & 0x3 | 0x8);
          return v.toString(16);
        });
      }

      function setStep(step) {
        currentStep = step;
        document.getElementById('step1Panel').classList.toggle('hidden', step !== 1);
        document.getElementById('step2Panel').classList.toggle('hidden', step !== 2);
        document.getElementById('step3Panel').classList.toggle('hidden', step !== 3);

        var dot1 = document.getElementById('stepDot1');
        var dot2 = document.getElementById('stepDot2');
        var dot3 = document.getElementById('stepDot3');
        var label = document.getElementById('stepLabel');
        if (dot1) { dot1.classList.toggle('bg-orange', step === 1); dot1.classList.toggle('bg-transparent', step !== 1); dot1.classList.toggle('border-taupe/50', step !== 1); dot1.setAttribute('aria-current', step === 1 ? 'step' : 'false'); }
        if (dot2) { dot2.classList.toggle('bg-orange', step === 2); dot2.classList.toggle('bg-transparent', step !== 2); dot2.classList.toggle('border-taupe/50', step !== 2); dot2.setAttribute('aria-current', step === 2 ? 'step' : 'false'); }
        if (dot3) { dot3.classList.toggle('bg-orange', step === 3); dot3.classList.toggle('bg-transparent', step !== 3); dot3.classList.toggle('border-taupe/50', step !== 3); dot3.setAttribute('aria-current', step === 3 ? 'step' : 'false'); }
        if (label) label.textContent = step === 1 ? 'Step 1: Registration' : (step === 2 ? 'Step 2: Payment' : 'Step 3: Waiver');

        var backToSoccerLink = document.getElementById('backToSoccerLink');
        if (backToSoccerLink) backToSoccerLink.style.display = step === 2 ? 'none' : '';

        if (step === 2) {
          var nameEl = document.getElementById('paymentName');
          var userEmailEl = document.getElementById('paymentUserEmail');
          var amountEl = document.getElementById('paymentAmount');
          var messageEl = document.getElementById('paymentMessage');
          if (nameEl) nameEl.value = paymentPrefill.fullName || '';
          if (userEmailEl) userEmailEl.value = paymentPrefill.email || '';
          if (messageEl) messageEl.value = 'Registration for ' + (paymentPrefill.fullName || '') + ' - ' + (paymentPrefill.phone || '');
          var amt = 50;
          if (paymentPrefill.leagueSeason && paymentPrefill.leagueSeason.indexOf('Both') !== -1) amt = 100;
          if (amountEl) amountEl.textContent = '$' + amt + '.00';
          initStep2Recaptcha();
          var step2Panel = document.getElementById('step2Panel');
          if (step2Panel) step2Panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
        if (step === 3) {
          var waiverFullNameEl = document.getElementById('waiverFullName');
          var waiverEmailEl = document.getElementById('waiverEmail');
          if (waiverFullNameEl) waiverFullNameEl.value = paymentPrefill.fullName || '';
          if (waiverEmailEl) waiverEmailEl.value = paymentPrefill.email || '';
        }
      }

      function initStep2Recaptcha() {
        var wrap = document.getElementById('step2RecaptchaWrap');
        if (!wrap || !recaptchaSiteKey) return;
        if (wrap.innerHTML.trim()) return;
        if (typeof grecaptcha === 'undefined') return;
        step2RecaptchaId = grecaptcha.render(wrap, { sitekey: recaptchaSiteKey, theme: 'dark' });
      }

      window.__onRegistrationSuccess = function() {
        var form = document.getElementById('registration-form');
        if (form) {
          var fn = form.querySelector('#fullName');
          var ph = form.querySelector('#phone');
          var ls = form.querySelector('#leagueSeason');
          var em = form.querySelector('#email');
          paymentPrefill.fullName = fn ? fn.value.trim() : '';
          paymentPrefill.phone = ph ? ph.value.trim() : '';
          paymentPrefill.leagueSeason = ls ? ls.value : '';
          paymentPrefill.email = em ? em.value.trim() : '';
        }
        setStep(2);
      };

      window.__onWaiverSuccessInFlow = function() {
        paymentPrefill = { fullName: '', phone: '', leagueSeason: '', email: '' };
        window.__registrationFlowId = generateUuid();
        setStep(1);
        location.reload();
      };

      document.addEventListener('DOMContentLoaded', function() {
        window.__registrationFlowId = generateUuid();

        function copyToClipboard(text, btn) {
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(function() {
              if (btn) { var t = btn.textContent; btn.textContent = 'Copied!'; setTimeout(function() { btn.textContent = t; }, 1500); }
            });
          }
        }

        var copyEmailBtn = document.getElementById('copyEmailBtn');
        if (copyEmailBtn) copyEmailBtn.addEventListener('click', function() { copyToClipboard(eTransferEmail, this); });
        var copyNameBtn = document.getElementById('copyNameBtn');
        if (copyNameBtn) copyNameBtn.addEventListener('click', function() { copyToClipboard(document.getElementById('paymentName').value, this); });
        var copyUserEmailBtn = document.getElementById('copyUserEmailBtn');
        if (copyUserEmailBtn) copyUserEmailBtn.addEventListener('click', function() { copyToClipboard(document.getElementById('paymentUserEmail').value, this); });
        var copyMessageBtn = document.getElementById('copyMessageBtn');
        if (copyMessageBtn) copyMessageBtn.addEventListener('click', function() { copyToClipboard(document.getElementById('paymentMessage').value, this); });

        document.getElementById('paymentName').addEventListener('input', function() {
          var msg = document.getElementById('paymentMessage');
          var ph = paymentPrefill.phone || '';
          if (msg) msg.value = 'Registration for ' + this.value + ' - ' + ph;
        });
        document.getElementById('paymentMessage').addEventListener('input', function() {});

        document.getElementById('proceedToWaiverBtn').addEventListener('click', function() {
          var btn = this;
          var statusSpinner = document.getElementById('paymentStatusSpinner');
          var statusText = document.getElementById('paymentStatusText');
          var nameVal = (document.getElementById('paymentName') && document.getElementById('paymentName').value) ? document.getElementById('paymentName').value.trim() : '';
          var emailVal = (document.getElementById('paymentUserEmail') && document.getElementById('paymentUserEmail').value) ? document.getElementById('paymentUserEmail').value.trim() : '';
          if (!nameVal) {
            if (statusSpinner) statusSpinner.style.display = 'none';
            if (statusText) { statusText.textContent = 'Please enter your registration name.'; statusText.classList.add('text-red-500'); }
            return;
          }
          if (!emailVal) {
            if (statusSpinner) statusSpinner.style.display = 'none';
            if (statusText) { statusText.textContent = 'Please enter your email address.'; statusText.classList.add('text-red-500'); }
            return;
          }
          var emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
          if (!emailRegex.test(emailVal)) {
            if (statusSpinner) statusSpinner.style.display = 'none';
            if (statusText) { statusText.textContent = 'Please enter a valid email address.'; statusText.classList.add('text-red-500'); }
            return;
          }
          var token = '';
          if (typeof grecaptcha !== 'undefined' && step2RecaptchaId !== null) token = grecaptcha.getResponse(step2RecaptchaId);
          if (!token) {
            if (statusSpinner) statusSpinner.style.display = 'none';
            if (statusText) statusText.textContent = 'Please complete the verification above.';
            return;
          }
          if (!apiUrl) {
            if (statusSpinner) statusSpinner.style.display = 'none';
            if (statusText) statusText.textContent = 'Form is not configured.';
            return;
          }
          var regId = window.__registrationFlowId;
          if (!regId) {
            if (statusSpinner) statusSpinner.style.display = 'none';
            if (statusText) statusText.textContent = 'Session lost. Please refresh and start again.';
            return;
          }
          var paymentMethodEl = document.querySelector('input[name="paymentMethod"]:checked');
          var paymentMethod = paymentMethodEl ? paymentMethodEl.value : 'etransfer';

          btn.disabled = true;
          if (statusSpinner) statusSpinner.style.display = 'block';
          if (statusText) { statusText.textContent = ''; statusText.classList.remove('text-red-500', 'text-green-600'); }

          fetch(apiUrl, {
            method: 'POST',
            body: JSON.stringify({ action: 'paymentAcknowledged', data: { registrationId: regId, paymentMethod: paymentMethod }, recaptchaToken: token }),
            headers: { 'Content-Type': 'text/plain;charset=utf-8' },
            redirect: 'follow'
          })
            .then(function(res) { return res.json(); })
            .then(function(json) {
              if (statusSpinner) statusSpinner.style.display = 'none';
              if (json.success) {
                if (statusText) { statusText.textContent = ''; statusText.classList.add('text-green-600'); }
                setStep(3);
              } else {
                if (statusText) { statusText.textContent = json.error || 'Something went wrong.'; statusText.classList.add('text-red-500'); }
                btn.disabled = false;
              }
            })
            .catch(function(err) {
              if (statusSpinner) statusSpinner.style.display = 'none';
              if (statusText) { statusText.textContent = err.message || 'Network error. Please try again.'; statusText.classList.add('text-red-500'); }
              btn.disabled = false;
            });
        });

        var mockProceedBtn = document.getElementById('mockProceedToWaiverBtn');
        if (mockProceedBtn) {
          mockProceedBtn.addEventListener('click', function() {
            setStep(3);
          });
        }
      });
    })();
  </script>
  <Footer contactHref="/contact" contactText="Contact" copyrightYear={2026} />
</Layout>
